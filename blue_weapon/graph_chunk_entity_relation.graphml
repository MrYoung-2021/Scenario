  <data key="d3">chunk-5ada7ac41ab629e1f7809edf7d62800b</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778758125</data>
  <data key="d6"></data>
</node>
<node id="Iraq">
  <data key="d0">Iraq</data>
  <data key="d1">location</data>
  <data key="d2">Country south of the Green Line where Iraqi divisions were positioned.&lt;SEP&gt;A foreign nation purchasing the M1A1 Abrams tank variant.&lt;SEP&gt;Iraq is a nation listed as a participant in Foreign Military Sales related to the described weapon systems.</data>
  <data key="d3">chunk-5ada7ac41ab629e1f7809edf7d62800b&lt;SEP&gt;chunk-bd09d5c1d391b2d64517a5d72254efc7&lt;SEP&gt;chunk-f976415bdf294d82666a68528ec01480</data>
