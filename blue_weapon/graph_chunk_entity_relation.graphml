  <data key="d5">1778751498</data>
  <data key="d6"></data>
</node>
<node id="Tactical ISR">
  <data key="d0">Tactical ISR</data>
  <data key="d1">method</data>
  <data key="d2">Tactical ISR provides increased situational awareness and direct communication links between aircrews and commanders.</data>
  <data key="d3">chunk-94b0f13f75f0bd64d503a14651482e66</data>
  <data key="d4">D:\Academic resources\ARN34839-ATP_3-06.1-000-WEB-1.pdf</data>
  <data key="d5">1778751498</data>
  <data key="d6"></data>
