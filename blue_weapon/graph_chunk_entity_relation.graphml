  <data key="d5">1778831589</data>
  <data key="d6"></data>
</node>
<node id="Northern Iraq">
  <data key="d0">Northern Iraq</data>
  <data key="d1">location</data>
  <data key="d2">Region where Task Force Viking carried out operations to disrupt enemy forces.</data>
  <data key="d3">chunk-5ada7ac41ab629e1f7809edf7d62800b</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778758125</data>
  <data key="d6"></data>
</node>
