  <data key="d5">1778747907</data>
  <data key="d6"></data>
</node>
<node id="Stationary Unit">
  <data key="d0">Stationary Unit</data>
  <data key="d1">organization</data>
  <data key="d2">A unit that occupies combat positions and through which another force passes during a passage of lines.</data>
  <data key="d3">chunk-b036aa74f3adbdabd1d826936e991c47</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778747907</data>
  <data key="d6"></data>
</node>
<node id="Passing Force">
  <data key="d0">Passing Force</data>
  <data key="d1">organization</data>
  <data key="d2">A force that moves through another force's combat positions during a passage of lines operation.</data>
  <data key="d3">chunk-b036aa74f3adbdabd1d826936e991c47</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778747907</data>
  <data key="d6"></data>
</node>
<node id="Supplies">
  <data key="d0">Supplies</data>
  <data key="d1">artifact</data>
  <data key="d2">Materials distributed to sustain land forces, which are deconflicted from troop movements by movement control.</data>
  <data key="d3">chunk-b036aa74f3adbdabd1d826936e991c47</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778747907</data>
  <data key="d6"></data>
</node>
<node id="Security Operation">
  <data key="d0">Security Operation</data>
  <data key="d1">event</data>
  <data key="d2">An operation conducted to protect a force, which may necessitate a passage of lines.</data>
  <data key="d3">chunk-b036aa74f3adbdabd1d826936e991c47</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778747907</data>
  <data key="d6"></data>
</node>
<node id="AdministrativeMovement">
  <data key="d0">AdministrativeMovement</data>
  <data key="d3">chunk-03ce33eb77548e57e227d14350711715</data>
  <data key="d2">The echelon logistic staff officer usually supervises administrative movements.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778747977</data>
  <data key="d6"></data>
</node>
<node id="Combat Positions">
  <data key="d0">Combat Positions</data>
  <data key="d3">chunk-b036aa74f3adbdabd1d826936e991c47</data>
  <data key="d2">Passage of lines involves a force moving through another force's combat positions.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
