  <data key="d5">1778747905</data>
  <data key="d6"></data>
</node>
<node id="FM 4-01">
  <data key="d0">FM 4-01</data>
  <data key="d1">content</data>
  <data key="d2">A field manual discussing Army transportation operations and various transportation modes.&lt;SEP&gt;A field manual discussing various transportation modes related to movement.</data>
  <data key="d3">chunk-03ce33eb77548e57e227d14350711715&lt;SEP&gt;chunk-b036aa74f3adbdabd1d826936e991c47</data>
