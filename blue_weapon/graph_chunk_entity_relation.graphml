  <data key="d5">1778751464</data>
  <data key="d6"></data>
</node>
<node id="FAC(A)s">
  <data key="d0">FAC(A)s</data>
  <data key="d1">person</data>
  <data key="d2">FAC(A)s work with aircrews to vary flight paths and use FMV to confirm targets.</data>
  <data key="d3">chunk-da2039fcc410ab417ea95cf892f406c7</data>
  <data key="d4">D:\Academic resources\ARN34839-ATP_3-06.1-000-WEB-1.pdf</data>
  <data key="d5">1778751464</data>
  <data key="d6"></data>
</node>
<node id="Precision-Guided Munitions">
  <data key="d0">Precision-Guided Munitions</data>
  <data key="d1">artifact</data>
  <data key="d2">Precision-Guided Munitions are preferred in urban operations to minimize collateral damage and friendly fire risks.</data>
  <data key="d3">chunk-da2039fcc410ab417ea95cf892f406c7</data>
  <data key="d4">D:\Academic resources\ARN34839-ATP_3-06.1-000-WEB-1.pdf</data>
  <data key="d5">1778751464</data>
