  <data key="d12">1778747348</data>
  <data key="d13"></data>
</edge>
<edge source="Main Battle Area" target="Forward Edge Of The Battle Area">
  <data key="d7">1.0</data>
  <data key="d8">A phase line designating the forward most point of the Main Battle Area indicates the Forward Edge of the Battle Area.</data>
  <data key="d9">boundary,spatial relationship</data>
  <data key="d10">chunk-16fb9a43ba23b08191569577e00618b7</data>
