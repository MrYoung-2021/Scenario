</node>
<node id="Aerial Minefields">
  <data key="d0">Aerial Minefields</data>
  <data key="d1">artifact</data>
  <data key="d2">Minefields that can be deployed by Army aviation units during operations.</data>
  <data key="d3">chunk-b6bf6abab46637a933d4adcc9ec578f4</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
