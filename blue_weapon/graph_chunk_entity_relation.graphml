  <data key="d5">1778747304</data>
  <data key="d6"></data>
</node>
<node id="Armored Units">
  <data key="d0">Armored Units</data>
  <data key="d1">organization</data>
  <data key="d2">Military forces providing firepower and protection, effective in mobile combat in open terrain.</data>
  <data key="d3">chunk-b6bf6abab46637a933d4adcc9ec578f4</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778745998</data>
  <data key="d6"></data>
</node>
<node id="Stryker Units">
  <data key="d0">Stryker Units</data>
  <data key="d1">organization</data>
  <data key="d2">Forces providing firepower and mobility that use terrain to maneuver and employ infantry to close with the enemy.</data>
  <data key="d3">chunk-b6bf6abab46637a933d4adcc9ec578f4</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778745998</data>
  <data key="d6"></data>
</node>
<node id="CBRN Contaminated Environments">
  <data key="d0">CBRN Contaminated Environments</data>
  <data key="d1">location</data>
  <data key="d2">Operational areas with chemical, biological, radiological, or nuclear hazards where certain units can operate.</data>
  <data key="d3">chunk-b6bf6abab46637a933d4adcc9ec578f4</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778745998</data>
  <data key="d6"></data>
</node>
<node id="Dismounted Infantry Forces">
  <data key="d0">Dismounted Infantry Forces</data>
  <data key="d1">organization</data>
  <data key="d2">Forces best suited for offense in complex terrain, capable of securing objectives and conducting air assaults.&lt;SEP&gt;Military units effective in static roles, prepared defenses, and close terrain such as urban or mountainous areas.</data>
  <data key="d3">chunk-b6bf6abab46637a933d4adcc9ec578f4&lt;SEP&gt;chunk-43a1cd0ab6021273635c13e3b7af3476</data>
