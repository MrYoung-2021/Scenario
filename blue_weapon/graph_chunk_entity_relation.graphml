</node>
<node id="Raids">
  <data key="d0">Raids</data>
  <data key="d1">event</data>
  <data key="d2">Audacious, rapidly executed operations by ground maneuver forces within enemy support areas, often relying on aerial resupply.</data>
  <data key="d3">chunk-71131e902d37087dc65113f52eae4eb8</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
