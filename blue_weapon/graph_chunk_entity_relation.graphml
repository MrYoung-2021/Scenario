  <data key="d5">1778747905</data>
  <data key="d6"></data>
</node>
<node id="Reconnaissance">
  <data key="d0">Reconnaissance</data>
  <data key="d1">method</data>
  <data key="d2">A mission conducted by aviation units and unmanned aircraft systems to gather information.&lt;SEP&gt;A mission undertaken to obtain information about enemy activities or area characteristics using visual observation or other detection methods.&lt;SEP&gt;A military operation to obtain information, where zone reconnaissance is a specific, time- and resource-intensive form.</data>
  <data key="d3">chunk-b6bf6abab46637a933d4adcc9ec578f4&lt;SEP&gt;chunk-2a88d8c8678543b9eb4fa95b4ea87591&lt;SEP&gt;chunk-03ce33eb77548e57e227d14350711715</data>
