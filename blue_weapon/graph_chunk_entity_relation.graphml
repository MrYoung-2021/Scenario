  <data key="d0">Surveillance</data>
  <data key="d1">method</data>
  <data key="d2">An operation conducted by unmanned aircraft systems, often in high-risk areas.</data>
  <data key="d3">chunk-b6bf6abab46637a933d4adcc9ec578f4</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778745999</data>
  <data key="d6"></data>
