  <data key="d12">1778747345</data>
  <data key="d13"></data>
</edge>
<edge source="Battle Position" target="Subsequent Position">
  <data key="d7">1.0</data>
  <data key="d8">A subsequent position is a type of battle position a unit expects to move to during battle.</data>
