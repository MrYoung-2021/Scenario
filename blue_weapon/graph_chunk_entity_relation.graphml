  <data key="d12">1778747346</data>
  <data key="d13"></data>
</edge>
<edge source="Battle Position" target="Avenue of Approach">
  <data key="d7">1.0</data>
  <data key="d8">A battle position is oriented on a likely enemy avenue of approach.</data>
