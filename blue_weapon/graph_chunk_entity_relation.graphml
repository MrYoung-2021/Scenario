<graph edgedefault="undirected"><node id="Staffs">
  <data key="d0">Staffs</data>
  <data key="d1">person</data>
  <data key="d2">Military personnel who assist commanders in developing and publishing mission orders and directing tactical actions.&lt;SEP&gt;Staffs assist commanders in translating a unit's mission into specific objectives and disseminate changes in purpose during operations.&lt;SEP&gt;Personnel who use the IPB process and provide information for planning.</data>
  <data key="d3">chunk-4fe75aaa5c3fd7e0ce8f1c7accd42b83&lt;SEP&gt;chunk-279aa3020dae92333d1d26e60241ff57&lt;SEP&gt;chunk-da551c8c73e884b03192b52010d81be5</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778745981</data>
  <data key="d6"></data>
</node>
<node id="Corps">
  <data key="d0">Corps</data>
  <data key="d1">organization</data>
  <data key="d2">Corps are military units that conduct operations in deep areas and are responsible for planning to consolidate gains.&lt;SEP&gt;A command level that uses organic or attached reconnaissance and intelligence elements.&lt;SEP&gt;Corps are military formations whose operational reach is extended by Special Forces units.</data>
  <data key="d3">chunk-4fe75aaa5c3fd7e0ce8f1c7accd42b83&lt;SEP&gt;chunk-2a88d8c8678543b9eb4fa95b4ea87591&lt;SEP&gt;chunk-5bdc5217db0cca10554a11bb5c365968</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf&lt;SEP&gt;D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778758131</data>
  <data key="d6"></data>
</node>
<node id="Divisions">
  <data key="d0">Divisions</data>
  <data key="d1">organization</data>
  <data key="d2">Divisions are military units that conduct operations in deep areas and require planning support for consolidation areas.&lt;SEP&gt;Military formations that normally execute mobile defenses.&lt;SEP&gt;Divisions are military formations whose operational reach is extended by Special Forces units.</data>
  <data key="d3">chunk-4fe75aaa5c3fd7e0ce8f1c7accd42b83&lt;SEP&gt;chunk-ef422907967635431abf4581ffee5bb8&lt;SEP&gt;chunk-5bdc5217db0cca10554a11bb5c365968</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf&lt;SEP&gt;D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778758131</data>
  <data key="d6"></data>
</node>
<node id="BCTs">
  <data key="d0">BCTs</data>
  <data key="d1">organization</data>
  <data key="d2">BCTs (Brigade Combat Teams) are subordinate units that conduct successful combat operations in the close area.&lt;SEP&gt;Brigade Combat Teams that participate in mobile defense as part of a fixing force or a striking force.</data>
  <data key="d3">chunk-4fe75aaa5c3fd7e0ce8f1c7accd42b83&lt;SEP&gt;chunk-ef422907967635431abf4581ffee5bb8</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778747314</data>
  <data key="d6"></data>
</node>
<node id="Deep Areas">
  <data key="d0">Deep Areas</data>
  <data key="d1">location</data>
  <data key="d2">Deep areas are tactical zones where corps and divisions conduct operations to create conditions for subordinates.</data>
  <data key="d3">chunk-4fe75aaa5c3fd7e0ce8f1c7accd42b83</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778745981</data>
  <data key="d6"></data>
</node>
<node id="Close Area">
  <data key="d0">Close Area</data>
  <data key="d1">location</data>
  <data key="d2">An area where Brigade Combat Teams conduct successful combat operations.&lt;SEP&gt;The close area is a tactical zone where BCTs conduct successful combat operations.&lt;SEP&gt;The Close Area is the portion of a commander's area of operations assigned to subordinate maneuver forces where special operations support conventional maneuver.</data>
  <data key="d3">chunk-4fe75aaa5c3fd7e0ce8f1c7accd42b83&lt;SEP&gt;chunk-64c2b09506eccedb4b06b038490a26a5&lt;SEP&gt;chunk-d90513532ac94b30a700a8204e509e17</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf&lt;SEP&gt;D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778758123</data>
  <data key="d6"></data>
</node>
<node id="Consolidation Areas">
  <data key="d0">Consolidation Areas</data>
  <data key="d1">location</data>
  <data key="d2">Consolidation areas are zones where BCTs and divisions require planning support for aspects like civil affairs.</data>
  <data key="d3">chunk-4fe75aaa5c3fd7e0ce8f1c7accd42b83</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778745981</data>
  <data key="d6"></data>
</node>
<node id="Offensive Operations">
  <data key="d0">Offensive Operations</data>
  <data key="d1">method</data>
  <data key="d2">Offensive operations are military actions categorized into movement to contact, attack, exploitation, and pursuit.&lt;SEP&gt;Offensive operations are military activities conducted to defeat enemy forces and exploit advantages.&lt;SEP&gt;Military operations focused on attacking and defeating enemy forces, often involving breaches and crossings.&lt;SEP&gt;Military activities involving the advance of forces, protection considerations, and potential transitions to defensive postures.&lt;SEP&gt;Military operations that may terminate or transition into defensive or stability operations.&lt;SEP&gt;Military operations aimed at attacking the enemy, which commanders transition to as the enemy approaches a culminating point.&lt;SEP&gt;A type of military operation supported by enabling operations, directed by commanders.</data>
  <data key="d3">chunk-4fe75aaa5c3fd7e0ce8f1c7accd42b83&lt;SEP&gt;chunk-4240b292090a3a425c9dae95b6a7c26a&lt;SEP&gt;chunk-c3b45e15d5cccdd3d631ceeba2a6d8d0&lt;SEP&gt;chunk-16d8c89f5caf99f0ea4f94711e809c9b&lt;SEP&gt;chunk-abe3f08fafe8b7389e20d639ffaa8692&lt;SEP&gt;chunk-a418b78a90bc5acb3f47736189745955&lt;SEP&gt;chunk-12d54164de431a3e56787d0f04dea3cf&lt;SEP&gt;chunk-2a88d8c8678543b9eb4fa95b4ea87591</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778747903</data>
  <data key="d6"></data>
</node>
<node id="Stability Operations">
  <data key="d0">Stability Operations</data>
  <data key="d1">concept</data>
  <data key="d2">Stability Operations are a type of military operation directed by commanders and supported by enabling operations. These military activities are focused on establishing security and essential services in post-conflict regions. Primarily, Stability Operations are tasks performed to consolidate gains after large-scale combat, involving civil control and restoration of services. In the context of broader campaigns, these operations may serve as the decisive phase of a major operation, focusing on consolidating gains.

The execution of Stability Operations depends on specific tactical conditions and sequences. They often follow defensive operations, occurring after a force establishes a defense along a limit of advance, and are a type of operation that a unit may transition to following a defense or retrograde operation. Defensive operations develop favorable conditions for Stability Operations alongside offensive operations. Beyond standard combat scenarios, Stability Operations are activities that units may be diverted to conduct if the effects of disaster on dislocated civilians are not minimized.</data>
  <data key="d3">chunk-4fe75aaa5c3fd7e0ce8f1c7accd42b83&lt;SEP&gt;chunk-abe3f08fafe8b7389e20d639ffaa8692&lt;SEP&gt;chunk-a418b78a90bc5acb3f47736189745955&lt;SEP&gt;chunk-2d85f7f19b9f147f37bc741a7c59d700&lt;SEP&gt;chunk-3345760dcbfb2262ee6ddfa43b1677ad&lt;SEP&gt;chunk-2ac9465c9d545f87eb3a80e932a498f3&lt;SEP&gt;chunk-2a88d8c8678543b9eb4fa95b4ea87591&lt;SEP&gt;chunk-7e4dfc214ed288fc6b13f2a08be74357</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf&lt;SEP&gt;D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778758184</data>
  <data key="d6"></data>
</node>
<node id="Degraded Communications Environment">
  <data key="d0">Degraded Communications Environment</data>
  <data key="d1">concept</data>
  <data key="d2">A degraded communications environment is a state arising from environmental circumstances, enemy action, or malfunctions that disrupt communications.</data>
  <data key="d3">chunk-4fe75aaa5c3fd7e0ce8f1c7accd42b83</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778745981</data>
  <data key="d6"></data>
</node>
<node id="Enemies">
  <data key="d0">Enemies</data>
  <data key="d1">organization</data>
  <data key="d2">Enemies are opposing forces that use methods like cyberspace attacks and jamming to deny friendly use of domains.</data>
  <data key="d3">chunk-4fe75aaa5c3fd7e0ce8f1c7accd42b83</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778745981</data>
  <data key="d6"></data>
</node>
<node id="Electromagnetic Spectrum">
  <data key="d0">Electromagnetic Spectrum</data>
  <data key="d1">naturalobject</data>
  <data key="d2">The electromagnetic spectrum is a natural domain targeted by enemy electronic attacks like jamming.&lt;SEP&gt;A domain utilized by friendly forces and denied to enemy commanders through electronic warfare.</data>
  <data key="d3">chunk-4fe75aaa5c3fd7e0ce8f1c7accd42b83&lt;SEP&gt;chunk-ef422907967635431abf4581ffee5bb8</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778747313</data>
  <data key="d6"></data>
</node>
<node id="Cyberspace Domain">
  <data key="d0">Cyberspace Domain</data>
  <data key="d1">location</data>
  <data key="d2">The cyberspace domain is a location targeted by enemy digital attacks against networks.</data>
  <data key="d3">chunk-4fe75aaa5c3fd7e0ce8f1c7accd42b83</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778745981</data>
  <data key="d6"></data>
</node>
<node id="Mission Orders">
  <data key="d0">Mission Orders</data>
  <data key="d1">method</data>
  <data key="d2">Orders that allow subordinates flexibility to maintain a high tempo within their commander's intent.&lt;SEP&gt;Mission orders allow subordinates flexibility to react swiftly to opportunities and threats, facilitating the maintenance of a high tempo.&lt;SEP&gt;Directives developed by commanders and staffs to communicate clear and concise instructions for military operations.&lt;SEP&gt;Mission orders are a critical tool used to remain effective in a degraded communications environment.&lt;SEP&gt;Directives issued by a commander that emphasize the results to be attained rather than the specific methods.&lt;SEP&gt;Directives issued by a commander that emphasize the results to be attained rather than the methods of achievement.</data>
  <data key="d3">chunk-4fe75aaa5c3fd7e0ce8f1c7accd42b83&lt;SEP&gt;chunk-da551c8c73e884b03192b52010d81be5&lt;SEP&gt;chunk-16d8c89f5caf99f0ea4f94711e809c9b&lt;SEP&gt;chunk-1fa0cb96393bbc79e8f283b9593a9806&lt;SEP&gt;chunk-adabd6aa6271efdc850feccf7016cdf0&lt;SEP&gt;chunk-12d54164de431a3e56787d0f04dea3cf</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778747293</data>
  <data key="d6"></data>
</node>
<node id="ADP 5-0">
  <data key="d0">ADP 5-0</data>
  <data key="d1">content</data>
  <data key="d2">ADP 5-0 is a document referenced for the discussion of the military decision-making process.</data>
  <data key="d3">chunk-4fe75aaa5c3fd7e0ce8f1c7accd42b83</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778745981</data>
  <data key="d6"></data>
</node>
<node id="Military Decision-Making Process">
  <data key="d0">Military Decision-Making Process</data>
  <data key="d1">method</data>
  <data key="d2">The military decision-making process is a planning method discussed in ADP 5-0.</data>
  <data key="d3">chunk-4fe75aaa5c3fd7e0ce8f1c7accd42b83</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778745981</data>
  <data key="d6"></data>
</node>
<node id="Reserve Forces">
  <data key="d0">Reserve Forces</data>
  <data key="d1">organization</data>
  <data key="d2">Reserve Forces are military units that are assigned planning priorities rather than specific objectives during mission execution.&lt;SEP&gt;Units held back from the main force, allocated by commanders for counterattacks or identified within enemy formations.</data>
  <data key="d3">chunk-4fe75aaa5c3fd7e0ce8f1c7accd42b83&lt;SEP&gt;chunk-2ac9465c9d545f87eb3a80e932a498f3</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778747313</data>
  <data key="d6"></data>
</node>
<node id="Multinational Forces">
  <data key="d0">Multinational Forces</data>
  <data key="d1">organization</data>
  <data key="d2">Multinational Forces are unified action partners that require simplicity and clarity when organized with Army forces.&lt;SEP&gt;Forces that observe and report civilian, adversary, and enemy activity alongside other units.</data>
  <data key="d3">chunk-4fe75aaa5c3fd7e0ce8f1c7accd42b83&lt;SEP&gt;chunk-2a88d8c8678543b9eb4fa95b4ea87591</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778747904</data>
  <data key="d6"></data>
</node>
<node id="Rules of Engagement">
  <data key="d0">Rules of Engagement</data>
  <data key="d1">concept</data>
  <data key="d2">Rules of Engagement are directives changed by commanders to articulate the transition from combat to stability operations.&lt;SEP&gt;Specific guidelines and laws governing the use of force and operations in different contexts.&lt;SEP&gt;Applicable laws and guidelines that planners and personnel must abide by during the targeting process.</data>
  <data key="d3">chunk-4fe75aaa5c3fd7e0ce8f1c7accd42b83&lt;SEP&gt;chunk-abe3f08fafe8b7389e20d639ffaa8692&lt;SEP&gt;chunk-446c344294ac1157381c690e0f0b5d6c</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf&lt;SEP&gt;D:\Academic resources\ARN34839-ATP_3-06.1-000-WEB-1.pdf</data>
  <data key="d5">1778751497</data>
  <data key="d6"></data>
</node>
<node id="Civil Control">
  <data key="d0">Civil Control</data>
  <data key="d1">concept</data>
  <data key="d2">Civil control is an aspect of minimum-essential stability tasks involving the regulation of population behavior.</data>
  <data key="d3">chunk-4fe75aaa5c3fd7e0ce8f1c7accd42b83</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778745982</data>
  <data key="d6"></data>
</node>
<node id="Civil Security">
  <data key="d0">Civil Security</data>
  <data key="d1">concept</data>
  <data key="d2">Civil security is an aspect of minimum-essential stability tasks focused on protecting the population.</data>
  <data key="d3">chunk-4fe75aaa5c3fd7e0ce8f1c7accd42b83</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778745982</data>
  <data key="d6"></data>
</node>
<node id="Essential Services">
  <data key="d0">Essential Services</data>
  <data key="d1">concept</data>
  <data key="d2">Essential services are critical functions whose restoration is a goal of minimum-essential stability tasks.&lt;SEP&gt;Essential services are part of the critical infrastructure knowledge provided by Army special operations forces.</data>
  <data key="d3">chunk-4fe75aaa5c3fd7e0ce8f1c7accd42b83&lt;SEP&gt;chunk-d3a0c67aeaade5d9ae17a53e58e80e73</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf&lt;SEP&gt;D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778758132</data>
  <data key="d6"></data>
</node>
<node id="Key Terrain">
  <data key="d0">Key Terrain</data>
  <data key="d1">location</data>
  <data key="d2">An identifiable characteristic whose seizure or retention affords a marked advantage to a combatant.&lt;SEP&gt;Key terrain is a geographic feature secured by units to address the final defeat of enemy resistance.&lt;SEP&gt;Crucial geographic features identified by the intelligence process that provide a military advantage.&lt;SEP&gt;Critical terrain features that unit boundaries should not split to maintain operational integrity.&lt;SEP&gt;A geographic area whose control provides a marked advantage to the force possessing it.&lt;SEP&gt;Key Terrain is a strategic location seized and held by assault forces during air assaults.</data>
  <data key="d3">chunk-4fe75aaa5c3fd7e0ce8f1c7accd42b83&lt;SEP&gt;chunk-279aa3020dae92333d1d26e60241ff57&lt;SEP&gt;chunk-b6bf6abab46637a933d4adcc9ec578f4&lt;SEP&gt;chunk-adabd6aa6271efdc850feccf7016cdf0&lt;SEP&gt;chunk-069de81fea4e6c37c85bab0a5a971f89&lt;SEP&gt;chunk-da2039fcc410ab417ea95cf892f406c7</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf&lt;SEP&gt;D:\Academic resources\ARN34839-ATP_3-06.1-000-WEB-1.pdf</data>
  <data key="d5">1778751467</data>
  <data key="d6"></data>
</node>
<node id="Infrastructure">
  <data key="d0">Infrastructure</data>
  <data key="d1">artifact</data>
  <data key="d2">Infrastructure refers to physical structures secured by units following the conclusion of large-scale combat.</data>
  <data key="d3">chunk-4fe75aaa5c3fd7e0ce8f1c7accd42b83</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778745982</data>
  <data key="d6"></data>
</node>
<node id="FM 6-02">
  <data key="d0">FM 6-02</data>
  <data key="d1">content</data>
  <data key="d2">FM 6-02 is a field manual referenced for information on how units receive signal support.</data>
  <data key="d3">chunk-4fe75aaa5c3fd7e0ce8f1c7accd42b83</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778745982</data>
  <data key="d6"></data>
</node>
<node id="Signal Support">
  <data key="d0">Signal Support</data>
  <data key="d1">method</data>
  <data key="d2">Signal support refers to the capabilities and procedures units use to maintain communications, detailed in FM 6-02.</data>
  <data key="d3">chunk-4fe75aaa5c3fd7e0ce8f1c7accd42b83</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778745982</data>
  <data key="d6"></data>
</node>
<node id="Liaison Officers">
  <data key="d0">Liaison Officers</data>
  <data key="d1">person</data>
  <data key="d2">Personnel used to increase coordination and communication between units.&lt;SEP&gt;Liaison Officers are personnel used to increase coordination between units when operating in a degraded communications environment.&lt;SEP&gt;Personnel imbedded with aircrews or C2 elements to enable real-time retasking of assets.&lt;SEP&gt;Officers imbedded with aircrews or C2 elements to enable real-time retasking of assets.</data>
  <data key="d3">chunk-4fe75aaa5c3fd7e0ce8f1c7accd42b83&lt;SEP&gt;chunk-b6bf6abab46637a933d4adcc9ec578f4&lt;SEP&gt;chunk-39bd2e6c05ba9ec2683ab1b01bd4603d&lt;SEP&gt;chunk-63ff2850046e68e7092903c98bb6595e</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf&lt;SEP&gt;D:\Academic resources\ARN34839-ATP_3-06.1-000-WEB-1.pdf</data>
  <data key="d5">1778751482</data>
  <data key="d6"></data>
</node>
<node id="Couriers">
  <data key="d0">Couriers</data>
  <data key="d1">method</data>
  <data key="d2">Individuals who transport orders, reports, and information between headquarters and maneuver units using various media.&lt;SEP&gt;Couriers are a method used to transport orders, reports, and information between headquarters and maneuver units.</data>
  <data key="d3">chunk-4fe75aaa5c3fd7e0ce8f1c7accd42b83&lt;SEP&gt;chunk-b6bf6abab46637a933d4adcc9ec578f4</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778745982</data>
  <data key="d6"></data>
</node>
<node id="Combat Network Radios">
  <data key="d0">Combat Network Radios</data>
  <data key="d1">artifact</data>
  <data key="d2">Equipment used to transmit orders and reports.&lt;SEP&gt;Combat network radios are equipment used to transmit orders and reports when other communications are degraded.</data>
  <data key="d3">chunk-4fe75aaa5c3fd7e0ce8f1c7accd42b83&lt;SEP&gt;chunk-b6bf6abab46637a933d4adcc9ec578f4</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778745982</data>
  <data key="d6"></data>
</node>
<node id="Printed Maps">
  <data key="d0">Printed Maps</data>
  <data key="d1">artifact</data>
  <data key="d2">Printed maps are physical tools used to maintain a common operational picture within a command post during degraded communications.</data>
  <data key="d3">chunk-4fe75aaa5c3fd7e0ce8f1c7accd42b83</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778745982</data>
  <data key="d6"></data>
</node>
<node id="Preparation Fires">
  <data key="d0">Preparation Fires</data>
  <data key="d1">method</data>
  <data key="d2">Preparation fires are high-volume fires delivered over a short period to maximize surprise and shock effects, often including electronic warfare and offensive cyberspace operations.&lt;SEP&gt;Fires used to neutralize, suppress, or destroy enemy positions as a force moves forward.</data>
  <data key="d3">chunk-e273c9c49d54aea292dd6741d10a78d4&lt;SEP&gt;chunk-279aa3020dae92333d1d26e60241ff57</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778745982</data>
  <data key="d6"></data>
</node>
<node id="Precision Munitions">
  <data key="d0">Precision Munitions</data>
  <data key="d1">artifact</data>
  <data key="d2">Precision munitions are weapon systems employed against selected high-payoff targets to negate the requirement for long-duration preparation fires.&lt;SEP&gt;Munitions employed against selected high-payoff targets to negate the requirement for long-duration preparation fires.</data>
  <data key="d3">chunk-e273c9c49d54aea292dd6741d10a78d4&lt;SEP&gt;chunk-279aa3020dae92333d1d26e60241ff57</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778745982</data>
  <data key="d6"></data>
</node>
<node id="Defending Enemy Force">
  <data key="d0">Defending Enemy Force</data>
  <data key="d1">organization</data>
  <data key="d2">A defending enemy force possesses artillery, rocket, cyberspace, and electronic warfare capabilities and seeks to disrupt friendly command, control, and sustainment.</data>
  <data key="d3">chunk-e273c9c49d54aea292dd6741d10a78d4</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778745982</data>
  <data key="d6"></data>
</node>
<node id="Attacking Force">
  <data key="d0">Attacking Force</data>
  <data key="d1">organization</data>
  <data key="d2">An attacking force employs methods such as counter-reconnaissance and military deception to overcome a defending enemy force with superior fire support capabilities.</data>
  <data key="d3">chunk-e273c9c49d54aea292dd6741d10a78d4</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778745982</data>
  <data key="d6"></data>
</node>
<node id="Counter-reconnaissance">
  <data key="d0">Counter-reconnaissance</data>
  <data key="d1">method</data>
  <data key="d2">Counter-reconnaissance is a method used to counter enemy target acquisition efforts alongside security operations and concealment.</data>
  <data key="d3">chunk-e273c9c49d54aea292dd6741d10a78d4</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778745982</data>
  <data key="d6"></data>
</node>
<node id="Military Deception">
  <data key="d0">Military Deception</data>
  <data key="d1">method</data>
  <data key="d2">Military deception is a method used by commanders to prevent an enemy force from determining the location and objective of a friendly decisive operation.&lt;SEP&gt;Activities supported by fires planned by the fire support coordinator to mislead enemy forces.&lt;SEP&gt;A technique used by commanders to mitigate risk and avoid detection of troop concentrations.&lt;SEP&gt;Information-related capabilities synchronized to support the defense.&lt;SEP&gt;Military deception is an activity used to mitigate the risk of air and missile attack and improve survivability.&lt;SEP&gt;A method used by commanders to help conceal logistic operations and reduce detection chances.</data>
  <data key="d3">chunk-e273c9c49d54aea292dd6741d10a78d4&lt;SEP&gt;chunk-279aa3020dae92333d1d26e60241ff57&lt;SEP&gt;chunk-d61f4b5597bdee4add1bccdba2cbd3ff&lt;SEP&gt;chunk-3345760dcbfb2262ee6ddfa43b1677ad&lt;SEP&gt;chunk-f4e12f4d30fc2f3059510d3457b00e7b&lt;SEP&gt;chunk-12d54164de431a3e56787d0f04dea3cf</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778747297</data>
  <data key="d6"></data>
</node>
<node id="Electronic Warfare">
  <data key="d0">Electronic Warfare</data>
  <data key="d1">method</data>
  <data key="d2">Electronic warfare is a capability possessed by enemy forces and included in preparation fires, used to disrupt command and control and neutralize enemy assets.&lt;SEP&gt;Operations that contribute to gaining and maintaining fire superiority alongside indirect fires.&lt;SEP&gt;A capability employed by defending forces to target enemy command and control systems.&lt;SEP&gt;Information-related capabilities synchronized to support the defense.&lt;SEP&gt;A capability against which enemy forces may be vulnerable, as identified by IPB products.</data>
  <data key="d3">chunk-e273c9c49d54aea292dd6741d10a78d4&lt;SEP&gt;chunk-279aa3020dae92333d1d26e60241ff57&lt;SEP&gt;chunk-069de81fea4e6c37c85bab0a5a971f89&lt;SEP&gt;chunk-3345760dcbfb2262ee6ddfa43b1677ad&lt;SEP&gt;chunk-12d54164de431a3e56787d0f04dea3cf</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778747300</data>
  <data key="d6"></data>
</node>
<node id="Offensive Cyberspace Operations">
  <data key="d0">Offensive Cyberspace Operations</data>
  <data key="d1">method</data>
  <data key="d2">Offensive cyberspace operations are included in preparation fires and used to support the offense alongside electronic warfare.</data>
  <data key="d3">chunk-e273c9c49d54aea292dd6741d10a78d4</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778745983</data>
  <data key="d6"></data>
</node>
<node id="Artillery">
  <data key="d0">Artillery</data>
  <data key="d1">artifact</data>
  <data key="d2">Artillery refers to weapon systems that occupy well forward positions within supporting range to provide responsive indirect fires.&lt;SEP&gt;Assets used to emplace obstacles such as scatterable mines during offensive operations.&lt;SEP&gt;Weapon systems capable of providing effective SEAD fires in the urban environment.</data>
  <data key="d3">chunk-e273c9c49d54aea292dd6741d10a78d4&lt;SEP&gt;chunk-4240b292090a3a425c9dae95b6a7c26a&lt;SEP&gt;chunk-a14acea44dac3d3616369b19ec0f2146</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf&lt;SEP&gt;D:\Academic resources\ARN34839-ATP_3-06.1-000-WEB-1.pdf</data>
  <data key="d5">1778751447</data>
  <data key="d6"></data>
</node>
<node id="Mortars">
  <data key="d0">Mortars</data>
  <data key="d1">artifact</data>
  <data key="d2">Mortars are weapon systems that occupy well forward positions to provide responsive indirect fires in support of maneuver forces.&lt;SEP&gt;Weapon systems categorized under indirect fires for urban operations.</data>
  <data key="d3">chunk-e273c9c49d54aea292dd6741d10a78d4&lt;SEP&gt;chunk-a14acea44dac3d3616369b19ec0f2146</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf&lt;SEP&gt;D:\Academic resources\ARN34839-ATP_3-06.1-000-WEB-1.pdf</data>
  <data key="d5">1778751447</data>
  <data key="d6"></data>
</node>
<node id="Army Forward Observers">
  <data key="d0">Army Forward Observers</data>
  <data key="d1">person</data>
  <data key="d2">Army forward observers are personnel assigned to quick fire networks to facilitate responsive fires.</data>
  <data key="d3">chunk-e273c9c49d54aea292dd6741d10a78d4</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778745983</data>
  <data key="d6"></data>
</node>
<node id="Joint Fires Observers">
  <data key="d0">Joint Fires Observers</data>
  <data key="d1">person</data>
  <data key="d2">Joint fires observers are personnel assigned to quick fire networks to facilitate responsive fires.</data>
  <data key="d3">chunk-e273c9c49d54aea292dd6741d10a78d4</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778745983</data>
  <data key="d6"></data>
</node>
<node id="Quick Fire Networks">
  <data key="d0">Quick Fire Networks</data>
  <data key="d1">method</data>
  <data key="d2">Quick fire networks are communication arrangements that allow observers to communicate directly with firing units to enhance responsiveness.</data>
  <data key="d3">chunk-e273c9c49d54aea292dd6741d10a78d4</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778745983</data>
  <data key="d6"></data>
</node>
<node id="Information Operations">
  <data key="d0">Information Operations</data>
  <data key="d1">method</data>
  <data key="d2">Information operations are conducted by commanders to support the offense with lethal and nonlethal effects, synchronizing information-related capabilities.&lt;SEP&gt;Operations used to influence adversary information and contribute to fire superiority.&lt;SEP&gt;Operations conducted to synchronize information-related capabilities and achieve objectives in the information environment.&lt;SEP&gt;An enabling operation discussed in FM 3-13.</data>
  <data key="d3">chunk-e273c9c49d54aea292dd6741d10a78d4&lt;SEP&gt;chunk-279aa3020dae92333d1d26e60241ff57&lt;SEP&gt;chunk-12d54164de431a3e56787d0f04dea3cf&lt;SEP&gt;chunk-2a88d8c8678543b9eb4fa95b4ea87591</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778747902</data>
  <data key="d6"></data>
</node>
<node id="Joint Force Air Component Commander">
  <data key="d0">Joint Force Air Component Commander</data>
  <data key="d1">person</data>
  <data key="d2">The joint force air component commander operates primary air defense systems such as joint fighter aircraft.</data>
  <data key="d3">chunk-e273c9c49d54aea292dd6741d10a78d4</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778745983</data>
  <data key="d6"></data>
</node>
<node id="Joint Fighter Aircraft">
  <data key="d0">Joint Fighter Aircraft</data>
  <data key="d1">artifact</data>
  <data key="d2">Joint fighter aircraft are systems conducting offensive counterair operations and serve as a primary air defense system.</data>
  <data key="d3">chunk-e273c9c49d54aea292dd6741d10a78d4</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778745983</data>
  <data key="d6"></data>
</node>
<node id="Air Defense Coordinator">
  <data key="d0">Air Defense Coordinator</data>
  <data key="d1">person</data>
  <data key="d2">The air defense coordinator informs commanders regarding the air threat and its effect on the operation during mission analysis.</data>
  <data key="d3">chunk-e273c9c49d54aea292dd6741d10a78d4</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778745983</data>
  <data key="d6"></data>
</node>
<node id="Passive Air Defense Measures">
  <data key="d0">Passive Air Defense Measures</data>
  <data key="d1">method</data>
  <data key="d2">Passive air defense measures are essential planning activities used to reduce the effectiveness of enemy air threats during offensive operations.&lt;SEP&gt;Essential measures part of air and missile defense planning intended to reduce the effectiveness of the enemy air threat.</data>
  <data key="d3">chunk-e273c9c49d54aea292dd6741d10a78d4&lt;SEP&gt;chunk-71131e902d37087dc65113f52eae4eb8</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778745983</data>
  <data key="d6"></data>
</node>
<node id="Rocket">
  <data key="d0">Rocket</data>
  <data key="d1">artifact</data>
  <data key="d2">Rocket capabilities are possessed by a defending enemy force alongside artillery, cyberspace, and electronic warfare capabilities.</data>
  <data key="d3">chunk-e273c9c49d54aea292dd6741d10a78d4</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778745983</data>
  <data key="d6"></data>
</node>
<node id="Fire Support">
  <data key="d0">Fire Support</data>
  <data key="d1">method</data>
  <data key="d2">Fire support is a function and activity that a defending enemy force seeks to disrupt, and its availability is affected by movement.</data>
  <data key="d3">chunk-e273c9c49d54aea292dd6741d10a78d4</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778745983</data>
  <data key="d6"></data>
</node>
<node id="Target Acquisition">
  <data key="d0">Target Acquisition</data>
  <data key="d1">method</data>
  <data key="d2">Target acquisition is the process of identifying targets, which is countered by reconnaissance and neutralized by electronic warfare resources.&lt;SEP&gt;Process including visual and sensor-aided acquisition of targets in urban environments.</data>
  <data key="d3">chunk-e273c9c49d54aea292dd6741d10a78d4&lt;SEP&gt;chunk-39bd2e6c05ba9ec2683ab1b01bd4603d</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf&lt;SEP&gt;D:\Academic resources\ARN34839-ATP_3-06.1-000-WEB-1.pdf</data>
  <data key="d5">1778751479</data>
  <data key="d6"></data>
</node>
<node id="Command and Control Nodes">
  <data key="d0">Command and Control Nodes</data>
  <data key="d1">artifact</data>
  <data key="d2">Command and control nodes are critical points targeted by attacking units to disrupt enemy operations and degrade combat power.</data>
  <data key="d3">chunk-e273c9c49d54aea292dd6741d10a78d4</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778745983</data>
  <data key="d6"></data>
</node>
<node id="Air and Missile Defense">
  <data key="d0">Air and Missile Defense</data>
  <data key="d1">concept</data>
  <data key="d2">Air and Missile Defense encompasses the comprehensive suite of systems and operations utilized to safeguard friendly forces from potential air threats. This domain relies on the integration of both passive and active measures to effectively neutralize dangers posed by aerial adversaries. Beyond its operational function, the field serves as a critical focal point for long-term military development and resource allocation.

Within the specific context of the United States Army, Air and Missile Defense is established as a designated modernization priority. This status is reflected consistently across various strategic documents, where it is recognized as a TACA Modernization Priority and embedded within the overarching United States Army acquisition strategy. These designations highlight a committed focus on advancing defensive systems capable of countering evolving aerial and missile threats, ensuring the force remains protected against future risks associated with air-based attacks.</data>
  <data key="d3">chunk-e273c9c49d54aea292dd6741d10a78d4&lt;SEP&gt;chunk-acade8ec9a9d5344060a4314cfa18a5b&lt;SEP&gt;chunk-3c4507fc3a4f571c8dfbaa23d9a738cc&lt;SEP&gt;chunk-0e07adaae816a485b8bdcdde27baecf8&lt;SEP&gt;chunk-e04593a83987ff6eb98f28906bbd37f6&lt;SEP&gt;chunk-d4a15c71581af907f47533c1630b8096&lt;SEP&gt;chunk-8dcb0d8a5efb5ce308ca2c93988c72be&lt;SEP&gt;chunk-c6faa94aab2e13591315f79ebbd49ab0</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf&lt;SEP&gt;D:\Academic resources\WEAPON_SYSTEMS_HANDBOOK.pdf</data>
  <data key="d5">1778831644</data>
  <data key="d6"></data>
</node>
<node id="Short-Range Air Defense Systems">
  <data key="d0">Short-Range Air Defense Systems</data>
  <data key="d1">artifact</data>
  <data key="d2">Short-range air defense systems are organic or attached assets used to protect maneuver forces during offensive operations.</data>
  <data key="d3">chunk-e273c9c49d54aea292dd6741d10a78d4</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778745984</data>
  <data key="d6"></data>
</node>
<node id="Intelligence Sensors">
  <data key="d0">Intelligence Sensors</data>
  <data key="d1">artifact</data>
  <data key="d2">Intelligence sensors are assets that provide guidance to friendly jammers and lethal indirect fire weapon systems to destroy enemy targets.</data>
  <data key="d3">chunk-e273c9c49d54aea292dd6741d10a78d4</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778745984</data>
  <data key="d6"></data>
</node>
<node id="Friendly Jammers">
  <data key="d0">Friendly Jammers</data>
  <data key="d1">artifact</data>
  <data key="d2">Friendly jammers are electronic warfare resources that receive guidance from intelligence sensors to neutralize enemy assets.</data>
  <data key="d3">chunk-e273c9c49d54aea292dd6741d10a78d4</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778745984</data>
  <data key="d6"></data>
</node>
<node id="Coordinated Fire Lines">
  <data key="d0">Coordinated Fire Lines</data>
  <data key="d1">method</data>
  <data key="d2">Coordinated fire lines are control measures established by commanders to facilitate the rapid engagement of targets beyond the lines.</data>
  <data key="d3">chunk-e273c9c49d54aea292dd6741d10a78d4</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778745984</data>
  <data key="d6"></data>
</node>
<node id="Priority of Fires">
  <data key="d0">Priority of Fires</data>
  <data key="d1">method</data>
  <data key="d2">Priority of fires is a designation used by commanders to support decisive operations and main efforts.</data>
  <data key="d3">chunk-e273c9c49d54aea292dd6741d10a78d4</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778745984</data>
  <data key="d6"></data>
</node>
<node id="Decisive Operations">
  <data key="d0">Decisive Operations</data>
  <data key="d1">event</data>
  <data key="d2">Decisive operations are the primary missions supported by commanders through the designation of priority of fires.</data>
  <data key="d3">chunk-e273c9c49d54aea292dd6741d10a78d4</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778745984</data>
  <data key="d6"></data>
</node>
<node id="Limited-Visibility Conditions">
  <data key="d0">Limited-Visibility Conditions</data>
  <data key="d1">concept</data>
  <data key="d2">Conditions requiring additional planning, preparation, and control measures for tasks typically performed during daylight.</data>
  <data key="d3">chunk-279aa3020dae92333d1d26e60241ff57</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778745984</data>
  <data key="d6"></data>
</node>
<node id="Leaders">
  <data key="d0">Leaders</data>
  <data key="d1">person</data>
  <data key="d2">Individuals responsible for ensuring night-vision and navigation systems are available and functional, and for rehearsing operations.&lt;SEP&gt;Individuals responsible for ensuring night-vision and navigation systems are available and functional.&lt;SEP&gt;Personnel who are more likely to be rested and capable if part of forces not previously committed to defense.&lt;SEP&gt;Leaders determine broad conditions for transition at the outset of operations.</data>
  <data key="d3">chunk-279aa3020dae92333d1d26e60241ff57&lt;SEP&gt;chunk-4240b292090a3a425c9dae95b6a7c26a&lt;SEP&gt;chunk-a418b78a90bc5acb3f47736189745955&lt;SEP&gt;chunk-d3a0c67aeaade5d9ae17a53e58e80e73</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf&lt;SEP&gt;D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778758131</data>
  <data key="d6"></data>
</node>
<node id="Night-Vision">
  <data key="d0">Night-Vision</data>
  <data key="d1">artifact</data>
  <data key="d2">Systems required to maneuver under limited-visibility conditions.</data>
  <data key="d3">chunk-279aa3020dae92333d1d26e60241ff57</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778745984</data>
  <data key="d6"></data>
</node>
<node id="Navigation Systems">
  <data key="d0">Navigation Systems</data>
  <data key="d1">artifact</data>
  <data key="d2">Systems required to maneuver under limited-visibility conditions.&lt;SEP&gt;Equipment required to maneuver under limited visibility conditions.</data>
  <data key="d3">chunk-279aa3020dae92333d1d26e60241ff57&lt;SEP&gt;chunk-4240b292090a3a425c9dae95b6a7c26a</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778745984</data>
  <data key="d6"></data>
</node>
<node id="Obscurant">
  <data key="d0">Obscurant</data>
  <data key="d1">artifact</data>
  <data key="d2">Material used to create obscuration and reduce visual target acquisition.&lt;SEP&gt;Material that decreases the level of energy available for the functions of seekers, trackers, and vision enhancement devices.&lt;SEP&gt;Materials used to disrupt enemy formations, deny the use of optics, and conceal movements.</data>
  <data key="d3">chunk-279aa3020dae92333d1d26e60241ff57&lt;SEP&gt;chunk-4240b292090a3a425c9dae95b6a7c26a&lt;SEP&gt;chunk-069de81fea4e6c37c85bab0a5a971f89</data>
