  <data key="d0">JP 3-07.3</data>
  <data key="d1">content</data>
  <data key="d2">A joint publication referenced for the definition of relief in place.</data>
  <data key="d3">chunk-b036aa74f3adbdabd1d826936e991c47</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778747906</data>
  <data key="d6"></data>
</node>
<node id="Sequential Relief in Place">
  <data key="d0">Sequential Relief in Place</data>
  <data key="d1">method</data>
  <data key="d2">A type of relief in place where elements are relieved in succession based on deployment.</data>
  <data key="d3">chunk-b036aa74f3adbdabd1d826936e991c47</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778747906</data>
  <data key="d6"></data>
</node>
<node id="Simultaneous Relief in Place">
  <data key="d0">Simultaneous Relief in Place</data>
  <data key="d1">method</data>
  <data key="d2">A type of relief in place where all elements are relieved at the same time, taking the least time to execute.</data>
  <data key="d3">chunk-b036aa74f3adbdabd1d826936e991c47</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778747906</data>
  <data key="d6"></data>
</node>
<node id="Staggered Relief in Place">
  <data key="d0">Staggered Relief in Place</data>
  <data key="d1">method</data>
  <data key="d2">A type of relief in place where elements are relieved in a sequence determined by the tactical situation.</data>
  <data key="d3">chunk-b036aa74f3adbdabd1d826936e991c47</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778747906</data>
  <data key="d6"></data>
</node>
<node id="Deliberate Relief in Place">
  <data key="d0">Deliberate Relief in Place</data>
  <data key="d1">method</data>
  <data key="d2">A relief in place characterized by in-depth planning and preparation.</data>
  <data key="d3">chunk-b036aa74f3adbdabd1d826936e991c47</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778747906</data>
  <data key="d6"></data>
</node>
<node id="Hasty Relief in Place">
  <data key="d0">Hasty Relief in Place</data>
  <data key="d1">method</data>
  <data key="d2">A relief in place conducted with limited planning and preparation time.</data>
  <data key="d3">chunk-b036aa74f3adbdabd1d826936e991c47</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778747906</data>
  <data key="d6"></data>
</node>
<node id="Forward Passage of Lines">
  <data key="d0">Forward Passage of Lines</data>
  <data key="d1">method</data>
  <data key="d2">A passage of lines occurring when a unit passes through another unit's positions while moving toward the enemy.</data>
  <data key="d3">chunk-b036aa74f3adbdabd1d826936e991c47</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778747906</data>
  <data key="d6"></data>
</node>
<node id="Rearward Passage of Lines">
  <data key="d0">Rearward Passage of Lines</data>
  <data key="d1">method</data>
  <data key="d2">A passage of lines occurring when a unit passes through another unit's positions while moving away from the enemy.</data>
  <data key="d3">chunk-b036aa74f3adbdabd1d826936e991c47</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778747907</data>
  <data key="d6"></data>
</node>
<node id="Passage Point">
  <data key="d0">Passage Point</data>
  <data key="d1">location</data>
  <data key="d2">The specific point through which a passing force moves, where the transfer of authority usually occurs.</data>
  <data key="d3">chunk-b036aa74f3adbdabd1d826936e991c47</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778747907</data>
  <data key="d6"></data>
</node>
<node id="The Army">
  <data key="d0">The Army</data>
  <data key="d1">organization</data>
  <data key="d2">The military service that utilizes the term Area of Operations (AO) instead of a zone of operations.</data>
  <data key="d3">chunk-b036aa74f3adbdabd1d826936e991c47</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778747907</data>
  <data key="d6"></data>
</node>
<node id="JP 3-18">
  <data key="d0">JP 3-18</data>
  <data key="d1">content</data>
  <data key="d2">A joint publication referenced as the source for the definition of passage of lines.</data>
