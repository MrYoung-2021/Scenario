  <data key="d5">1778831592</data>
  <data key="d6"></data>
</node>
<node id="Iraqi Divisions">
  <data key="d0">Iraqi Divisions</data>
  <data key="d1">organization</data>
  <data key="d2">Thirteen enemy divisions targeted by Task Force Viking to prevent maneuvering against coalition efforts.</data>
  <data key="d3">chunk-5ada7ac41ab629e1f7809edf7d62800b</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778758125</data>
  <data key="d6"></data>
</node>
<node id="Peshmerga">
  <data key="d0">Peshmerga</data>
  <data key="d1">organization</data>
  <data key="d2">A 70,000-man fighting force of Kurds that served as the backbone of Task Force Viking's assaults.</data>
  <data key="d3">chunk-5ada7ac41ab629e1f7809edf7d62800b</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778758125</data>
  <data key="d6"></data>
</node>
