</node>
<node id="Enemy Air Operations">
  <data key="d0">Enemy Air Operations</data>
  <data key="d1">event</data>
  <data key="d2">Enemy air operations are activities supported by enemy facilities such as airfields and launch sites.</data>
  <data key="d3">chunk-71131e902d37087dc65113f52eae4eb8</data>
