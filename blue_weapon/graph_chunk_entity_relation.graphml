  <data key="d5">1778758137</data>
  <data key="d6"></data>
</node>
<node id="Special Operations Forces">
  <data key="d0">Special Operations Forces</data>
  <data key="d1">organization</data>
  <data key="d2">Special operations forces are military units that conduct attacks, often combined with fires, to create disruptive cognitive effects on the enemy.</data>
  <data key="d3">chunk-1fa0cb96393bbc79e8f283b9593a9806</data>
