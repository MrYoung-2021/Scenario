<node id="Aeromedical Evacuation">
  <data key="d0">Aeromedical Evacuation</data>
  <data key="d1">method</data>
  <data key="d2">Aeromedical evacuation is a feasible emergency support option for raiding forces when ground lines of communication are absent.</data>
  <data key="d3">chunk-71131e902d37087dc65113f52eae4eb8</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
