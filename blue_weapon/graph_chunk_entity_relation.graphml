  <data key="d13"></data>
</edge>
<edge source="Enemy Force" target="Disengagement Line">
  <data key="d7">1.0</data>
  <data key="d8">Crossing the disengagement line by an enemy force signals defending elements to displace.</data>
  <data key="d9">movement,signal</data>
