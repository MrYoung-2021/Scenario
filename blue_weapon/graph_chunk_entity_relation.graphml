  <data key="d0">Enemy Air Threat</data>
  <data key="d1">concept</data>
  <data key="d2">The potential danger posed by threat air systems which passive defense measures aim to mitigate.</data>
  <data key="d3">chunk-71131e902d37087dc65113f52eae4eb8</data>
