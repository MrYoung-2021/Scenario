  <data key="d2">Legacy Russian-influenced Ukrainian units transformed into modernized forces.</data>
  <data key="d3">chunk-ef6e82af28ec6fa5c74054f474ea4690</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778758121</data>
  <data key="d6"></data>
</node>
<node id="Ukrainian Territorial Defense Forces">
  <data key="d0">Ukrainian Territorial Defense Forces</data>
  <data key="d1">organization</data>
  <data key="d2">Force established following the passage of National Resistance Laws.</data>
  <data key="d3">chunk-ef6e82af28ec6fa5c74054f474ea4690</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778758121</data>
  <data key="d6"></data>
</node>
<node id="National Resistance Laws">
  <data key="d0">National Resistance Laws</data>
  <data key="d1">content</data>
  <data key="d2">Legislation passed in 2021 that formalized resistance strategy.</data>
  <data key="d3">chunk-ef6e82af28ec6fa5c74054f474ea4690</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778758121</data>
  <data key="d6"></data>
</node>
<node id="Security Force Assistance">
  <data key="d0">Security Force Assistance</data>
  <data key="d1">concept</data>
  <data key="d2">Primary line of effort to increase security force capability and capacity.</data>
  <data key="d3">chunk-ef6e82af28ec6fa5c74054f474ea4690</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778758121</data>
  <data key="d6"></data>
</node>
<node id="Chapter 2">
  <data key="d0">Chapter 2</data>
  <data key="d1">content</data>
  <data key="d2">Chapter 2 of the manual contains discussion on command and control and task organization.</data>
  <data key="d3">chunk-ef6e82af28ec6fa5c74054f474ea4690</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778758121</data>
  <data key="d6"></data>
</node>
<node id="Special Operations">
  <data key="d0">Special Operations</data>
  <data key="d1">concept</data>
  <data key="d2">Special operations are activities discussed in the manual to maintain stability and deter conflict.&lt;SEP&gt;Special Operations are activities conducted to advance joint force fires and maneuver in the extended deep area.</data>
  <data key="d3">chunk-ef6e82af28ec6fa5c74054f474ea4690&lt;SEP&gt;chunk-c69d05b2f34d86a1867e7e7939634802</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778758122</data>
  <data key="d6"></data>
</node>
<node id="Command and Control">
  <data key="d0">Command and Control</data>
  <data key="d1">concept</data>
  <data key="d2">Command and control is a topic discussed in Chapter 2 of the manual.&lt;SEP&gt;Command and Control is a vital capability in rear areas that enemy forces threaten and special operations forces disrupt.</data>
  <data key="d3">chunk-ef6e82af28ec6fa5c74054f474ea4690&lt;SEP&gt;chunk-d90513532ac94b30a700a8204e509e17</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778758122</data>
  <data key="d6"></data>
</node>
<node id="Military Information Support Operations">
  <data key="d0">Military Information Support Operations</data>
  <data key="d1">method</data>
  <data key="d2">Program that may support security force assistance activities.&lt;SEP&gt;Operations conducted to influence enemies and inform behavior favorable towards friendly security forces.</data>
  <data key="d3">chunk-ef6e82af28ec6fa5c74054f474ea4690&lt;SEP&gt;chunk-7e4dfc214ed288fc6b13f2a08be74357</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778758122</data>
  <data key="d6"></data>
</node>
<node id="Civil Affairs Operations">
  <data key="d0">Civil Affairs Operations</data>
  <data key="d1">method</data>
  <data key="d2">Operations that may support security force assistance activities.</data>
  <data key="d3">chunk-ef6e82af28ec6fa5c74054f474ea4690</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778758122</data>
  <data key="d6"></data>
</node>
<node id="Counter Threat Finance">
  <data key="d0">Counter Threat Finance</data>
  <data key="d1">method</data>
  <data key="d2">Activity that may support security force assistance activities.</data>
  <data key="d3">chunk-ef6e82af28ec6fa5c74054f474ea4690</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778758122</data>
  <data key="d6"></data>
</node>
<node id="Sensitive Site Exploitation">
  <data key="d0">Sensitive Site Exploitation</data>
  <data key="d1">method</data>
  <data key="d2">Activity that may support security force assistance activities.</data>
  <data key="d3">chunk-ef6e82af28ec6fa5c74054f474ea4690</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778758122</data>
  <data key="d6"></data>
</node>
<node id="Sniper Techniques">
  <data key="d0">Sniper Techniques</data>
  <data key="d1">method</data>
  <data key="d2">Instruction provided by Special Forces to Ukrainian special operations forces.</data>
  <data key="d3">chunk-ef6e82af28ec6fa5c74054f474ea4690</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778758122</data>
  <data key="d6"></data>
</node>
<node id="Battlefield Medicine">
  <data key="d0">Battlefield Medicine</data>
  <data key="d1">method</data>
  <data key="d2">Instruction provided by Special Forces to Ukrainian special operations forces.</data>
  <data key="d3">chunk-ef6e82af28ec6fa5c74054f474ea4690</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778758122</data>
  <data key="d6"></data>
</node>
<node id="Local Civilian Networks">
  <data key="d0">Local Civilian Networks</data>
  <data key="d1">organization</data>
  <data key="d2">Networks with which Ukrainian special operations forces established relationships.</data>
  <data key="d3">chunk-ef6e82af28ec6fa5c74054f474ea4690</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778758122</data>
  <data key="d6"></data>
</node>
<node id="Conventional Partners">
  <data key="d0">Conventional Partners</data>
  <data key="d1">organization</data>
  <data key="d2">Partners alongside whom Army special operations forces provided training and assistance.</data>
  <data key="d3">chunk-ef6e82af28ec6fa5c74054f474ea4690</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778758122</data>
  <data key="d6"></data>
</node>
<node id="U.S. Personnel">
  <data key="d0">U.S. Personnel</data>
  <data key="d1">person</data>
  <data key="d2">Individuals who provided remote advisory support to Ukraine after the invasion.</data>
  <data key="d3">chunk-ef6e82af28ec6fa5c74054f474ea4690</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778758122</data>
  <data key="d6"></data>
</node>
<node id="Psychological Operations Units">
  <data key="d0">Psychological Operations Units</data>
  <data key="d1">organization</data>
  <data key="d2">Psychological Operations Units conduct military information support operations to reinforce civilian preparedness.&lt;SEP&gt;Provide options to influence threat leaders, populations, and their will to persist in hostile actions.&lt;SEP&gt;Psychological Operations Units message rear area populations to communicate control measures, maintain morale, and support partner legitimacy.</data>
  <data key="d3">chunk-d90513532ac94b30a700a8204e509e17&lt;SEP&gt;chunk-fa8d93750f6d13a9825215c8b00f7149&lt;SEP&gt;chunk-660d19754e7a8b4d28766ae683085446</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778758122</data>
  <data key="d6"></data>
</node>
<node id="Special Forces Units">
  <data key="d0">Special Forces Units</data>
  <data key="d1">organization</data>
  <data key="d2">Special Forces Units conduct operations in the deep area to disrupt the enemy, gather intelligence, and support conventional forces.&lt;SEP&gt;Sub-component of Army Special Operations Forces using advanced infiltration techniques and leveraging partners to gain access.&lt;SEP&gt;Conduct strikes, sabotage, surveillance, and reconnaissance to extend operational reach of corps and divisions.</data>
  <data key="d3">chunk-d90513532ac94b30a700a8204e509e17&lt;SEP&gt;chunk-5bdc5217db0cca10554a11bb5c365968&lt;SEP&gt;chunk-a75fd9bf2d8ffd7deb7994794314ba94</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778758122</data>
  <data key="d6"></data>
</node>
<node id="U.S. Forces">
  <data key="d0">U.S. Forces</data>
  <data key="d1">organization</data>
  <data key="d2">U.S. Forces are supported by Army special operations forces during tactical and operational maneuver.</data>
  <data key="d3">chunk-d90513532ac94b30a700a8204e509e17</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778758123</data>
  <data key="d6"></data>
</node>
<node id="Partner Forces">
  <data key="d0">Partner Forces</data>
  <data key="d1">organization</data>
  <data key="d2">Partner Forces collaborate with Army Special Operations Forces to develop capability, capacity, and resilience.&lt;SEP&gt;Partner Forces operate alongside U.S. forces and are supported by Army special operations activities and psychological operations.&lt;SEP&gt;Partner forces can work with SOF to attack vulnerable targets and influence populations.</data>
  <data key="d3">chunk-d90513532ac94b30a700a8204e509e17&lt;SEP&gt;chunk-c69d05b2f34d86a1867e7e7939634802&lt;SEP&gt;chunk-660d19754e7a8b4d28766ae683085446</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778758123</data>
  <data key="d6"></data>
</node>
<node id="Joint Task Force">
  <data key="d0">Joint Task Force</data>
  <data key="d1">organization</data>
  <data key="d2">The Joint Task Force represents the main effort that Army special operations forces support through special operations activities.</data>
  <data key="d3">chunk-d90513532ac94b30a700a8204e509e17</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778758123</data>
  <data key="d6"></data>
</node>
<node id="Joint Special Operations Task Force">
  <data key="d0">Joint Special Operations Task Force</data>
  <data key="d1">organization</data>
  <data key="d2">A Joint Special Operations Task Force, up to an O-6 level, may be attached to or employed in a supported-supporting relationship with the land component commander.</data>
  <data key="d3">chunk-d90513532ac94b30a700a8204e509e17</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778758123</data>
  <data key="d6"></data>
</node>
<node id="Land Component Commander">
  <data key="d0">Land Component Commander</data>
  <data key="d1">person</data>
  <data key="d2">The Land Component Commander is responsible for area security and control including rear area protection.&lt;SEP&gt;The Land Component Commander receives support from Army special operations forces and may have task forces directly attached.&lt;SEP&gt;Commander whose area of responsibility typically excludes the operational deep area.&lt;SEP&gt;The Land Component Commander is supported by Civil Affairs units in reconstituting partner governance capacity.</data>
  <data key="d3">chunk-d90513532ac94b30a700a8204e509e17&lt;SEP&gt;chunk-c69d05b2f34d86a1867e7e7939634802&lt;SEP&gt;chunk-5bdc5217db0cca10554a11bb5c365968&lt;SEP&gt;chunk-a75fd9bf2d8ffd7deb7994794314ba94</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778758123</data>
  <data key="d6"></data>
</node>
<node id="Rear Area">
  <data key="d0">Rear Area</data>
  <data key="d1">location</data>
  <data key="d2">The Rear Area requires protection and security control by the land component commander.&lt;SEP&gt;The Rear Area poses unique security challenges due to increased range of enemy fires and is where Civil Affairs and protection units operate.</data>
  <data key="d3">chunk-d90513532ac94b30a700a8204e509e17&lt;SEP&gt;chunk-c69d05b2f34d86a1867e7e7939634802</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778758123</data>
  <data key="d6"></data>
</node>
<node id="Extended Deep Area">
  <data key="d0">Extended Deep Area</data>
  <data key="d1">concept</data>
  <data key="d2">The Extended Deep Area comprises operational and strategic deep areas, including regions beyond the reach of conventional ground forces.&lt;SEP&gt;The extended deep area is where Army special operations forces may conduct operations to advance joint force fires and maneuver.&lt;SEP&gt;Operational region beyond the reach of conventional ground forces where special operations are conducted and policy may prohibit operations.</data>
  <data key="d3">chunk-d90513532ac94b30a700a8204e509e17&lt;SEP&gt;chunk-c69d05b2f34d86a1867e7e7939634802&lt;SEP&gt;chunk-a75fd9bf2d8ffd7deb7994794314ba94</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778758123</data>
  <data key="d6"></data>
</node>
<node id="Populace and Resources Control">
  <data key="d0">Populace and Resources Control</data>
  <data key="d1">method</data>
  <data key="d2">Populace and Resources Control includes measures like curfews, travel permits, licensing, and checkpoints to deny opportunities to the enemy.</data>
  <data key="d3">chunk-d90513532ac94b30a700a8204e509e17</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778758123</data>
  <data key="d6"></data>
</node>
<node id="Large-Scale Combat Operations">
  <data key="d0">Large-Scale Combat Operations</data>
  <data key="d1">event</data>
  <data key="d2">Large-Scale Combat Operations involve Rangers working with conventional infantry for successful seizure of objectives.&lt;SEP&gt;Large-Scale Combat Operations involve the advancement of maneuver forces and the employment of Army special operations forces in support of land component commanders.</data>
  <data key="d3">chunk-d90513532ac94b30a700a8204e509e17&lt;SEP&gt;chunk-c69d05b2f34d86a1867e7e7939634802</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778758123</data>
  <data key="d6"></data>
</node>
<node id="FM 1-02.1">
  <data key="d0">FM 1-02.1</data>
  <data key="d1">content</data>
  <data key="d2">FM 1-02.1 is referenced regarding populace and resources control measures.</data>
  <data key="d3">chunk-d90513532ac94b30a700a8204e509e17</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778758123</data>
  <data key="d6"></data>
</node>
<node id="Precision Fires">
  <data key="d0">Precision Fires</data>
  <data key="d1">concept</data>
  <data key="d2">Precision Fires present a challenge to rear area protection due to their increased range.&lt;SEP&gt;Precision fires pose unique challenges to rear area protection due to their increased range.</data>
  <data key="d3">chunk-d90513532ac94b30a700a8204e509e17&lt;SEP&gt;chunk-c69d05b2f34d86a1867e7e7939634802</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778758124</data>
  <data key="d6"></data>
</node>
<node id="Ballistic Missiles">
  <data key="d0">Ballistic Missiles</data>
  <data key="d1">artifact</data>
  <data key="d2">Ballistic Missiles are among the threats posing unique challenges to rear area protection.&lt;SEP&gt;Ballistic missiles are among the threats that rear area protection must counter.</data>
  <data key="d3">chunk-d90513532ac94b30a700a8204e509e17&lt;SEP&gt;chunk-c69d05b2f34d86a1867e7e7939634802</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778758124</data>
  <data key="d6"></data>
</node>
<node id="Cyber Effects">
  <data key="d0">Cyber Effects</data>
  <data key="d1">concept</data>
  <data key="d2">Cyber Effects are identified as a challenge to rear area protection alongside kinetic threats.&lt;SEP&gt;Cyber effects pose unique challenges to rear area protection in large-scale combat operations.</data>
  <data key="d3">chunk-d90513532ac94b30a700a8204e509e17&lt;SEP&gt;chunk-c69d05b2f34d86a1867e7e7939634802</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778758124</data>
  <data key="d6"></data>
</node>
<node id="C5ISRT Capabilities">
  <data key="d0">C5ISRT Capabilities</data>
  <data key="d1">concept</data>
  <data key="d2">C5ISRT Capabilities are adversary capabilities that Army special operations forces aim to disrupt.</data>
  <data key="d3">chunk-d90513532ac94b30a700a8204e509e17</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778758124</data>
  <data key="d6"></data>
</node>
<node id="Civilian Authorities">
  <data key="d0">Civilian Authorities</data>
  <data key="d1">organization</data>
  <data key="d2">Civilian Authorities work with Civil Affairs units to reestablish civil control and essential services in rear areas.</data>
  <data key="d3">chunk-d90513532ac94b30a700a8204e509e17</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778758124</data>
  <data key="d6"></data>
</node>
<node id="Army Protection Units">
  <data key="d0">Army Protection Units</data>
  <data key="d1">organization</data>
  <data key="d2">Army Protection Units work with Civil Affairs units in rear and bypassed areas to reestablish civil control and essential services.</data>
  <data key="d3">chunk-d90513532ac94b30a700a8204e509e17</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778758124</data>
  <data key="d6"></data>
</node>
<node id="Denied Area">
  <data key="d0">Denied Area</data>
  <data key="d1">location</data>
  <data key="d2">A Denied Area is an area under enemy or unfriendly control in which friendly forces cannot expect to operate within existing constraints.</data>
  <data key="d3">chunk-d90513532ac94b30a700a8204e509e17</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778758124</data>
  <data key="d6"></data>
</node>
<node id="Figure 5-3">
  <data key="d0">Figure 5-3</data>
  <data key="d1">content</data>
  <data key="d2">Figure 5-3 provides a notional framework depicting Army Special Operations Forces in rear and close areas during armed conflict.&lt;SEP&gt;Notional framework depicting special operations in the rear and close areas during armed conflict.</data>
  <data key="d3">chunk-d90513532ac94b30a700a8204e509e17&lt;SEP&gt;chunk-a75fd9bf2d8ffd7deb7994794314ba94</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778758124</data>
  <data key="d6"></data>
</node>
<node id="O-6">
  <data key="d0">O-6</data>
  <data key="d1">person</data>
  <data key="d2">An O-6 represents a command level for a Joint Special Operations Task Force attached to a land component commander.</data>
  <data key="d3">chunk-d90513532ac94b30a700a8204e509e17</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778758124</data>
  <data key="d6"></data>
</node>
<node id="Space and Cyber Assets">
  <data key="d0">Space and Cyber Assets</data>
  <data key="d1">artifact</data>
  <data key="d2">Space and Cyber Assets are enabled by Army Special Operations Forces' access to see, sense, and attack enemy activities.</data>
  <data key="d3">chunk-d90513532ac94b30a700a8204e509e17</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778758124</data>
  <data key="d6"></data>
</node>
<node id="Coalition Forces">
  <data key="d0">Coalition Forces</data>
  <data key="d1">organization</data>
  <data key="d2">Coalition Forces are accompanied by Army Special Operations Forces to facilitate command and control and promote unity of effort.</data>
  <data key="d3">chunk-d90513532ac94b30a700a8204e509e17</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778758124</data>
  <data key="d6"></data>
</node>
<node id="Joint Force Commanders">
  <data key="d0">Joint Force Commanders</data>
  <data key="d1">organization</data>
  <data key="d2">Commanders who receive advantages generated by Army special operations forces.&lt;SEP&gt;Commanders who receive comprehensive understanding and support from Army Special Operations Forces regarding enemy composition.</data>
  <data key="d3">chunk-5ada7ac41ab629e1f7809edf7d62800b&lt;SEP&gt;chunk-a75fd9bf2d8ffd7deb7994794314ba94</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778758125</data>
  <data key="d6"></data>
</node>
<node id="Task Force Viking">
  <data key="d0">Task Force Viking</data>
  <data key="d1">organization</data>
  <data key="d2">A combined joint special operations task force that operated during Operation Iraqi Freedom in 2003.</data>
