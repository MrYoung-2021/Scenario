  <data key="d12">1778747345</data>
  <data key="d13"></data>
</edge>
<edge source="Battle Position" target="Strong Point">
  <data key="d7">1.0</data>
  <data key="d8">A strong point is a heavily fortified type of battle position acting as an anchor for the defense.</data>
