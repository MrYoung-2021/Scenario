  <data key="d0">Combined Joint Special Operations Task Force-North</data>
  <data key="d1">organization</data>
  <data key="d2">Designation for Task Force Viking tasked with leading efforts along the Green Line.</data>
  <data key="d3">chunk-5ada7ac41ab629e1f7809edf7d62800b</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778758125</data>
  <data key="d6"></data>
</node>
<node id="Green Line">
  <data key="d0">Green Line</data>
  <data key="d1">location</data>
  <data key="d2">Boundary separating the Kurdish autonomous zone from Iraq to its south.</data>
  <data key="d3">chunk-5ada7ac41ab629e1f7809edf7d62800b</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778758125</data>
  <data key="d6"></data>
</node>
