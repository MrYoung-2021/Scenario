<node id="Area Security">
  <data key="d0">Area Security</data>
  <data key="d1">concept</data>
  <data key="d2">A type of security operation conducted to protect friendly forces, lines of communications, and activities within a specific area.&lt;SEP&gt;Area security is the responsibility of the land component commander including rear area protection.</data>
  <data key="d3">chunk-03ce33eb77548e57e227d14350711715&lt;SEP&gt;chunk-c69d05b2f34d86a1867e7e7939634802</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf&lt;SEP&gt;D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778758129</data>
  <data key="d6"></data>
</node>
<node id="Guard">
  <data key="d0">Guard</data>
  <data key="d1">method</data>
  <data key="d2">A type of security operation conducted to protect the main body by fighting, relying on the main body's support and unable to operate independently.</data>
  <data key="d3">chunk-03ce33eb77548e57e227d14350711715</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778747905</data>
  <data key="d6"></data>
</node>
<node id="Screen">
  <data key="d0">Screen</data>
  <data key="d1">method</data>
  <data key="d2">A type of security operation that primarily provides early warning to the protected force.</data>
  <data key="d3">chunk-03ce33eb77548e57e227d14350711715</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778747905</data>
  <data key="d6"></data>
</node>
<node id="Army BCT">
  <data key="d0">Army BCT</data>
  <data key="d1">organization</data>
  <data key="d2">Army Brigade Combat Teams, including armored, infantry, and Stryker types, capable of conducting security operations.</data>
  <data key="d3">chunk-03ce33eb77548e57e227d14350711715</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778747905</data>
  <data key="d6"></data>
</node>
<node id="Administrative Movement">
  <data key="d0">Administrative Movement</data>
  <data key="d1">method</data>
  <data key="d2">A type of troop movement arranged to expedite movement and conserve time and energy when no enemy interference is anticipated.</data>
  <data key="d3">chunk-03ce33eb77548e57e227d14350711715</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778747905</data>
  <data key="d6"></data>
</node>
<node id="Approach March">
  <data key="d0">Approach March</data>
  <data key="d1">method</data>
  <data key="d2">The advance of a combat unit when direct contact with the enemy is intended, emphasizing speed over tactical deployment.</data>
  <data key="d3">chunk-03ce33eb77548e57e227d14350711715</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778747905</data>
  <data key="d6"></data>
</node>
<node id="Tactical Road March">
  <data key="d0">Tactical Road March</data>
  <data key="d1">method</data>
  <data key="d2">A rapid movement used to relocate units within an area of operations to prepare for combat operations.</data>
  <data key="d3">chunk-03ce33eb77548e57e227d14350711715</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778747905</data>
  <data key="d6"></data>
</node>
<node id="Dismounted Marches">
  <data key="d0">Dismounted Marches</data>
  <data key="d1">method</data>
  <data key="d2">A method of troop movement where soldiers move on foot.</data>
  <data key="d3">chunk-03ce33eb77548e57e227d14350711715</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778747905</data>
  <data key="d6"></data>
</node>
<node id="Mounted Marches">
  <data key="d0">Mounted Marches</data>
  <data key="d1">method</data>
  <data key="d2">A method of troop movement using vehicles.</data>
  <data key="d3">chunk-03ce33eb77548e57e227d14350711715</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778747905</data>
  <data key="d6"></data>
</node>
<node id="Forced March">
  <data key="d0">Forced March</data>
  <data key="d1">method</data>
  <data key="d2">A method to hurry dismounted or mounted marches over extended distances when necessary.&lt;SEP&gt;A hurried dismounted or mounted march conducted when necessary.</data>
  <data key="d3">chunk-03ce33eb77548e57e227d14350711715&lt;SEP&gt;chunk-b036aa74f3adbdabd1d826936e991c47</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778747905</data>
  <data key="d6"></data>
</node>
<node id="Echelon Logistic Staff Officer">
  <data key="d0">Echelon Logistic Staff Officer</data>
  <data key="d1">person</data>
  <data key="d2">The staff officer responsible for supervising administrative movements.</data>
  <data key="d3">chunk-03ce33eb77548e57e227d14350711715</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778747905</data>
  <data key="d6"></data>
</node>
<node id="FM 3-90-2">
  <data key="d0">FM 3-90-2</data>
  <data key="d1">content</data>
  <data key="d2">A field manual providing additional information on the conduct of security operations.&lt;SEP&gt;A field manual providing additional information on the conduct of relief in place and passage of lines.</data>
  <data key="d3">chunk-03ce33eb77548e57e227d14350711715&lt;SEP&gt;chunk-b036aa74f3adbdabd1d826936e991c47</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778747905</data>
  <data key="d6"></data>
</node>
