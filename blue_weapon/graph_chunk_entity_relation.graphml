  <data key="d0">Basic Load</data>
  <data key="d1">concept</data>
  <data key="d2">The quantity of supplies required to be on hand and moved by a unit, expressed according to wartime organization.</data>
  <data key="d3">chunk-71131e902d37087dc65113f52eae4eb8</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778746002</data>
  <data key="d6"></data>
</node>
