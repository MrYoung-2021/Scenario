  <data key="d5">1778747292</data>
  <data key="d6"></data>
</node>
<node id="Withdraw">
  <data key="d0">Withdraw</data>
  <data key="d1">method</data>
  <data key="d2">A tactical operation to disengage from an enemy force and move away to preserve the force or release it for a new mission.</data>
  <data key="d3">chunk-7d8387d6c63026bf8e7495c788ece1b3</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
