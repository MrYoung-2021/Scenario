  <data key="d0">Aviation Fires</data>
  <data key="d1">concept</data>
  <data key="d2">Aviation Fires support ground forces and are determined by the commander's intent and proximity to ground forces.</data>
  <data key="d3">chunk-da2039fcc410ab417ea95cf892f406c7</data>
  <data key="d4">D:\Academic resources\ARN34839-ATP_3-06.1-000-WEB-1.pdf</data>
