  <data key="d10">chunk-7d8387d6c63026bf8e7495c788ece1b3</data>
  <data key="d11">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d12">1778747347</data>
  <data key="d13"></data>
</edge>
<edge source="Strong Point" target="Natural Object">
  <data key="d7">1.0</data>
  <data key="d8">A strong point is often tied to a natural or reinforcing obstacle to enhance defense.</data>
