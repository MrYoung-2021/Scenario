</node>
<node id="Shock Effect">
  <data key="d0">Shock Effect</data>
  <data key="d1">concept</data>
  <data key="d2">A temporary partial mental paralysis caused by a sudden event that prevents an immediate effective response.</data>
  <data key="d3">chunk-b6bf6abab46637a933d4adcc9ec578f4</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778745998</data>
  <data key="d6"></data>
</node>
<node id="Decisive Terrain">
  <data key="d0">Decisive Terrain</data>
  <data key="d1">location</data>
  <data key="d2">Key terrain that is mandatory for successful mission accomplishment.&lt;SEP&gt;Key terrain that is retained to deny a vital area to the enemy, serving as a purpose of the defense.</data>
  <data key="d3">chunk-b6bf6abab46637a933d4adcc9ec578f4&lt;SEP&gt;chunk-3345760dcbfb2262ee6ddfa43b1677ad</data>
