  <data key="d5">1778747314</data>
  <data key="d6"></data>
</node>
<node id="Complex Terrain">
  <data key="d0">Complex Terrain</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Terrain where dismounted infantry forces are best suited for offensive operations.</data>
  <data key="d3">chunk-b6bf6abab46637a933d4adcc9ec578f4</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778745998</data>
  <data key="d6"></data>
</node>
<node id="Army Aviation Units">
  <data key="d0">Army Aviation Units</data>
  <data key="d1">organization</data>
  <data key="d2">Units that conduct air-ground operations to increase the combat power and survivability of the combined arms team.</data>
  <data key="d3">chunk-b6bf6abab46637a933d4adcc9ec578f4</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778745998</data>
  <data key="d6"></data>
</node>
<node id="Attack Helicopters">
  <data key="d0">Attack Helicopters</data>
  <data key="d1">artifact</data>
  <data key="d2">Aircraft most effective in limited visibility against exposed enemy forces on the move.</data>
  <data key="d3">chunk-b6bf6abab46637a933d4adcc9ec578f4</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778745998</data>
  <data key="d6"></data>
</node>
<node id="Combined Arms Team">
  <data key="d0">Combined Arms Team</data>
  <data key="d1">organization</data>
  <data key="d2">A military team that integrates various arms, supported by Army aviation units acting as the aviation maneuver force.&lt;SEP&gt;Military team members with whom aircraft are not necessarily task-organized during air movement operations.</data>
  <data key="d3">chunk-b6bf6abab46637a933d4adcc9ec578f4&lt;SEP&gt;chunk-dfe3e79800d49e6c15cc7d1d7485cab2</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf&lt;SEP&gt;D:\Academic resources\ARN34839-ATP_3-06.1-000-WEB-1.pdf</data>
  <data key="d5">1778751446</data>
  <data key="d6"></data>
</node>
<node id="Direct Fire">
  <data key="d0">Direct Fire</data>
  <data key="d1">event</data>
  <data key="d2">Fire delivered directly at the enemy, used in combination with movement during close combat.&lt;SEP&gt;Gunfire aimed directly at a target, which cover and guard operations aim to prevent against the main body.</data>
  <data key="d3">chunk-b6bf6abab46637a933d4adcc9ec578f4&lt;SEP&gt;chunk-03ce33eb77548e57e227d14350711715</data>
