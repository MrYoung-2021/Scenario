</edge>
<edge source="Enemy Force" target="Attack Helicopters">
  <data key="d7">1.0</data>
  <data key="d8">Attack helicopters are most effective against exposed enemy forces, particularly in conditions of limited visibility.</data>
  <data key="d9">attack,visibility conditions</data>
  <data key="d10">chunk-b6bf6abab46637a933d4adcc9ec578f4</data>
