</node>
<node id="FMV">
  <data key="d0">FMV</data>
  <data key="d1">data</data>
  <data key="d2">FMV provides real-time situational awareness gained from aircrew callouts and onboard sensors.&lt;SEP&gt;FMV is transmitted by aircraft and used by JTACs or FAC(A)s to confirm targets.</data>
  <data key="d3">chunk-da2039fcc410ab417ea95cf892f406c7&lt;SEP&gt;chunk-94b0f13f75f0bd64d503a14651482e66</data>
