  <data key="d3">chunk-03ce33eb77548e57e227d14350711715</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778747905</data>
  <data key="d6"></data>
</node>
<node id="Friendly Force">
  <data key="d0">Friendly Force</data>
  <data key="d1">concept</data>
  <data key="d2">A military force or unit that security operations aim to protect from surprise and enemy interference.&lt;SEP&gt;Friendly Force refers to allied military units requiring protection and identification during operations.</data>
  <data key="d3">chunk-03ce33eb77548e57e227d14350711715&lt;SEP&gt;chunk-94b0f13f75f0bd64d503a14651482e66</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf&lt;SEP&gt;D:\Academic resources\ARN34839-ATP_3-06.1-000-WEB-1.pdf</data>
  <data key="d5">1778751499</data>
  <data key="d6"></data>
</node>
<node id="Civilian Population">
  <data key="d0">Civilian Population</data>
  <data key="d1">person</data>
  <data key="d2">Non-military personnel within an area of operations who may be protected by security forces.&lt;SEP&gt;Noncombatants in the urban area who are affected by the impassability of destroyed road surfaces.&lt;SEP&gt;The Civilian Population in urban environments affects PID, CD, and ROE assessments and increases risks.</data>
  <data key="d3">chunk-03ce33eb77548e57e227d14350711715&lt;SEP&gt;chunk-da2039fcc410ab417ea95cf892f406c7&lt;SEP&gt;chunk-ecb60400466a6008ca4dd586ce73558f</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf&lt;SEP&gt;D:\Academic resources\ARN34839-ATP_3-06.1-000-WEB-1.pdf</data>
  <data key="d5">1778751465</data>
  <data key="d6"></data>
</node>
<node id="Infantry BCT">
  <data key="d0">Infantry BCT</data>
  <data key="d1">organization</data>
  <data key="d2">Infantry Brigade Combat Team, a type of Army BCT capable of conducting security operations and tactical marches.</data>
  <data key="d3">chunk-03ce33eb77548e57e227d14350711715</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778747906</data>
  <data key="d6"></data>
</node>
<node id="Battlefield Agility">
  <data key="d0">Battlefield Agility</data>
  <data key="d1">concept</data>
  <data key="d2">The capability to conduct rapid and orderly movement to concentrate combat power at decisive points.</data>
  <data key="d3">chunk-03ce33eb77548e57e227d14350711715</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778747906</data>
  <data key="d6"></data>
</node>
<node id="Movement Control">
  <data key="d0">Movement Control</data>
  <data key="d1">method</data>
  <data key="d2">The dual process of committing allocated transportation assets and regulating movements to synchronize distribution flow.</data>
  <data key="d3">chunk-b036aa74f3adbdabd1d826936e991c47</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778747906</data>
  <data key="d6"></data>
</node>
<node id="Land Forces">
  <data key="d0">Land Forces</data>
  <data key="d1">organization</data>
  <data key="d2">Forces that are sustained by the synchronization of distribution flow over lines of communications.</data>
  <data key="d3">chunk-b036aa74f3adbdabd1d826936e991c47</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778747906</data>
  <data key="d6"></data>
</node>
<node id="Incoming Unit">
  <data key="d0">Incoming Unit</data>
  <data key="d1">organization</data>
  <data key="d2">A unit that replaces another unit and assumes responsibility for the mission and assigned zone of operations.</data>
  <data key="d3">chunk-b036aa74f3adbdabd1d826936e991c47</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778747906</data>
  <data key="d6"></data>
</node>
<node id="Relieved Unit">
  <data key="d0">Relieved Unit</data>
  <data key="d1">organization</data>
  <data key="d2">A unit that is replaced in an area during a relief in place operation.</data>
  <data key="d3">chunk-b036aa74f3adbdabd1d826936e991c47</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778747906</data>
  <data key="d6"></data>
</node>
<node id="Zone of Operations">
  <data key="d0">Zone of Operations</data>
  <data key="d1">location</data>
  <data key="d2">An area assigned to a unit, a term used in joint doctrine, which the Army refers to as an Area of Operations.</data>
  <data key="d3">chunk-b036aa74f3adbdabd1d826936e991c47</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778747906</data>
  <data key="d6"></data>
</node>
