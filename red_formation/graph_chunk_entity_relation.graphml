  <data key="d0">Landwehr</data>
  <data key="d1">organization</data>
  <data key="d2">Landwehr is a reserve military force established in Europe during the 18th and 19th centuries.</data>
  <data key="d3">chunk-41b7f6e47322107075587da5b8dd1c7e</data>
