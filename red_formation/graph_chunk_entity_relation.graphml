</node>
<node id="Battle of Steenkirk">
  <data key="d0">Battle of Steenkirk</data>
  <data key="d1">event</data>
  <data key="d2">Battle of Steenkirk is a decisive engagement involving Francois Luxembourg that broke away from traditional tactics.</data>
