  <data key="d1">concept</data>
  <data key="d2">Horse Artillery is a specialized unit combining cavalry speed with artillery firepower.</data>
  <data key="d3">chunk-41b7f6e47322107075587da5b8dd1c7e</data>
  <data key="d4">D:\Academic resources\战争论.pdf</data>
  <data key="d5">1778774809</data>
