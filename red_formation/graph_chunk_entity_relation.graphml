  <data key="d1">method</data>
  <data key="d2">This marching formation is used when the future battlefield direction relative to the unit is unknown.</data>
  <data key="d3">chunk-38f13e59336c7bb333fab6bbbe0ac097</data>
  <data key="d4">D:\Academic resources\战争论.pdf</data>
