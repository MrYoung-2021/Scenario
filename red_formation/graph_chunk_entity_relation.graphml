  <data key="d0">Small Observation Units</data>
  <data key="d1">organization</data>
  <data key="d2">Small Observation Units are detachments deployed forward alongside the Vanguard Force specifically to monitor enemy movements.</data>
  <data key="d3">chunk-e42e0d19c01d89b60bcea1e8c8214463</data>
  <data key="d4">D:\Academic resources\战争论.pdf</data>
  <data key="d5">1778774740</data>
