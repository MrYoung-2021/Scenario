  <data key="d1">content</data>
  <data key="d2">Provisions refer to food and consumables that are often stored in undefended locations for easy replenishment.</data>
  <data key="d3">chunk-77045b1c2599a8ac0acb0e781562ae49</data>
  <data key="d4">D:\Academic resources\战争论.pdf</data>
  <data key="d5">1778774823</data>
  <data key="d6"></data>
</node>
