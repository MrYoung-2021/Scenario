  <data key="d0">Forward Troops</data>
  <data key="d1">concept</data>
  <data key="d2">Forward Troops may disperse into outpost lines during winter quartering to facilitate easier camping and security.</data>
  <data key="d3">chunk-1ceef5e0b237a9edd2580a6c4fbfed04</data>
  <data key="d4">D:\Academic resources\战争论.pdf</data>
  <data key="d5">1778774822</data>
  <data key="d6"></data>
</node>
