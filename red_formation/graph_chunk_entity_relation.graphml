  <data key="d0">Waterloo Battle</data>
  <data key="d1">event</data>
  <data key="d2">The Waterloo Battle was a conflict where Napoleon lost significantly against a large coalition force.</data>
  <data key="d3">chunk-41b7f6e47322107075587da5b8dd1c7e</data>
