  <data key="d0">Civilian Population</data>
  <data key="d1">concept</data>
  <data key="d2">Civilian Population bears the burden of grain delivery and faces pressure or punishment to comply with requisition demands.</data>
  <data key="d3">chunk-a3e30125fa729c9d2fb7970405171875</data>
  <data key="d4">D:\Academic resources\战争论.pdf</data>
