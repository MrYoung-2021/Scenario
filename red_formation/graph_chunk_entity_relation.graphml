  <data key="d0">Supplies And Billeting</data>
  <data key="d1">concept</data>
  <data key="d2">Logistical considerations regarding food and accommodation that influence the feasibility of separating troops into distinct units.</data>
  <data key="d3">chunk-e42e0d19c01d89b60bcea1e8c8214463</data>
  <data key="d4">D:\Academic resources\战争论.pdf</data>
  <data key="d5">1778774739</data>
  <data key="d6"></data>
</node>
<node id="Deployment System">
  <data key="d0">Deployment System</data>
  <data key="d1">concept</data>
  <data key="d2">A natural organizational framework where the Main Body divides into four or five distinct components based on deployment needs.</data>
  <data key="d3">chunk-e42e0d19c01d89b60bcea1e8c8214463</data>
  <data key="d4">D:\Academic resources\战争论.pdf</data>
