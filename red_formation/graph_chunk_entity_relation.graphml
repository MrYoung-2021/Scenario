  <data key="d6"></data>
</node>
<node id="Five-Day Travel System">
  <data key="d0">Five-Day Travel System</data>
  <data key="d1">method</data>
  <data key="d2">The Five-Day Travel System was a logistical supply method where armies stationed themselves within five days of warehouses and bakeries.</data>
  <data key="d3">chunk-88b03fbc1bc0a2f36813dfff78edd095</data>
  <data key="d4">D:\Academic resources\战争论.pdf</data>
  <data key="d5">1778774814</data>
  <data key="d6"></data>
</node>
<node id="Duke Of Brunswick">
  <data key="d0">Duke Of Brunswick</data>
  <data key="d1">person</data>
  <data key="d2">The Duke Of Brunswick was a Prussian General who persisted in using the Five-Day Travel System during conflicts in the 18th century.</data>
  <data key="d3">chunk-88b03fbc1bc0a2f36813dfff78edd095</data>
