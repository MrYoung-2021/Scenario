  <data key="d0">York Corps</data>
  <data key="d1">organization</data>
  <data key="d2">A Prussian military corps commanded by York that participated in the 1813 Silesian and Saxon campaigns.</data>
  <data key="d3">chunk-72c55a94307c751d0e9fbf6270e7773d</data>
  <data key="d4">D:\Academic resources\战争论.pdf</data>
