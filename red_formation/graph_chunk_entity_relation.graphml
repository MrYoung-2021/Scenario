  <data key="d0">Opole Voivodeship</data>
  <data key="d1">location</data>
  <data key="d2">The battle took place near Opole Voivodeship in modern-day Poland.</data>
  <data key="d3">chunk-9ed0edc361ac37e0deef9374d8ec557e</data>
  <data key="d4">D:\Academic resources\战争论.pdf</data>
  <data key="d5">1778774784</data>
  <data key="d6"></data>
</node>
