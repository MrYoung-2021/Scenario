  <data key="d5">1778774807</data>
  <data key="d6"></data>
</node>
<node id="British Army">
  <data key="d0">British Army</data>
  <data key="d1">organization</data>
  <data key="d2">The British Army participated in multiple campaigns against France under Wellington's command.&lt;SEP&gt;The British Army is commanded by Wellington and constrained by Ney's advance.</data>
  <data key="d3">chunk-a8b814c286eb1e073648265d5177eb69&lt;SEP&gt;chunk-5caa7084b9aab1683b075dc4fc333250</data>
