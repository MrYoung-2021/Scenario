</node>
<node id="Conscription">
  <data key="d0">Conscription</data>
  <data key="d1">method</data>
  <data key="d2">Conscription is a method Napoleon used to recruit soldiers to the maximum extent possible for his campaigns.</data>
  <data key="d3">chunk-0ea6ac7b39b9305030f2c7226a86db43</data>
