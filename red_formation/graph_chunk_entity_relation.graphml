</node>
<node id="Traffic Lines">
  <data key="d0">Traffic Lines</data>
  <data key="d1">concept</data>
  <data key="d2">Traffic Lines refer to supply and communication routes whose strategic advantage can significantly impact the vulnerability of an army's flanks.</data>
  <data key="d3">chunk-e42e0d19c01d89b60bcea1e8c8214463</data>
  <data key="d4">D:\Academic resources\战争论.pdf</data>
