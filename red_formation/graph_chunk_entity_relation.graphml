  <data key="d0">Kurt Christoph Von Schwerin</data>
  <data key="d1">person</data>
  <data key="d2">Kurt Christoph Von Schwerin was a Prussian field marshal and one of the main commanders under Frederick The Great.</data>
  <data key="d3">chunk-38f13e59336c7bb333fab6bbbe0ac097</data>
  <data key="d4">D:\Academic resources\战争论.pdf</data>
