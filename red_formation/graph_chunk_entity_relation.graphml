<node id="Jean de Beaurain">
  <data key="d0">Jean de Beaurain</data>
  <data key="d1">person</data>
  <data key="d2">Jean de Beaurain was a French geographer and cartographer who authored the history of the War in Flanders.</data>
  <data key="d3">chunk-bace62a86e707c9881144ea59dde7a4a</data>
