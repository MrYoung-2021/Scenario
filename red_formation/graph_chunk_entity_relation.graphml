<node id="Scout Duty">
  <data key="d0">Scout Duty</data>
  <data key="d1">concept</data>
  <data key="d2">Operational roles involving outpost service, reconnaissance, and holding forward positions which cause difficulties for mixed-unit forces lacking cavalry.</data>
