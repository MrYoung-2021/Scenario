  <data key="d4">D:\Academic resources\战争论.pdf</data>
  <data key="d5">1778774804</data>
  <data key="d6"></data>
</node>
<node id="Brussels">
  <data key="d0">Brussels</data>
  <data key="d1">location</data>
  <data key="d2">Brussels is a city located approximately 50 kilometers from Steinkerque, serving as a geographical reference point.&lt;SEP&gt;Brussels is a city in Belgium located approximately 50 kilometers south of Charleroi.&lt;SEP&gt;Brussels is the capital of Belgium, situated in central Belgium on the Senne River, a tributary of the Scheldt.&lt;SEP&gt;Brussels is a key city on the western supply route where provisions are obtained through commercial means.</data>
  <data key="d3">chunk-bace62a86e707c9881144ea59dde7a4a&lt;SEP&gt;chunk-a2a90ee6c570c1f41213848bde0e55e5&lt;SEP&gt;chunk-9de7adb6e29e9aaaa3a95674b64a2552&lt;SEP&gt;chunk-ffd9ee2ca6a2dbeb008f986d03860045</data>
  <data key="d4">D:\Academic resources\战争论.pdf</data>
  <data key="d5">1778774804</data>
  <data key="d6"></data>
</node>
