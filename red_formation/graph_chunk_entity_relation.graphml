  <data key="d0">Spanish Campaign</data>
  <data key="d1">event</data>
  <data key="d2">The Spanish Campaign is a military event where the army depleted local resources leading to forced negotiations.</data>
  <data key="d3">chunk-fc6725d3545cdb40e1dfdd2209aba40f</data>
