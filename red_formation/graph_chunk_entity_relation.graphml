  <data key="d0">Neerwinden</data>
  <data key="d1">location</data>
  <data key="d2">Neerwinden was part of Landen city in Flemish Brabant, Belgium, serving as another significant battlefield.</data>
  <data key="d3">chunk-bace62a86e707c9881144ea59dde7a4a</data>
