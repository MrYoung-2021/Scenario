<node id="运-20">
  <data key="d0">运-20</data>
  <data key="d1">artifact</data>
  <data key="d2">运-20(代号：鲲鹏，昵称：胖妞)是中国自主研发的首款大型、多用途运输机，最大起飞重量220吨，载重超过66吨，可执行长距离航空运输任务。</data>
  <data key="d3">chunk-7d36f7e851df169e341230a2831ce9f0</data>
  <data key="d4">unknown_source</data>
