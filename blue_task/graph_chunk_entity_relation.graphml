  <data key="d5">1778752903</data>
  <data key="d6"></data>
</node>
<node id="IR Strobe Lights">
  <data key="d0">IR Strobe Lights</data>
  <data key="d1">artifact</data>
  <data key="d2">IR strobe lights are marking tools whose effectiveness may be precluded by urban lighting.</data>
  <data key="d3">chunk-92727f2c37c01b0f00dced1121d6f6ba</data>
  <data key="d4">D:\Academic resources\ARN34839-ATP_3-06.1-000-WEB-1.pdf</data>
  <data key="d5">1778752903</data>
  <data key="d6"></data>
</node>
<node id="Urban Lights">
  <data key="d0">Urban Lights</data>
  <data key="d1">artifact</data>
  <data key="d2">Urban lights are artificial lighting sources in urban areas that may overwhelm aircrew NVDs and affect IR strobe light effectiveness.</data>
  <data key="d3">chunk-92727f2c37c01b0f00dced1121d6f6ba</data>
  <data key="d4">D:\Academic resources\ARN34839-ATP_3-06.1-000-WEB-1.pdf</data>
