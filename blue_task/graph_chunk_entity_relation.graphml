  <data key="d3">chunk-466f239ae26f543930ce42fb131832cc</data>
  <data key="d4">D:\Academic resources\ARN34839-ATP_3-06.1-000-WEB-1.pdf</data>
  <data key="d5">1778752902</data>
  <data key="d6"></data>
</node>
<node id="Machine Guns">
  <data key="d0">Machine Guns</data>
  <data key="d1">artifact</data>
  <data key="d2">Machine guns are used by adversaries in urban environments to threaten friendly aircraft.</data>
  <data key="d3">chunk-466f239ae26f543930ce42fb131832cc</data>
