  <data key="d4">D:\Academic resources\ARN34839-ATP_3-06.1-000-WEB-1.pdf</data>
  <data key="d5">1778752903</data>
  <data key="d6"></data>
</node>
<node id="NVD">
  <data key="d0">NVD</data>
  <data key="d1">artifact</data>
  <data key="d2">NVDs are night vision devices that may be overwhelmed by urban lights.</data>
