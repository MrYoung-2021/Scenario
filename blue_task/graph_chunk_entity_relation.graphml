  <data key="d1">organization</data>
  <data key="d2">Partner Nation Security Forces are integrated with Army special operations forces during operations.</data>
  <data key="d3">chunk-9b8ed0cc5c4a8e919c8f12065962561e</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
