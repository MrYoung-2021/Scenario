</node>
<node id="Ground Photos">
  <data key="d0">Ground Photos</data>
  <data key="d1">data</data>
  <data key="d2">Ground Photos provide valuable information and terrain references for Landing Zone assessment.</data>
  <data key="d3">chunk-bf2865a0fcb23cc7955b08ca1d4c5b89</data>
