  <data key="d8">Leaders and units use warning orders to maximize parallel planning.</data>
  <data key="d9">planning,usage</data>
  <data key="d10">chunk-7e26474dd179be588057ca7d29d2fdfd</data>
  <data key="d11">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d12">1778748544</data>
  <data key="d13"></data>
</edge>
<edge source="Leaders" target="Collaborative Systems">
  <data key="d7">1.0</data>
  <data key="d8">Leaders use collaborative systems to accelerate the decision-making process.</data>
