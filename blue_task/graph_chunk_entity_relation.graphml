  <data key="d5">1778752901</data>
  <data key="d6"></data>
</node>
<node id="Antennas">
  <data key="d0">Antennas</data>
  <data key="d1">artifact</data>
  <data key="d2">Hazards such as roof clutter or obstacles on ingress and egress routes that can obstruct landing areas.</data>
  <data key="d3">chunk-255d2259beb766bee7c72c77afa91c9c</data>
  <data key="d4">D:\Academic resources\ARN34839-ATP_3-06.1-000-WEB-1.pdf</data>
  <data key="d5">1778752901</data>
  <data key="d6"></data>
</node>
<node id="Wires">
  <data key="d0">Wires</data>
  <data key="d1">artifact</data>
  <data key="d2">Hazards present on rooftops or along ingress and egress routes that challenge safe aircraft operations.</data>
  <data key="d3">chunk-255d2259beb766bee7c72c77afa91c9c</data>
  <data key="d4">D:\Academic resources\ARN34839-ATP_3-06.1-000-WEB-1.pdf</data>
  <data key="d5">1778752901</data>
  <data key="d6"></data>
</node>
<node id="Rotary-Wing Aircraft">
  <data key="d0">Rotary-Wing Aircraft</data>
  <data key="d1">artifact</data>
  <data key="d2">Rotary-wing aircraft are involved in FARP and ADGR operations and marshalling plans.&lt;SEP&gt;A type of aircraft requiring marshalling plans and maneuver space at FARP and ADGR sites.</data>
  <data key="d3">chunk-255d2259beb766bee7c72c77afa91c9c&lt;SEP&gt;chunk-92727f2c37c01b0f00dced1121d6f6ba</data>
