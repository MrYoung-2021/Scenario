  <data key="d5">1778752911</data>
  <data key="d6"></data>
</node>
<node id="Reconnaissance Assets">
  <data key="d0">Reconnaissance Assets</data>
  <data key="d1">artifact</data>
  <data key="d2">Reconnaissance Assets produce products used to examine terrain for Landing Zones.</data>
  <data key="d3">chunk-bf2865a0fcb23cc7955b08ca1d4c5b89</data>
  <data key="d4">D:\Academic resources\ARN34839-ATP_3-06.1-000-WEB-1.pdf</data>
  <data key="d5">1778752911</data>
  <data key="d6"></data>
</node>
<node id="Load-bearing Structures">
  <data key="d0">Load-bearing Structures</data>
  <data key="d1">location</data>
  <data key="d2">Load-bearing Structures are buildings that can accommodate helicopters landing on their rooftop.</data>
