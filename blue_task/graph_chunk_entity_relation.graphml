  <data key="d6"></data>
</node>
<node id="Integration">
  <data key="d0">Integration</data>
  <data key="d1">concept</data>
  <data key="d2">Integration is a principle necessitating the deliberate synchronization of Army special operations forces with conventional forces and other actors.</data>
  <data key="d3">chunk-9b8ed0cc5c4a8e919c8f12065962561e</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778759228</data>
  <data key="d6"></data>
</node>
<node id="Persistence">
  <data key="d0">Persistence</data>
  <data key="d1">concept</data>
  <data key="d2">Persistence is a principle recognizing the requirement for patience and continuity of effort to achieve long-term enduring outcomes.</data>
  <data key="d3">chunk-9b8ed0cc5c4a8e919c8f12065962561e</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
