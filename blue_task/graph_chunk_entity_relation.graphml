</node>
<node id="Flight Hazards">
  <data key="d0">Flight Hazards</data>
  <data key="d1">concept</data>
  <data key="d2">Flight hazards include physical, environmental, natural, air traffic, and electromagnetic hazards critical to safe flight operations.</data>
  <data key="d3">chunk-466f239ae26f543930ce42fb131832cc</data>
  <data key="d4">D:\Academic resources\ARN34839-ATP_3-06.1-000-WEB-1.pdf</data>
  <data key="d5">1778752902</data>
  <data key="d6"></data>
</node>
<node id="Physical Hazards">
  <data key="d0">Physical Hazards</data>
  <data key="d1">concept</data>
  <data key="d2">Physical hazards are mostly man-made obstructions like kites, antennas, wires, and power lines.</data>
  <data key="d3">chunk-466f239ae26f543930ce42fb131832cc</data>
  <data key="d4">D:\Academic resources\ARN34839-ATP_3-06.1-000-WEB-1.pdf</data>
  <data key="d5">1778752902</data>
  <data key="d6"></data>
</node>
<node id="Environmental Hazards">
  <data key="d0">Environmental Hazards</data>
  <data key="d1">concept</data>
  <data key="d2">Environmental hazards include meteorological effects like haze, mist, dust, and unpredictable wind effects.</data>
  <data key="d3">chunk-466f239ae26f543930ce42fb131832cc</data>
  <data key="d4">D:\Academic resources\ARN34839-ATP_3-06.1-000-WEB-1.pdf</data>
  <data key="d5">1778752902</data>
  <data key="d6"></data>
</node>
<node id="Natural Hazards">
  <data key="d0">Natural Hazards</data>
  <data key="d1">concept</data>
  <data key="d2">Natural hazards include mountains, hills, trees, and areas with high concentrations of birds.</data>
  <data key="d3">chunk-466f239ae26f543930ce42fb131832cc</data>
  <data key="d4">D:\Academic resources\ARN34839-ATP_3-06.1-000-WEB-1.pdf</data>
  <data key="d5">1778752902</data>
  <data key="d6"></data>
</node>
<node id="Air Traffic Hazards">
  <data key="d0">Air Traffic Hazards</data>
  <data key="d1">concept</data>
  <data key="d2">Air traffic hazards include rotary-wing, tiltrotor, fixed-wing aircraft, and SUAS within urban areas.</data>
  <data key="d3">chunk-466f239ae26f543930ce42fb131832cc</data>
  <data key="d4">D:\Academic resources\ARN34839-ATP_3-06.1-000-WEB-1.pdf</data>
  <data key="d5">1778752902</data>
  <data key="d6"></data>
</node>
<node id="Electromagnetic Hazards">
