  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778748538</data>
  <data key="d6"></data>
</node>
<node id="Strategic Level Of Warfare">
  <data key="d0">Strategic Level Of Warfare</data>
  <data key="d1">concept</data>
  <data key="d2">The strategic level of warfare provides the context for tactical operations and goals.</data>
  <data key="d3">chunk-6888ee0fc5990f7bfbc04bd6cfb28c44</data>
