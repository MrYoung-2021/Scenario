  <data key="d0">Combatant Commands</data>
  <data key="d1">organization</data>
  <data key="d2">Combatant commands are supported by expertise, material, and teams to locate and track weapons of mass destruction.</data>
  <data key="d3">chunk-c8f143cf228a70fcc3b24d3886031aa2</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778759226</data>
