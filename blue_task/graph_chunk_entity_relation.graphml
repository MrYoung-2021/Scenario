  <data key="d0">Transnational Organized Crime</data>
  <data key="d1">concept</data>
  <data key="d2">Transnational organized crime is a security threat countered by U.S. Army counter threat finance activities.</data>
  <data key="d3">chunk-c8f143cf228a70fcc3b24d3886031aa2</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
