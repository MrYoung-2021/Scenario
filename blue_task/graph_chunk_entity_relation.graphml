  <data key="d5">1778759229</data>
  <data key="d6"></data>
</node>
<node id="Joint Operations">
  <data key="d0">Joint Operations</data>
  <data key="d1">concept</data>
  <data key="d2">Joint Operations follow the principles of war alongside the Army's organizational approach.</data>
  <data key="d3">chunk-9b8ed0cc5c4a8e919c8f12065962561e</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778759229</data>
  <data key="d6"></data>
</node>
