  <data key="d3">chunk-9b8ed0cc5c4a8e919c8f12065962561e</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778759230</data>
  <data key="d6"></data>
</node>
<node id="Governmental And Non-Governmental Organizations">
  <data key="d0">Governmental And Non-Governmental Organizations</data>
  <data key="d1">organization</data>
  <data key="d2">Governmental and non-governmental organizations are integrated with Army special operations forces.</data>
