</node>
<node id="Brown-out Conditions">
  <data key="d0">Brown-out Conditions</data>
  <data key="d1">concept</data>
  <data key="d2">Brown-out Conditions are anticipated hazards for MV-22 operations affecting landing zone size.</data>
  <data key="d3">chunk-bf2865a0fcb23cc7955b08ca1d4c5b89</data>
