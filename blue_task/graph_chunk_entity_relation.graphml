  <data key="d5">1778752905</data>
  <data key="d6"></data>
</node>
<node id="Battle">
  <data key="d0">Battle</data>
  <data key="d1">event</data>
  <data key="d2">A battle is a set of related engagements that lasts longer and involves larger forces than an engagement.</data>
  <data key="d3">chunk-6888ee0fc5990f7bfbc04bd6cfb28c44</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778748539</data>
  <data key="d6"></data>
</node>
