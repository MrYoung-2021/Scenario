  <data key="d0">Department Of Justice</data>
  <data key="d1">organization</data>
  <data key="d2">The Department Of Justice is a federal agency mentioned in relation to leading agency societies and referenced in JP 3-26.</data>
  <data key="d3">chunk-fb8968defc8aab21974e71c786c3b7a9</data>
