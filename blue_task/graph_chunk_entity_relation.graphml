  <data key="d5">1778752905</data>
  <data key="d6"></data>
</node>
<node id="Ordnance Delivery">
  <data key="d0">Ordnance Delivery</data>
  <data key="d1">concept</data>
  <data key="d2">Ordnance delivery is an aircraft task requiring sufficient time and altitude.</data>
  <data key="d3">chunk-92727f2c37c01b0f00dced1121d6f6ba</data>
  <data key="d4">D:\Academic resources\ARN34839-ATP_3-06.1-000-WEB-1.pdf</data>
  <data key="d5">1778752905</data>
  <data key="d6"></data>
</node>
<node id="Environmental Concerns">
  <data key="d0">Environmental Concerns</data>
  <data key="d1">concept</data>
  <data key="d2">Environmental concerns include weather, lighting conditions, IR signatures, visibility, thermal reflection, and smoke or fog.</data>
  <data key="d3">chunk-92727f2c37c01b0f00dced1121d6f6ba</data>
  <data key="d4">D:\Academic resources\ARN34839-ATP_3-06.1-000-WEB-1.pdf</data>
  <data key="d5">1778752905</data>
  <data key="d6"></data>
</node>
<node id="Air Force">
  <data key="d0">Air Force</data>
  <data key="d1">organization</data>
  <data key="d2">The Air Force is a military organization that refers to Groups 4 and 5 UASs as RPAs.&lt;SEP&gt;The Air Force is a military branch that refers to specific UAS groups as RPAs.</data>
  <data key="d3">chunk-f85140b13c2f4467aec323c7ad488b32&lt;SEP&gt;chunk-b3a8a845280b83251233809b74dd7287</data>
