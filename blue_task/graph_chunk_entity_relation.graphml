  <data key="d13"></data>
</edge>
<edge source="Leaders" target="Commanders">
  <data key="d7">1.0</data>
  <data key="d8">Commanders are responsible for training subordinates and leaders master the art of tactics.</data>
  <data key="d9">subordination,training</data>
  <data key="d10">chunk-7eca3fafdc38ef10f3b3cf3553129b6b</data>
