  <data key="d6"></data>
</node>
<node id="Imagery">
  <data key="d0">Imagery</data>
  <data key="d1">data</data>
  <data key="d2">Imagery is reviewed to accurately assess Landing Zone size and hazards.</data>
  <data key="d3">chunk-bf2865a0fcb23cc7955b08ca1d4c5b89</data>
