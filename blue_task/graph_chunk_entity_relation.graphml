  <data key="d5">1778752903</data>
  <data key="d6"></data>
</node>
<node id="IR Signatures">
  <data key="d0">IR Signatures</data>
  <data key="d1">concept</data>
  <data key="d2">IR signatures are affected by the proximity of buildings and higher urban temperatures.</data>
  <data key="d3">chunk-92727f2c37c01b0f00dced1121d6f6ba</data>
  <data key="d4">D:\Academic resources\ARN34839-ATP_3-06.1-000-WEB-1.pdf</data>
  <data key="d5">1778752903</data>
  <data key="d6"></data>
</node>
