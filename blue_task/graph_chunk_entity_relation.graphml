<node id="Northern Alliance">
  <data key="d0">Northern Alliance</data>
  <data key="d1">organization</data>
  <data key="d2">The Northern Alliance is a group that received support as a strategic main effort against Taliban-controlled forces following the 11 September 2001 terrorist attacks.</data>
