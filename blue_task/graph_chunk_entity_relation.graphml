  <data key="d5">1778752902</data>
  <data key="d6"></data>
</node>
<node id="Urban Terrain">
  <data key="d0">Urban Terrain</data>
  <data key="d1">location</data>
  <data key="d2">Urban terrain includes surface, supersurface, and subsurface development and presents unique cover and concealment.&lt;SEP&gt;Urban Terrain is an environment characterized by a high concentration of structures, cultural lighting, and changing landscapes due to combat operations.</data>
  <data key="d3">chunk-466f239ae26f543930ce42fb131832cc&lt;SEP&gt;chunk-bf2865a0fcb23cc7955b08ca1d4c5b89</data>
  <data key="d4">D:\Academic resources\ARN34839-ATP_3-06.1-000-WEB-1.pdf</data>
  <data key="d5">1778752902</data>
  <data key="d6"></data>
</node>
<node id="Space Support Personnel">
  <data key="d0">Space Support Personnel</data>
  <data key="d1">person</data>
  <data key="d2">Space support personnel produce products like satellite imagery to assist in mitigating unknown obstacles.</data>
  <data key="d3">chunk-466f239ae26f543930ce42fb131832cc</data>
  <data key="d4">D:\Academic resources\ARN34839-ATP_3-06.1-000-WEB-1.pdf</data>
  <data key="d5">1778752902</data>
  <data key="d6"></data>
</node>
<node id="Satellite Imagery">
  <data key="d0">Satellite Imagery</data>
  <data key="d1">data</data>
  <data key="d2">Recent unclassified satellite imagery is releasable to coalition partners and assists aircrews in visualizing objective areas.</data>
  <data key="d3">chunk-466f239ae26f543930ce42fb131832cc</data>
  <data key="d4">D:\Academic resources\ARN34839-ATP_3-06.1-000-WEB-1.pdf</data>
  <data key="d5">1778752902</data>
  <data key="d6"></data>
</node>
