  <data key="d0">Weapons Of Mass Destruction Defeat</data>
  <data key="d1">method</data>
  <data key="d2">Weapons of mass destruction defeat refers to operations aimed at neutralizing or destroying existing weapons of mass destruction and means of delivery.</data>
  <data key="d3">chunk-fe9b99ab479688bf15c5eb6b71313a3b</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778759225</data>
  <data key="d6"></data>
</node>
<node id="SOF">
  <data key="d0">SOF</data>
  <data key="d1">organization</data>
  <data key="d2">SOF refers to Special Operations Forces that may accompany irregular forces during unconventional warfare phases.</data>
  <data key="d3">chunk-fe9b99ab479688bf15c5eb6b71313a3b</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778759225</data>
