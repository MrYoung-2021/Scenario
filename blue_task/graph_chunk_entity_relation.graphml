  <data key="d0">Special Operations Directed Activities</data>
  <data key="d1">method</data>
  <data key="d2">Special operations directed activities are methods directed by the President and Secretary of Defense to provide combatant commanders with crisis and emergency options.</data>
  <data key="d3">chunk-fe9b99ab479688bf15c5eb6b71313a3b</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
