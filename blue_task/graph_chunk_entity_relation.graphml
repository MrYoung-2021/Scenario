  <data key="d6"></data>
</node>
<node id="Engagement">
  <data key="d0">Engagement</data>
  <data key="d1">concept</data>
  <data key="d2">An engagement is a tactical conflict, usually between opposing lower echelon maneuver forces.&lt;SEP&gt;Engagement is a task associated with target acquisition in military operations.</data>
