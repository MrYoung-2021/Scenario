</node>
<node id="Al-Qaeda">
  <data key="d0">Al-Qaeda</data>
  <data key="d1">organization</data>
  <data key="d2">Al-Qaeda is linked to terrorist groups such as Abu Sayyaf and Jemaah Islamiyah that were targeted by JSOTF-P.</data>
  <data key="d3">chunk-3f9296b5d072caec55997f55d6e957ea</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
