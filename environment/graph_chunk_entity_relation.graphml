<node id="Changbai Mountain">
  <data key="d0">Changbai Mountain</data>
  <data key="d1">location</data>
  <data key="d2">Changbai Mountain is a specific mountain range cited as a famous anti-japanese base area due to its strategic terrain features.</data>
  <data key="d3">chunk-34a910155a4ca89cef37c9d03aa719e0</data>
  <data key="d4">unknown_source</data>
