</node>
<node id="Force Multiplier">
  <data key="d0">Force Multiplier</data>
  <data key="d1">concept</data>
  <data key="d2">Force Multiplier is a strategic concept representing factors that significantly increase the efficiency or power of a force.</data>
  <data key="d3">chunk-c4b259b146ca33e9a51611e956ec1456</data>
