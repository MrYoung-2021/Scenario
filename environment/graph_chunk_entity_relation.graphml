<node id="Spatial Disorientation">
  <data key="d0">Spatial Disorientation</data>
  <data key="d1">concept</data>
  <data key="d2">Spatial Disorientation is a psychological illusion experienced by pilots flying in clouds, leading to incorrect perceptions of aircraft attitude like inverted flight.</data>
  <data key="d3">chunk-ce0f8847579bcd84ebc6d7ccd5e3df71</data>
  <data key="d4">unknown_source</data>
