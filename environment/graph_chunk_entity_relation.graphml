  <data key="d1">location</data>
  <data key="d2">贺兰山脉位于内蒙古高原西部，是该高原的重要西部边界。</data>
  <data key="d3">chunk-e0902a5c933272b09fcdd85d68e45240</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1779513352</data>
  <data key="d6"></data>
</node>
<node id="秦岭">
  <data key="d0">秦岭</data>
  <data key="d1">location</data>
  <data key="d2">秦岭位于黄土高原南端，构成了黄土高原的南部边界。&lt;SEP&gt;Qinling Mountains serve as a geographical boundary between the Subtropical and Warm Temperate Zones.</data>
  <data key="d3">chunk-e0902a5c933272b09fcdd85d68e45240&lt;SEP&gt;chunk-ce590f9eeb868971ae438f2dabf1c96d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1779513352</data>
  <data key="d6"></data>
</node>
<node id="太行山">
  <data key="d0">太行山</data>
  <data key="d1">location</data>
  <data key="d2">太行山位于黄土高原东端，构成了黄土高原的东部边界。</data>
  <data key="d3">chunk-e0902a5c933272b09fcdd85d68e45240</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1779513352</data>
  <data key="d6"></data>
</node>
<node id="阿尔金山">
