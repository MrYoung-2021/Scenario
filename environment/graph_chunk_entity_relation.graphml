  <data key="d0">Salinity</data>
  <data key="d1">concept</data>
  <data key="d2">Salinity is directly proportional to seawater temperature and density, affecting buoyancy, freezing points, and marine life attachment to vessels.</data>
  <data key="d3">chunk-c80ee723bcf749b452d4339be150476c</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1779513371</data>
