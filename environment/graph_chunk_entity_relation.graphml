<node id="Battle Against Chu">
  <data key="d0">Battle Against Chu</data>
  <data key="d1">event</data>
  <data key="d2">Battle Against Chu is a historical conflict where the Wu State utilized geographical analysis to defeat the Chu State.</data>
  <data key="d3">chunk-34a910155a4ca89cef37c9d03aa719e0</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1779513333</data>
  <data key="d6"></data>
