</node>
<node id="Outer Xing'anling Range">
  <data key="d0">Outer Xing'anling Range</data>
  <data key="d1">location</data>
  <data key="d2">The Outer Xing'anling Range marked the northern boundary of China's territory before the 19th-century territorial losses.</data>
