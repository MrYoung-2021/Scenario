</node>
<node id="Flight Safety">
  <data key="d0">Flight Safety</data>
  <data key="d1">concept</data>
  <data key="d2">Flight Safety encompasses the conditions required to prevent accidents, threatened by turbulence, wind, and typhoons.</data>
  <data key="d3">chunk-ce0f8847579bcd84ebc6d7ccd5e3df71</data>
