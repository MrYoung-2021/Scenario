<node id="Chinese Navy">
  <data key="d0">Chinese Navy</data>
  <data key="d1">organization</data>
  <data key="d2">The Chinese Navy operates mainly in China's sea areas, responsible for guarding the maritime frontier and implementing the offshore defense strategy.</data>
  <data key="d3">chunk-98aa0a6c316255cf19e5c64b2770f024</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1779513340</data>
