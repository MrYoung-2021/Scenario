  <data key="d6"></data>
</node>
<node id="Air Pressure">
  <data key="d0">Air Pressure</data>
  <data key="d1">concept</data>
  <data key="d2">Air Pressure is a meteorological factor influencing the flight mechanics of artillery projectiles.&lt;SEP&gt;Air pressure is a meteorological element that affects wave propagation and weapon ballistics.</data>
  <data key="d3">chunk-1d33148b0d7436f29502a2e094038716&lt;SEP&gt;chunk-04fe3e063b1934b10a4b54c4167a8091</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1779513355</data>
  <data key="d6"></data>
</node>
<node id="Clouds">
  <data key="d0">Clouds</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Atmospheric formations that reduce visibility, cause aircraft icing, and induce turbulence affecting flight safety.&lt;SEP&gt;Clouds are atmospheric formations that contribute to electromagnetic wave absorption and scattering.&lt;SEP&gt;Clouds are atmospheric conditions that scatter and absorb laser beams, interfering with the guidance and visibility required for precision attacks.</data>
  <data key="d3">chunk-1d33148b0d7436f29502a2e094038716&lt;SEP&gt;chunk-b4d7d1f88fe246b51fd0303547d9be8d&lt;SEP&gt;chunk-bbf7b6b975f6c62ad2f6664872c40e85</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1779513355</data>
  <data key="d6"></data>
</node>
<node id="Lightning">
  <data key="d0">Lightning</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Lightning is an atmospheric discharge that can ignite propellants or destroy ground equipment and missiles.&lt;SEP&gt;Lightning is a weather event that causes strong interference to communication links and radio stations.&lt;SEP&gt;A weather phenomenon that could be artificially induced to cause forest fires.</data>
  <data key="d3">chunk-1d33148b0d7436f29502a2e094038716&lt;SEP&gt;chunk-003994fca557bfd14758df9f40939adf&lt;SEP&gt;chunk-172c6a0caad4a353ae3ab389f92c9a74</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1779513355</data>
