  <data key="d0">Destroyer</data>
  <data key="d1">artifact</data>
  <data key="d2">A Destroyer is a naval vessel requiring a sea depth of approximately 5.5 to 8 meters for safe passage.</data>
  <data key="d3">chunk-c80ee723bcf749b452d4339be150476c</data>
