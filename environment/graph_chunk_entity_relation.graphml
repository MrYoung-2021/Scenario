<node id="Jet Engine">
  <data key="d0">Jet Engine</data>
  <data key="d1">artifact</data>
  <data key="d2">The Jet Engine contains turbine compressors where raindrops can enter, causing increased compression ratio and thrust.</data>
  <data key="d3">chunk-4f2d9cecd6bfddf0136042457124e4ff</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1779513346</data>
  <data key="d6"></data>
</node>
<node id="Rain">
  <data key="d0">Rain</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Rain is a weather phenomenon that reduces visibility and can enter jet engine compressors affecting performance.&lt;SEP&gt;Rain is a weather condition that causes signal attenuation and scattering for radar and communication systems.&lt;SEP&gt;Rain is a precipitation form that absorbs and scatters electromagnetic energy, reducing detection capabilities.</data>
  <data key="d3">chunk-4f2d9cecd6bfddf0136042457124e4ff&lt;SEP&gt;chunk-1d33148b0d7436f29502a2e094038716&lt;SEP&gt;chunk-b4d7d1f88fe246b51fd0303547d9be8d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1779513346</data>
  <data key="d6"></data>
</node>
<node id="Cloud">
  <data key="d0">Cloud</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Cloud is a weather formation that contributes to reduced visibility on the battlefield.&lt;SEP&gt;Cloud is a natural object targeted by physical methods to induce lightning, change intensity, or modify precipitation.</data>
  <data key="d3">chunk-4f2d9cecd6bfddf0136042457124e4ff&lt;SEP&gt;chunk-86b3997480c8d2d8abb49b09b2247575</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1779513346</data>
