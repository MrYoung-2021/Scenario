  <data key="d0">US Geostationary Operational 4 Satellite</data>
  <data key="d1">artifact</data>
  <data key="d2">A US operational satellite equipped with scanning radiometers that failed after exposure to high-energy protons from a solar flare in 1982.</data>
  <data key="d3">chunk-543b6633702af343c0b0d5a3a6321a00</data>
