  <data key="d0">Military Science</data>
  <data key="d1">concept</data>
  <data key="d2">Military Science is one of the foundational disciplines upon which Military Meteorology developed.</data>
  <data key="d3">chunk-fc2492438202366534ec0b3b980991e4</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1779513356</data>
  <data key="d6"></data>
</node>
<node id="Meteorology">
  <data key="d0">Meteorology</data>
  <data key="d1">concept</data>
  <data key="d2">Atmospheric conditions and seasonal weather variations influencing visibility and mobility.&lt;SEP&gt;Meteorology is the scientific study of weather and climate, serving as a basis for Military Meteorology.&lt;SEP&gt;Meteorology is the scientific study of weather whose application became crucial for military planning after historical disasters.</data>
  <data key="d3">chunk-fc2492438202366534ec0b3b980991e4&lt;SEP&gt;chunk-7e567fa8fe0d09b8716b7c59ce0c8aaf&lt;SEP&gt;chunk-1f2da0b5a925efce063af9f298932751</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1779513356</data>
