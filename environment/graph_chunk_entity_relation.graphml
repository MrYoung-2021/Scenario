  <data key="d5">1779513341</data>
  <data key="d6"></data>
</node>
<node id="Sakhalin Island">
  <data key="d0">Sakhalin Island</data>
  <data key="d1">location</data>
  <data key="d2">Sakhalin Island was included in China's historical northeastern territory east of the Ussuri River.</data>
  <data key="d3">chunk-98aa0a6c316255cf19e5c64b2770f024</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1779513341</data>
