<node id="Pamir Plateau">
  <data key="d0">Pamir Plateau</data>
  <data key="d1">location</data>
  <data key="d2">The Pamir Plateau is located west of Wuqia County and marks the western boundary of China's territory.&lt;SEP&gt;The Pamir Plateau marked the southern extension of China's western historical boundary.</data>
  <data key="d3">chunk-98aa0a6c316255cf19e5c64b2770f024&lt;SEP&gt;chunk-8838d954c1b9dee27b68282526f5d2fe</data>
  <data key="d4">unknown_source</data>
