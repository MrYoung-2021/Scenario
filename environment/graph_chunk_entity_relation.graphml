<node id="Water Network">
  <data key="d0">Water Network</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Water Network describes the dense system of rivers and streams characterizing the geography of the Chu State region.</data>
  <data key="d3">chunk-34a910155a4ca89cef37c9d03aa719e0</data>
  <data key="d4">unknown_source</data>
