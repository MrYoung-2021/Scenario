  <data key="d0">United Nations</data>
  <data key="d1">organization</data>
  <data key="d2">An example of an intergovernmental organization that coordinates with military forces during civil-military operations.</data>
  <data key="d3">chunk-516fa4bb2c82a8017519f0c1ee450177</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744575</data>
