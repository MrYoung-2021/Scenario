  <data key="d0">82nd Airborne Division</data>
  <data key="d1">organization</data>
  <data key="d2">The 82nd Airborne Division provided 2,700 paratroopers to support Ranger-led airborne operations during Operation Just Cause.</data>
  <data key="d3">chunk-7e2c950368aaaddb9954e21827ca6fc1</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778755283</data>
  <data key="d6"></data>
</node>
<node id="7th Special Forces Group">
  <data key="d0">7th Special Forces Group</data>
  <data key="d1">organization</data>
