  <data key="d0">Civil-Military Operations</data>
  <data key="d1">method</data>
  <data key="d2">Activities performed by designated military forces to establish, maintain, influence, or exploit relations between military forces and indigenous populations and institutions.</data>
  <data key="d3">chunk-516fa4bb2c82a8017519f0c1ee450177</data>
