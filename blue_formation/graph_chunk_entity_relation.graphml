  <data key="d5">1778755277</data>
  <data key="d6"></data>
</node>
<node id="USASOC Staff">
  <data key="d0">USASOC Staff</data>
  <data key="d1">organization</data>
  <data key="d2">Staff elements that coordinate with the Support Operations Section for logistical synchronization.</data>
  <data key="d3">chunk-b27d7d56a1c67174500dfb742aa9fc91</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778755277</data>
  <data key="d6"></data>
</node>
<node id="Special Forces Operational Detachment–Alpha">
  <data key="d0">Special Forces Operational Detachment–Alpha</data>
  <data key="d1">organization</data>
  <data key="d2">The primary Special Forces operational unit consisting of 12 personnel capable of discreet operations in hostile environments.</data>
  <data key="d3">chunk-51979d8934c76925b7391cb149c853a0</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
