</node>
<node id="Leaders">
  <data key="d0">Leaders</data>
  <data key="d1">person</data>
  <data key="d2">Leaders are affected by the effects of battle along with Soldiers, units, and equipment during extended operations.</data>
  <data key="d3">chunk-634019196f631f7ab3b7db7cf3971a9d</data>
