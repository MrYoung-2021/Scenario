</node>
<node id="Armored Ground Maneuver Units">
  <data key="d0">Armored Ground Maneuver Units</data>
  <data key="d1">organization</data>
  <data key="d2">Units such as combined arms battalions that possess good tactical mobility, firepower, and protection.</data>
  <data key="d3">chunk-770e75b09bf3306fb7e43a79786bc058</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744570</data>
