  <data key="d0">Air Defense Airspace Management Element</data>
  <data key="d1">organization</data>
  <data key="d2">An element within a multifunctional support brigade that receives planning and airspace control support from higher echelon headquarters.</data>
  <data key="d3">chunk-03a7d3d9560fe2b56cedf3cfdaba2f4a</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744571</data>
