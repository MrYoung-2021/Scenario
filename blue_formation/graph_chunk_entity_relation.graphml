  <data key="d1">organization</data>
  <data key="d2">A command whose aircraft may operate in division-assigned airspace and receive procedural control from the JAGIC.</data>
  <data key="d3">chunk-03a7d3d9560fe2b56cedf3cfdaba2f4a</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744571</data>
