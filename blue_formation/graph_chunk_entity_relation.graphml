  <data key="d5">1778755302</data>
  <data key="d6"></data>
</node>
<node id="Movement Control">
  <data key="d0">Movement Control</data>
  <data key="d1">method</data>
  <data key="d2">The process of committing allocated transportation assets and regulating movements to synchronize distribution flow and sustain land forces.</data>
  <data key="d3">chunk-516fa4bb2c82a8017519f0c1ee450177</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744575</data>
  <data key="d6"></data>
</node>
<node id="Area Of Operations">
  <data key="d0">Area Of Operations</data>
  <data key="d1">location</data>
  <data key="d2">A defined geographical area assigned to a commander or unit for control, security, and movement regulation.</data>
  <data key="d3">chunk-516fa4bb2c82a8017519f0c1ee450177</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744575</data>
  <data key="d6"></data>
</node>
<node id="Clearance Of Fires">
  <data key="d0">Clearance Of Fires</data>
  <data key="d1">method</data>
  <data key="d2">The process by which a supported commander ensures that fires or their effects will have no unintended consequences on friendly units or the scheme of maneuver.</data>
  <data key="d3">chunk-516fa4bb2c82a8017519f0c1ee450177</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744575</data>
  <data key="d6"></data>
</node>
<node id="Fire Support Coordination Measure">
  <data key="d0">Fire Support Coordination Measure</data>
  <data key="d1">method</data>
  <data key="d2">A measure employed by commanders to facilitate the rapid engagement of targets and simultaneously provide safeguards for friendly forces.</data>
  <data key="d3">chunk-516fa4bb2c82a8017519f0c1ee450177</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744575</data>
  <data key="d6"></data>
</node>
<node id="Targets">
  <data key="d0">Targets</data>
  <data key="d1">location</data>
  <data key="d2">Entities or objects identified for engagement by fires, which fire support coordination measures help to rapidly engage.</data>
  <data key="d3">chunk-516fa4bb2c82a8017519f0c1ee450177</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744575</data>
  <data key="d6"></data>
</node>
<node id="No-fire Area">
  <data key="d0">No-fire Area</data>
  <data key="d1">location</data>
  <data key="d2">A restrictive fire support coordination measure often established around sensitive areas like dislocated civilian camps to prevent firing.</data>
  <data key="d3">chunk-516fa4bb2c82a8017519f0c1ee450177</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744575</data>
  <data key="d6"></data>
</node>
<node id="Coordinated Fire Line">
  <data key="d0">Coordinated Fire Line</data>
  <data key="d1">location</data>
  <data key="d2">A type of permissive fire support coordination measure used to facilitate the engagement of targets.</data>
  <data key="d3">chunk-516fa4bb2c82a8017519f0c1ee450177</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744575</data>
  <data key="d6"></data>
</node>
