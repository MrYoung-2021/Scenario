  <data key="d5">1778755284</data>
  <data key="d6"></data>
</node>
<node id="Rio Hato">
  <data key="d0">Rio Hato</data>
  <data key="d1">location</data>
  <data key="d2">Rio Hato was the location of a PDF garrison assaulted by the 2d and 3d Ranger Battalions.&lt;SEP&gt;Rio Hato is the location of a PDF garrison and airstrip secured by Rangers.</data>
  <data key="d3">chunk-7e2c950368aaaddb9954e21827ca6fc1&lt;SEP&gt;chunk-1c96559ad2979a6465236d374730b783</data>
