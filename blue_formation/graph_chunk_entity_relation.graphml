</node>
<node id="Operation Just Cause">
  <data key="d0">Operation Just Cause</data>
  <data key="d1">event</data>
  <data key="d2">Operation Just Cause was a military operation lasting from 20 December 1989 to 12 January 1990 involving Army special operations forces in Panama.</data>
  <data key="d3">chunk-7e2c950368aaaddb9954e21827ca6fc1</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778755283</data>
  <data key="d6"></data>
</node>
<node id="Operation Promote Liberty">
  <data key="d0">Operation Promote Liberty</data>
  <data key="d1">event</data>
  <data key="d2">Operation Promote Liberty refers to stability operations in Panama following Operation Just Cause.</data>
  <data key="d3">chunk-7e2c950368aaaddb9954e21827ca6fc1</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778755283</data>
  <data key="d6"></data>
</node>
<node id="PDF">
  <data key="d0">PDF</data>
  <data key="d1">organization</data>
  <data key="d2">The PDF is a military force whose soldiers hid among civilian airline passengers and resisted Rangers at Rio Hato.</data>
  <data key="d3">chunk-7e2c950368aaaddb9954e21827ca6fc1</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778755283</data>
  <data key="d6"></data>
</node>
<node id="Rangers">
  <data key="d0">Rangers</data>
  <data key="d1">organization</data>
  <data key="d2">The Rangers conducted airborne operations during Operation Just Cause and secured the base and airstrip at Rio Hato.</data>
  <data key="d3">chunk-7e2c950368aaaddb9954e21827ca6fc1</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778755283</data>
  <data key="d6"></data>
</node>
