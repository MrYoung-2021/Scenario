  <data key="d5">1778755283</data>
  <data key="d6"></data>
</node>
<node id="2d Ranger Battalion">
  <data key="d0">2d Ranger Battalion</data>
  <data key="d1">organization</data>
  <data key="d2">The 2d Ranger Battalion descended onto the PDF garrison at Rio Hato during Operation Just Cause.</data>
  <data key="d3">chunk-7e2c950368aaaddb9954e21827ca6fc1</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778755283</data>
  <data key="d6"></data>
</node>
<node id="3d Ranger Battalion">
  <data key="d0">3d Ranger Battalion</data>
  <data key="d1">organization</data>
  <data key="d2">The 3d Ranger Battalion descended onto the PDF garrison at Rio Hato during Operation Just Cause.</data>
  <data key="d3">chunk-7e2c950368aaaddb9954e21827ca6fc1</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778755283</data>
  <data key="d6"></data>
</node>
