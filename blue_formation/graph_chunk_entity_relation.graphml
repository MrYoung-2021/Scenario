  <data key="d0">Colin S. Gray</data>
  <data key="d1">person</data>
  <data key="d2">Colin S. Gray is quoted regarding the design of special operations to turn enemy strength into weakness.</data>
  <data key="d3">chunk-7e2c950368aaaddb9954e21827ca6fc1</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
