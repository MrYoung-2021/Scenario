  <data key="d0">Combined Military Information Support Operations Component Command</data>
  <data key="d1">organization</data>
  <data key="d2">An example command that Psychological Operations groups may augment.</data>
  <data key="d3">chunk-51979d8934c76925b7391cb149c853a0</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
