</node>
<node id="Indigenous Populations">
  <data key="d0">Indigenous Populations</data>
  <data key="d1">person</data>
  <data key="d2">The local populations within a region or host nation with which military forces establish relations during civil-military operations.</data>
  <data key="d3">chunk-516fa4bb2c82a8017519f0c1ee450177</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744575</data>
  <data key="d6"></data>
</node>
<node id="Host Nation">
  <data key="d0">Host Nation</data>
  <data key="d1">location</data>
  <data key="d2">A nation where military operations are conducted, often the focus of stability objectives in civil-military operations.&lt;SEP&gt;A nation that receives liaison support from special operations forces liaison elements.</data>
  <data key="d3">chunk-516fa4bb2c82a8017519f0c1ee450177&lt;SEP&gt;chunk-b0b01db05e3701dde254ad8d25610798</data>
