  <data key="d0">Division Airspace Element</data>
  <data key="d1">organization</data>
  <data key="d2">An element that checks and adjusts the airspace plan to account for multifunctional support brigade priorities.</data>
  <data key="d3">chunk-03a7d3d9560fe2b56cedf3cfdaba2f4a</data>
