  <data key="d5">1778755291</data>
  <data key="d6"></data>
</node>
<node id="Sergeant">
  <data key="d0">Sergeant</data>
  <data key="d1">person</data>
  <data key="d2">A rank that usually leads a fire team.</data>
  <data key="d3">chunk-b023ae1c5d93443720b726ec81502bff</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744565</data>
  <data key="d6"></data>
</node>
<node id="Staff Sergeant">
  <data key="d0">Staff Sergeant</data>
  <data key="d1">person</data>
  <data key="d2">A rank that usually leads a squad.</data>
  <data key="d3">chunk-b023ae1c5d93443720b726ec81502bff</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744565</data>
  <data key="d6"></data>
</node>
<node id="Soldier">
  <data key="d0">Soldier</data>
  <data key="d1">person</data>
  <data key="d2">An individual member of the Army who comprises units such as fire teams and squads.&lt;SEP&gt;Individuals who are assessed, selected, educated, and trained by the JFK Special Warfare Center to join the operational force.</data>
  <data key="d3">chunk-b023ae1c5d93443720b726ec81502bff&lt;SEP&gt;chunk-1118e47016e1aacd6394fca251ed2dba</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf&lt;SEP&gt;D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778755281</data>
  <data key="d6"></data>
</node>
<node id="Tank">
  <data key="d0">Tank</data>
  <data key="d1">artifact</data>
  <data key="d2">A vehicle system operated by a crew.</data>
  <data key="d3">chunk-b023ae1c5d93443720b726ec81502bff</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744565</data>
  <data key="d6"></data>
</node>
<node id="Leader">
  <data key="d0">Leader</data>
  <data key="d1">person</data>
  <data key="d2">An individual who uses forms of maneuver and forms of defense to elaborate courses of action and schemes of maneuver.</data>
  <data key="d3">chunk-b023ae1c5d93443720b726ec81502bff</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744566</data>
  <data key="d6"></data>
</node>
<node id="Course of Action">
  <data key="d0">Course of Action</data>
  <data key="d1">concept</data>
  <data key="d2">A potential plan (COA) elaborated using forms of maneuver and defense, upon which a commander builds a scheme.</data>
  <data key="d3">chunk-b023ae1c5d93443720b726ec81502bff</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744566</data>
  <data key="d6"></data>
</node>
<node id="Mortar">
  <data key="d0">Mortar</data>
  <data key="d1">artifact</data>
  <data key="d2">A type of weapons system operated by a crew.</data>
  <data key="d3">chunk-b023ae1c5d93443720b726ec81502bff</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744566</data>
  <data key="d6"></data>
</node>
<node id="Machinegun">
  <data key="d0">Machinegun</data>
  <data key="d1">artifact</data>
  <data key="d2">A type of weapons system operated by a crew.</data>
  <data key="d3">chunk-b023ae1c5d93443720b726ec81502bff</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744566</data>
  <data key="d6"></data>
</node>
<node id="Target Acquisition Radar">
  <data key="d0">Target Acquisition Radar</data>
  <data key="d1">artifact</data>
  <data key="d2">A sensor system operated by a crew for identifying targets.</data>
  <data key="d3">chunk-b023ae1c5d93443720b726ec81502bff</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744566</data>
  <data key="d6"></data>
</node>
<node id="ADP 3-0">
  <data key="d0">ADP 3-0</data>
  <data key="d1">content</data>
  <data key="d2">An Army doctrinal publication referenced for information on operational variables, mission variables, and warfighting functions.&lt;SEP&gt;ADP 3-0 is a doctrinal publication referenced for definitions regarding warfighting functions and defeat mechanisms.&lt;SEP&gt;A publication mentioning responsibilities associated with a unit assigned an area of operations, excluding environmental issues.&lt;SEP&gt;An Army doctrine publication referenced as the source for the definition of position of relative advantage.&lt;SEP&gt;A reference document that defines the decisive operation.</data>
  <data key="d3">chunk-b023ae1c5d93443720b726ec81502bff&lt;SEP&gt;chunk-63dfd7a87dfd28f5856896abb13b5c87&lt;SEP&gt;chunk-6e8cfc7a602ac472213d15ef41cf6d81&lt;SEP&gt;chunk-272b00f6d97de5a3de8f78e2d6a7851e&lt;SEP&gt;chunk-43827b67edd15288722ea2a5a3a94f03</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744566</data>
  <data key="d6"></data>
</node>
<node id="ADP 5-0">
  <data key="d0">ADP 5-0</data>
  <data key="d1">content</data>
  <data key="d2">A publication referenced for the definition and additional information on the concept of operations.&lt;SEP&gt;A reference document that discusses command and support relationships.</data>
  <data key="d3">chunk-b023ae1c5d93443720b726ec81502bff&lt;SEP&gt;chunk-43827b67edd15288722ea2a5a3a94f03</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744566</data>
  <data key="d6"></data>
</node>
<node id="FM 3-90-1">
  <data key="d0">FM 3-90-1</data>
  <data key="d1">content</data>
  <data key="d2">A field manual containing detailed information on individual tactical mission tasks.&lt;SEP&gt;A field manual that provides a discussion of the forms of maneuver.</data>
  <data key="d3">chunk-b023ae1c5d93443720b726ec81502bff&lt;SEP&gt;chunk-63dfd7a87dfd28f5856896abb13b5c87</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744566</data>
  <data key="d6"></data>
</node>
<node id="Simultaneity">
  <data key="d0">Simultaneity</data>
  <data key="d1">concept</data>
  <data key="d2">A key component of understanding decisive action and the use of forms of maneuver and defense.</data>
  <data key="d3">chunk-b023ae1c5d93443720b726ec81502bff</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744566</data>
  <data key="d6"></data>
</node>
<node id="Static Force">
  <data key="d0">Static Force</data>
  <data key="d1">organization</data>
  <data key="d2">A unit that conducts a defense of a linear obstacle during a mobile defense.</data>
  <data key="d3">chunk-b023ae1c5d93443720b726ec81502bff</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744566</data>
  <data key="d6"></data>
</node>
<node id="Striking Force">
  <data key="d0">Striking Force</data>
  <data key="d1">organization</data>
  <data key="d2">A unit that executes an envelopment during a mobile defense.</data>
  <data key="d3">chunk-b023ae1c5d93443720b726ec81502bff</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744566</data>
  <data key="d6"></data>
</node>
<node id="Noncommissioned Officer">
  <data key="d0">Noncommissioned Officer</data>
  <data key="d1">person</data>
  <data key="d2">A rank category that includes the senior crewmember for certain systems.</data>
  <data key="d3">chunk-b023ae1c5d93443720b726ec81502bff</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744566</data>
  <data key="d6"></data>
</node>
<node id="Commissioned Officer">
  <data key="d0">Commissioned Officer</data>
  <data key="d1">person</data>
  <data key="d2">A rank category that can include the senior crewmember for certain systems.</data>
  <data key="d3">chunk-b023ae1c5d93443720b726ec81502bff</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744566</data>
  <data key="d6"></data>
</node>
<node id="Warrant Officer">
  <data key="d0">Warrant Officer</data>
  <data key="d1">person</data>
  <data key="d2">A rank category that can include the senior crewmember for certain systems.</data>
  <data key="d3">chunk-b023ae1c5d93443720b726ec81502bff</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744566</data>
  <data key="d6"></data>
</node>
<node id="Common Tactical Concepts">
  <data key="d0">Common Tactical Concepts</data>
  <data key="d1">concept</data>
  <data key="d2">Concepts applied by tacticians alongside military definitions and echelons during offensive and defensive operations.</data>
  <data key="d3">chunk-63dfd7a87dfd28f5856896abb13b5c87</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744566</data>
  <data key="d6"></data>
</node>
<node id="Echelons">
  <data key="d0">Echelons</data>
  <data key="d1">concept</data>
  <data key="d2">Tactical echelons and organizations used by tacticians to conduct operations.</data>
  <data key="d3">chunk-63dfd7a87dfd28f5856896abb13b5c87</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744566</data>
  <data key="d6"></data>
</node>
<node id="Joint Interdependence">
  <data key="d0">Joint Interdependence</data>
  <data key="d1">concept</data>
  <data key="d2">The purposeful reliance by one Service on another Service to complement and reinforce each other's effects.</data>
  <data key="d3">chunk-63dfd7a87dfd28f5856896abb13b5c87</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744566</data>
  <data key="d6"></data>
</node>
<node id="Army Forces">
  <data key="d0">Army Forces</data>
  <data key="d1">organization</data>
  <data key="d2">Military forces that conduct offensive and defensive operations as members of an interdependent joint force.</data>
  <data key="d3">chunk-63dfd7a87dfd28f5856896abb13b5c87</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744566</data>
  <data key="d6"></data>
</node>
<node id="Principles of Joint Operations">
  <data key="d0">Principles of Joint Operations</data>
  <data key="d1">concept</data>
  <data key="d2">Twelve principles originating from Army doctrine that provide general guidance for conducting military operations and link theory to application.</data>
  <data key="d3">chunk-63dfd7a87dfd28f5856896abb13b5c87</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744566</data>
  <data key="d6"></data>
</node>
<node id="Operational Variables">
  <data key="d0">Operational Variables</data>
  <data key="d1">concept</data>
  <data key="d2">Eight interrelated aspects (political, military, economic, social, information, infrastructure, physical environment, and time) used to describe an operational environment.</data>
  <data key="d3">chunk-63dfd7a87dfd28f5856896abb13b5c87</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744566</data>
  <data key="d6"></data>
</node>
<node id="PMESII-PT">
  <data key="d0">PMESII-PT</data>
  <data key="d1">method</data>
  <data key="d2">An acronym for the eight operational variables used to analyze an operational environment: political, military, economic, social, information, infrastructure, physical environment, and time.</data>
  <data key="d3">chunk-63dfd7a87dfd28f5856896abb13b5c87</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744567</data>
  <data key="d6"></data>
</node>
<node id="Army Planners">
  <data key="d0">Army Planners</data>
  <data key="d1">person</data>
  <data key="d2">Individuals who use operational variables to analyze and describe an operational environment.</data>
  <data key="d3">chunk-63dfd7a87dfd28f5856896abb13b5c87</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744567</data>
  <data key="d6"></data>
</node>
<node id="Mission Variables">
  <data key="d0">Mission Variables</data>
  <data key="d1">concept</data>
  <data key="d2">Categories derived from operational variables used by Army leaders during mission analysis to understand the context of their missions.&lt;SEP&gt;Factors that determine the optimal size and mix of capabilities of the forces task-organized under a division headquarters.</data>
  <data key="d3">chunk-63dfd7a87dfd28f5856896abb13b5c87&lt;SEP&gt;chunk-3fc098f3a3543d54bc8f0881ae2eae85</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744567</data>
  <data key="d6"></data>
</node>
<node id="Army Leaders">
  <data key="d0">Army Leaders</data>
  <data key="d1">person</data>
  <data key="d2">Individuals who filter relevant information from operational variables into mission variables and execute the art and science of tactics.</data>
  <data key="d3">chunk-63dfd7a87dfd28f5856896abb13b5c87</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744567</data>
  <data key="d6"></data>
</node>
<node id="Decisive Action">
  <data key="d0">Decisive Action</data>
  <data key="d1">concept</data>
  <data key="d2">A framework consisting of four elements: offense, defense, stability, and defense support of civil authorities.</data>
  <data key="d3">chunk-63dfd7a87dfd28f5856896abb13b5c87</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744567</data>
  <data key="d6"></data>
</node>
<node id="Stability">
  <data key="d0">Stability</data>
  <data key="d1">concept</data>
  <data key="d2">One of the four elements of decisive action, often conducted alongside other elements.&lt;SEP&gt;A condition or objective relating to the reestablishment or maintenance of order within a region or host nation.</data>
  <data key="d3">chunk-63dfd7a87dfd28f5856896abb13b5c87&lt;SEP&gt;chunk-516fa4bb2c82a8017519f0c1ee450177</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744567</data>
  <data key="d6"></data>
</node>
<node id="Defense Support of Civil Authorities">
  <data key="d0">Defense Support of Civil Authorities</data>
  <data key="d1">concept</data>
  <data key="d2">One of the four elements of decisive action.</data>
  <data key="d3">chunk-63dfd7a87dfd28f5856896abb13b5c87</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744567</data>
  <data key="d6"></data>
</node>
<node id="Tactical Mission Tasks">
  <data key="d0">Tactical Mission Tasks</data>
  <data key="d1">concept</data>
  <data key="d2">Tasks that describe both actions and purposes, possessing specific military definitions distinct from common English.</data>
  <data key="d3">chunk-63dfd7a87dfd28f5856896abb13b5c87</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744567</data>
  <data key="d6"></data>
</node>
<node id="Warfighting Functions">
  <data key="d0">Warfighting Functions</data>
  <data key="d1">concept</data>
  <data key="d2">Groups of tasks and systems united by a common purpose that commanders use to accomplish missions and training objectives.</data>
  <data key="d3">chunk-63dfd7a87dfd28f5856896abb13b5c87</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744567</data>
  <data key="d6"></data>
</node>
<node id="JP 3-0">
  <data key="d0">JP 3-0</data>
  <data key="d1">content</data>
  <data key="d2">A joint publication that defines the twelve principles of joint operations and provides guidance for military operations.&lt;SEP&gt;JP 3-0 is a joint publication that established joint functions and provides definitions for areas of influence, interest, and operations.&lt;SEP&gt;A publication defining economy of force.&lt;SEP&gt;A joint publication referenced as the source for the definition of maneuver.&lt;SEP&gt;JP 3-0 is a joint publication referenced regarding the definition of a joint special operations area.</data>
  <data key="d3">chunk-63dfd7a87dfd28f5856896abb13b5c87&lt;SEP&gt;chunk-6e8cfc7a602ac472213d15ef41cf6d81&lt;SEP&gt;chunk-272b00f6d97de5a3de8f78e2d6a7851e&lt;SEP&gt;chunk-43827b67edd15288722ea2a5a3a94f03&lt;SEP&gt;chunk-89c2c3d76fec30a58c9326c2f2fbff67</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf&lt;SEP&gt;D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778755289</data>
  <data key="d6"></data>
</node>
<node id="Field Service Regulations United States Army">
  <data key="d0">Field Service Regulations United States Army</data>
  <data key="d1">content</data>
  <data key="d2">A publication from 1923 where the principles of war (now joint principles) were first published in America.</data>
  <data key="d3">chunk-63dfd7a87dfd28f5856896abb13b5c87</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744567</data>
  <data key="d6"></data>
</node>
<node id="Tacticians">
  <data key="d0">Tacticians</data>
  <data key="d1">person</data>
  <data key="d2">Individuals who apply common tactical concepts, military definitions, and echelons to conduct offensive and defensive operations.</data>
  <data key="d3">chunk-63dfd7a87dfd28f5856896abb13b5c87</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744567</data>
  <data key="d6"></data>
</node>
<node id="Army Doctrinal Hierarchy">
  <data key="d0">Army Doctrinal Hierarchy</data>
  <data key="d1">concept</data>
  <data key="d2">A framework introduced in the publication that organizes the content, subordinate publications, warfighting functions, and defeat mechanisms.</data>
  <data key="d3">chunk-63dfd7a87dfd28f5856896abb13b5c87</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744567</data>
  <data key="d6"></data>
</node>
<node id="Defeat Mechanisms">
  <data key="d0">Defeat Mechanisms</data>
  <data key="d1">concept</data>
  <data key="d2">Mechanisms organized within the Army doctrinal hierarchy, mentioned alongside warfighting functions.</data>
  <data key="d3">chunk-63dfd7a87dfd28f5856896abb13b5c87</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744567</data>
  <data key="d6"></data>
</node>
<node id="Military Decision-Making Process">
  <data key="d0">Military Decision-Making Process</data>
  <data key="d1">method</data>
  <data key="d2">A critical process during which the analysis of mission variables is conducted.</data>
  <data key="d3">chunk-63dfd7a87dfd28f5856896abb13b5c87</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744567</data>
  <data key="d6"></data>
</node>
<node id="Unified Action">
  <data key="d0">Unified Action</data>
  <data key="d1">concept</data>
  <data key="d2">The operational context in which Army forces apply land power as members of an interdependent joint force.&lt;SEP&gt;Unified Action is supported by a special operations joint task force for special operations conducted in support of a campaign.</data>
  <data key="d3">chunk-63dfd7a87dfd28f5856896abb13b5c87&lt;SEP&gt;chunk-89c2c3d76fec30a58c9326c2f2fbff67</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf&lt;SEP&gt;D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778755291</data>
  <data key="d6"></data>
</node>
<node id="Figure 2-1">
  <data key="d0">Figure 2-1</data>
  <data key="d1">content</data>
  <data key="d2">A figure illustrating the taxonomy of the Army’s tactical doctrine for the four elements of decisive action and tactical mission tasks.</data>
  <data key="d3">chunk-63dfd7a87dfd28f5856896abb13b5c87</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744567</data>
  <data key="d6"></data>
</node>
<node id="JP-1">
  <data key="d0">JP-1</data>
  <data key="d1">content</data>
  <data key="d2">A joint publication referenced for additional information on joint interdependence.</data>
  <data key="d3">chunk-63dfd7a87dfd28f5856896abb13b5c87</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744567</data>
  <data key="d6"></data>
</node>
<node id="Large-Scale Combat Operations">
  <data key="d0">Large-Scale Combat Operations</data>
  <data key="d1">event</data>
  <data key="d2">A type of operation during which units performing close combat are unlikely to conduct stability tasks.</data>
  <data key="d3">chunk-63dfd7a87dfd28f5856896abb13b5c87</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744567</data>
  <data key="d6"></data>
</node>
<node id="Economy Of Force">
  <data key="d0">Economy Of Force</data>
  <data key="d1">concept</data>
  <data key="d2">A principle of war where commanders employ measures to expend minimum essential combat power on shaping operations to support the decisive operation.</data>
  <data key="d3">chunk-6e8cfc7a602ac472213d15ef41cf6d81</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744567</data>
  <data key="d6"></data>
</node>
<node id="Combat Power">
  <data key="d0">Combat Power</data>
  <data key="d1">concept</data>
  <data key="d2">Combat power consists of warfighting functions, leadership, and information, used by commanders to accomplish missions.&lt;SEP&gt;Power generated by a force, which can be concentrated overwhelmingly against separate enemy elements in defeat in detail.&lt;SEP&gt;The military capability that commanders manage, expending minimum amounts on shaping operations to provide maximum power for decisive operations.&lt;SEP&gt;Combat power is concentrated on enemy vulnerabilities and demonstrated through the rapid reaction of the regiment.</data>
  <data key="d3">chunk-6e8cfc7a602ac472213d15ef41cf6d81&lt;SEP&gt;chunk-272b00f6d97de5a3de8f78e2d6a7851e&lt;SEP&gt;chunk-43827b67edd15288722ea2a5a3a94f03&lt;SEP&gt;chunk-634019196f631f7ab3b7db7cf3971a9d</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf&lt;SEP&gt;D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778755294</data>
  <data key="d6"></data>
</node>
<node id="Encirclement Operations">
  <data key="d0">Encirclement Operations</data>
  <data key="d1">method</data>
  <data key="d2">Operations where a force loses freedom of maneuver because an opposing force isolates it by controlling all ground lines of communications.&lt;SEP&gt;Military operations where a force loses freedom of maneuver because an opposing force isolates it by controlling all ground lines of communication.</data>
  <data key="d3">chunk-6e8cfc7a602ac472213d15ef41cf6d81&lt;SEP&gt;chunk-43827b67edd15288722ea2a5a3a94f03</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744567</data>
  <data key="d6"></data>
</node>
<node id="Engagement Area">
  <data key="d0">Engagement Area</data>
  <data key="d1">location</data>
  <data key="d2">A designated area where a commander intends to contain and destroy an enemy force with the massed effects of all available weapons.</data>
  <data key="d3">chunk-6e8cfc7a602ac472213d15ef41cf6d81</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744567</data>
  <data key="d6"></data>
</node>
<node id="Flank">
  <data key="d0">Flank</data>
  <data key="d1">concept</data>
  <data key="d2">The right or left limit of a unit, designated by enemy location for stationary units or direction of movement for moving units.</data>
  <data key="d3">chunk-6e8cfc7a602ac472213d15ef41cf6d81</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744567</data>
  <data key="d6"></data>
</node>
<node id="Assailable Flank">
  <data key="d0">Assailable Flank</data>
  <data key="d1">concept</data>
  <data key="d2">A flank exposed to attack or envelopment due to terrain, force weakness, technical capability of an opponent, or gaps between units.</data>
  <data key="d3">chunk-6e8cfc7a602ac472213d15ef41cf6d81</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744568</data>
  <data key="d6"></data>
</node>
<node id="Flanking Position">
  <data key="d0">Flanking Position</data>
  <data key="d1">location</data>
  <data key="d2">A geographical location on the flank of a force from which effective fires can be placed on that flank.</data>
  <data key="d3">chunk-6e8cfc7a602ac472213d15ef41cf6d81</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744568</data>
  <data key="d6"></data>
</node>
<node id="Forms Of Contact">
  <data key="d0">Forms Of Contact</data>
  <data key="d1">concept</data>
  <data key="d2">The eight categories of military contact: visual, direct, indirect, non-hostile, obstacles, aircraft, CBRN, and electronic.</data>
  <data key="d3">chunk-6e8cfc7a602ac472213d15ef41cf6d81</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744568</data>
  <data key="d6"></data>
</node>
<node id="Local Security">
  <data key="d0">Local Security</data>
  <data key="d1">method</data>
  <data key="d2">Low-level security activities conducted near a unit to prevent surprise by the enemy and provide immediate protection.</data>
  <data key="d3">chunk-6e8cfc7a602ac472213d15ef41cf6d81</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744568</data>
  <data key="d6"></data>
</node>
<node id="Position Of Advantage">
  <data key="d0">Position Of Advantage</data>
  <data key="d1">concept</data>
  <data key="d2">A location or favorable condition within the area of operations providing temporary freedom of action to enhance combat power over an enemy.</data>
  <data key="d3">chunk-6e8cfc7a602ac472213d15ef41cf6d81</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744568</data>
  <data key="d6"></data>
</node>
<node id="Enemy Force">
  <data key="d0">Enemy Force</data>
  <data key="d1">organization</data>
  <data key="d2">The opposing military entity that friendly forces seek to destroy, isolate, or gain advantage over during operations.</data>
  <data key="d3">chunk-6e8cfc7a602ac472213d15ef41cf6d81</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744568</data>
  <data key="d6"></data>
</node>
<node id="FM 3-90-2">
  <data key="d0">FM 3-90-2</data>
  <data key="d1">content</data>
  <data key="d2">A field manual referenced for further information on encirclement operations.</data>
  <data key="d3">chunk-6e8cfc7a602ac472213d15ef41cf6d81</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744568</data>
  <data key="d6"></data>
</node>
<node id="Ground Lines Of Communication">
  <data key="d0">Ground Lines Of Communication</data>
  <data key="d1">concept</data>
  <data key="d2">Routes used for supply and reinforcement, the control of which allows a force to isolate an opponent during encirclement operations.</data>
  <data key="d3">chunk-6e8cfc7a602ac472213d15ef41cf6d81</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744568</data>
  <data key="d6"></data>
</node>
<node id="Direct Fire">
  <data key="d0">Direct Fire</data>
  <data key="d1">method</data>
  <data key="d2">Fire activities inherent in maneuver and close combat.&lt;SEP&gt;Gunfire directed at a target visible to the aimer, which a unit cannot concentrate as effectively on its flanks as it can to the front.</data>
  <data key="d3">chunk-6e8cfc7a602ac472213d15ef41cf6d81&lt;SEP&gt;chunk-272b00f6d97de5a3de8f78e2d6a7851e</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744568</data>
  <data key="d6"></data>
</node>
<node id="CBRN">
  <data key="d0">CBRN</data>
  <data key="d1">concept</data>
  <data key="d2">Chemical, biological, radiological, and nuclear warfare, identified as one of the eight forms of contact.</data>
  <data key="d3">chunk-6e8cfc7a602ac472213d15ef41cf6d81</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744568</data>
  <data key="d6"></data>
</node>
<node id="Electronic Contact">
  <data key="d0">Electronic Contact</data>
  <data key="d1">event</data>
  <data key="d2">A form of contact that includes contact in cyberspace.</data>
  <data key="d3">chunk-6e8cfc7a602ac472213d15ef41cf6d81</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744568</data>
  <data key="d6"></data>
</node>
<node id="Cyberspace">
  <data key="d0">Cyberspace</data>
  <data key="d1">concept</data>
  <data key="d2">A domain within the information environment where electronic contact can occur.&lt;SEP&gt;Digital domain used as a means for disseminating psychological operations products.</data>
  <data key="d3">chunk-6e8cfc7a602ac472213d15ef41cf6d81&lt;SEP&gt;chunk-a83d27ea86b67140cb6a36139ae1786c</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf&lt;SEP&gt;D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778755313</data>
  <data key="d6"></data>
</node>
<node id="Stability Tasks">
  <data key="d0">Stability Tasks</data>
  <data key="d1">method</data>
  <data key="d2">Stability tasks are activities that units are unlikely to conduct if they are also performing close combat in large-scale combat operations.</data>
  <data key="d3">chunk-272b00f6d97de5a3de8f78e2d6a7851e</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744568</data>
  <data key="d6"></data>
</node>
<node id="Warfighting Function">
  <data key="d0">Warfighting Function</data>
  <data key="d1">concept</data>
  <data key="d2">A warfighting function is a group of tasks and systems united by a common purpose that commanders use to accomplish missions and training objectives.&lt;SEP&gt;A Warfighting Function is a capability that alone does not generate sufficient power to prevail, requiring integration via combined arms.</data>
  <data key="d3">chunk-272b00f6d97de5a3de8f78e2d6a7851e&lt;SEP&gt;chunk-43827b67edd15288722ea2a5a3a94f03</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744568</data>
  <data key="d6"></data>
</node>
<node id="Command and Control Warfighting Function">
  <data key="d0">Command and Control Warfighting Function</data>
  <data key="d1">concept</data>
  <data key="d2">The command and control warfighting function consists of related tasks and systems that enable commanders to synchronize and converge all elements of combat power.</data>
  <data key="d3">chunk-272b00f6d97de5a3de8f78e2d6a7851e</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744568</data>
  <data key="d6"></data>
</node>
<node id="Movement and Maneuver Warfighting Function">
  <data key="d0">Movement and Maneuver Warfighting Function</data>
  <data key="d1">concept</data>
  <data key="d2">The movement and maneuver warfighting function involves related tasks and systems that move and employ forces to achieve a position of relative advantage over the enemy.</data>
  <data key="d3">chunk-272b00f6d97de5a3de8f78e2d6a7851e</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744568</data>
  <data key="d6"></data>
</node>
<node id="Intelligence Warfighting Function">
  <data key="d0">Intelligence Warfighting Function</data>
  <data key="d1">concept</data>
  <data key="d2">The intelligence warfighting function comprises related tasks and systems that facilitate understanding the enemy, terrain, weather, and civil considerations.</data>
  <data key="d3">chunk-272b00f6d97de5a3de8f78e2d6a7851e&lt;SEP&gt;chunk-1a7610865bc56fc73c1989a23548f347</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744568</data>
  <data key="d6"></data>
</node>
<node id="Fires Warfighting Function">
  <data key="d0">Fires Warfighting Function</data>
  <data key="d1">concept</data>
  <data key="d2">The fires warfighting function includes related tasks and systems that create and converge effects in all domains against the adversary.</data>
  <data key="d3">chunk-272b00f6d97de5a3de8f78e2d6a7851e</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744568</data>
  <data key="d6"></data>
</node>
<node id="Sustainment Warfighting Function">
  <data key="d0">Sustainment Warfighting Function</data>
  <data key="d1">concept</data>
  <data key="d2">The sustainment warfighting function consists of related tasks and systems that provide support and services to ensure freedom of action and extend operational reach.</data>
  <data key="d3">chunk-272b00f6d97de5a3de8f78e2d6a7851e</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744568</data>
  <data key="d6"></data>
</node>
<node id="Protection Warfighting Function">
  <data key="d0">Protection Warfighting Function</data>
  <data key="d1">concept</data>
  <data key="d2">The protection warfighting function involves related tasks and systems that preserve the force so the commander can apply maximum combat power.</data>
  <data key="d3">chunk-272b00f6d97de5a3de8f78e2d6a7851e</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744568</data>
  <data key="d6"></data>
</node>
<node id="Leadership">
  <data key="d0">Leadership</data>
  <data key="d1">concept</data>
  <data key="d2">Leadership is an element of combat power alongside warfighting functions and information.</data>
  <data key="d3">chunk-272b00f6d97de5a3de8f78e2d6a7851e</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744568</data>
  <data key="d6"></data>
</node>
<node id="Information">
  <data key="d0">Information</data>
  <data key="d1">concept</data>
  <data key="d2">Information is an element of combat power alongside warfighting functions and leadership.</data>
  <data key="d3">chunk-272b00f6d97de5a3de8f78e2d6a7851e</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744568</data>
  <data key="d6"></data>
</node>
<node id="Defeat Mechanism">
  <data key="d0">Defeat Mechanism</data>
  <data key="d1">method</data>
  <data key="d2">A defeat mechanism is a method through which friendly forces accomplish their mission against enemy opposition.</data>
  <data key="d3">chunk-272b00f6d97de5a3de8f78e2d6a7851e</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744569</data>
  <data key="d6"></data>
</node>
<node id="Destroy">
  <data key="d0">Destroy</data>
  <data key="d1">method</data>
  <data key="d2">Destroy is one of the four defeat mechanisms used by tactical forces.</data>
  <data key="d3">chunk-272b00f6d97de5a3de8f78e2d6a7851e</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744569</data>
  <data key="d6"></data>
</node>
<node id="Dislocate">
  <data key="d0">Dislocate</data>
  <data key="d1">method</data>
  <data key="d2">Dislocate is one of the four defeat mechanisms used by tactical forces.</data>
  <data key="d3">chunk-272b00f6d97de5a3de8f78e2d6a7851e</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744569</data>
  <data key="d6"></data>
</node>
<node id="Disintegrate">
  <data key="d0">Disintegrate</data>
  <data key="d1">method</data>
  <data key="d2">Disintegrate is one of the four defeat mechanisms used by tactical forces.</data>
  <data key="d3">chunk-272b00f6d97de5a3de8f78e2d6a7851e</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744569</data>
  <data key="d6"></data>
</node>
<node id="Isolate">
  <data key="d0">Isolate</data>
  <data key="d1">method</data>
  <data key="d2">Isolate is one of the four defeat mechanisms used by tactical forces.</data>
  <data key="d3">chunk-272b00f6d97de5a3de8f78e2d6a7851e</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744569</data>
  <data key="d6"></data>
</node>
<node id="Stability Mechanisms">
  <data key="d0">Stability Mechanisms</data>
  <data key="d1">method</data>
  <data key="d2">Stability mechanisms are methods used in the conduct of stability operations.</data>
  <data key="d3">chunk-272b00f6d97de5a3de8f78e2d6a7851e</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744569</data>
  <data key="d6"></data>
</node>
<node id="Area of Influence">
  <data key="d0">Area of Influence</data>
  <data key="d1">location</data>
  <data key="d2">An area of influence is a geographical area wherein a commander is directly capable of influencing operations by maneuver or fire support.</data>
  <data key="d3">chunk-272b00f6d97de5a3de8f78e2d6a7851e</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744569</data>
  <data key="d6"></data>
</node>
<node id="Area of Interest">
  <data key="d0">Area of Interest</data>
  <data key="d1">location</data>
  <data key="d2">An area of interest is an area of concern to the commander, including the area of influence and areas adjacent thereto, extending into enemy territory.</data>
  <data key="d3">chunk-272b00f6d97de5a3de8f78e2d6a7851e</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744569</data>
  <data key="d6"></data>
</node>
<node id="Joint Functions">
  <data key="d0">Joint Functions</data>
  <data key="d1">concept</data>
  <data key="d2">Functions established in JP 3-0 to which Army warfighting functions are linked.</data>
  <data key="d3">chunk-272b00f6d97de5a3de8f78e2d6a7851e</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744569</data>
  <data key="d6"></data>
</node>
<node id="Tactical Forces">
  <data key="d0">Tactical Forces</data>
  <data key="d1">organization</data>
  <data key="d2">Forces at all echelons that use combinations of defeat mechanisms against enemy opposition.</data>
  <data key="d3">chunk-272b00f6d97de5a3de8f78e2d6a7851e</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744569</data>
  <data key="d6"></data>
</node>
<node id="Friendly Forces">
  <data key="d0">Friendly Forces</data>
  <data key="d1">organization</data>
  <data key="d2">Military units belonging to one's own side or allies, which security and fire support measures aim to protect.&lt;SEP&gt;Forces that accomplish their mission against enemy opposition using defeat mechanisms.</data>
  <data key="d3">chunk-272b00f6d97de5a3de8f78e2d6a7851e&lt;SEP&gt;chunk-516fa4bb2c82a8017519f0c1ee450177</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744569</data>
  <data key="d6"></data>
</node>
<node id="Close Combat">
  <data key="d0">Close Combat</data>
  <data key="d1">event</data>
  <data key="d2">Combat activities inherent in maneuver, involving direct fire, which units are unlikely to conduct alongside stability tasks.</data>
  <data key="d3">chunk-272b00f6d97de5a3de8f78e2d6a7851e</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744569</data>
  <data key="d6"></data>
</node>
<node id="Operational Environment">
  <data key="d0">Operational Environment</data>
  <data key="d1">concept</data>
  <data key="d2">The environment comprising enemy, terrain, weather, and civil considerations that the intelligence warfighting function facilitates understanding of.</data>
  <data key="d3">chunk-272b00f6d97de5a3de8f78e2d6a7851e</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744569</data>
  <data key="d6"></data>
</node>
<node id="Terrain">
  <data key="d0">Terrain</data>
  <data key="d1">naturalobject</data>
  <data key="d2">A physical aspect of the operational environment understood through the intelligence warfighting function.&lt;SEP&gt;A physical factor that affects cross-country mobility, supporting range, and the tactical mobility of different unit types.</data>
  <data key="d3">chunk-272b00f6d97de5a3de8f78e2d6a7851e&lt;SEP&gt;chunk-770e75b09bf3306fb7e43a79786bc058</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744569</data>
  <data key="d6"></data>
</node>
<node id="Weather">
  <data key="d0">Weather</data>
  <data key="d1">naturalobject</data>
  <data key="d2">A physical aspect of the operational environment understood through the intelligence warfighting function.&lt;SEP&gt;An environmental factor that affects cross-country mobility and can restrict the mobility of Army aviation units.</data>
  <data key="d3">chunk-272b00f6d97de5a3de8f78e2d6a7851e&lt;SEP&gt;chunk-770e75b09bf3306fb7e43a79786bc058</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744569</data>
  <data key="d6"></data>
</node>
<node id="Civil Considerations">
  <data key="d0">Civil Considerations</data>
  <data key="d1">concept</data>
  <data key="d2">Aspects of the operational environment understood through the intelligence warfighting function.</data>
  <data key="d3">chunk-272b00f6d97de5a3de8f78e2d6a7851e</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744569</data>
  <data key="d6"></data>
</node>
<node id="Domain">
  <data key="d0">Domain</data>
  <data key="d1">concept</data>
  <data key="d2">Realms or dimensions across which the fires warfighting function creates and converges effects.</data>
  <data key="d3">chunk-272b00f6d97de5a3de8f78e2d6a7851e</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744569</data>
  <data key="d6"></data>
</node>
<node id="Joint Force Land Component Commander">
  <data key="d0">Joint Force Land Component Commander</data>
  <data key="d1">person</data>
  <data key="d2">A commander who assigns subordinate Areas of Operations for land and maritime forces.&lt;SEP&gt;A commander under whom a division normally operates with operational control.</data>
  <data key="d3">chunk-272b00f6d97de5a3de8f78e2d6a7851e&lt;SEP&gt;chunk-3fc098f3a3543d54bc8f0881ae2eae85</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744569</data>
  <data key="d6"></data>
</node>
<node id="Army Service Component Command Commander">
  <data key="d0">Army Service Component Command Commander</data>
  <data key="d1">person</data>
  <data key="d2">A commander who assigns subordinate Areas of Operations.</data>
  <data key="d3">chunk-272b00f6d97de5a3de8f78e2d6a7851e</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744569</data>
  <data key="d6"></data>
</node>
<node id="Army Forces Commander">
  <data key="d0">Army Forces Commander</data>
  <data key="d1">person</data>
  <data key="d2">A commander who assigns subordinate Areas of Operations.</data>
  <data key="d3">chunk-272b00f6d97de5a3de8f78e2d6a7851e</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744569</data>
  <data key="d6"></data>
</node>
<node id="Higher Echelons">
  <data key="d0">Higher Echelons</data>
  <data key="d1">organization</data>
  <data key="d2">Command levels that provide support for regeneration processes.</data>
  <data key="d3">chunk-770e75b09bf3306fb7e43a79786bc058</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744569</data>
  <data key="d6"></data>
</node>
<node id="Reserve">
  <data key="d0">Reserve</data>
  <data key="d1">concept</data>
  <data key="d2">An uncommitted force withheld from action at the beginning of an engagement to be available for decisive movement.</data>
  <data key="d3">chunk-770e75b09bf3306fb7e43a79786bc058</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744569</data>
  <data key="d6"></data>
</node>
<node id="Rules of Engagement">
  <data key="d0">Rules of Engagement</data>
  <data key="d1">concept</data>
  <data key="d2">Directives issued by competent military authority that delineate circumstances and limitations for initiating or continuing combat engagement.</data>
  <data key="d3">chunk-770e75b09bf3306fb7e43a79786bc058</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744570</data>
  <data key="d6"></data>
</node>
<node id="Joint Chiefs of Staff">
  <data key="d0">Joint Chiefs of Staff</data>
  <data key="d1">organization</data>
  <data key="d2">The body that has established standing rules of engagement.</data>
  <data key="d3">chunk-770e75b09bf3306fb7e43a79786bc058</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744570</data>
  <data key="d6"></data>
</node>
<node id="Standing Rules of Engagement">
  <data key="d0">Standing Rules of Engagement</data>
  <data key="d1">content</data>
  <data key="d2">Established rules of engagement set by the Joint Chiefs of Staff, which operational-level commanders can modify.</data>
  <data key="d3">chunk-770e75b09bf3306fb7e43a79786bc058</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744570</data>
  <data key="d6"></data>
</node>
<node id="Unit Self-Defense">
  <data key="d0">Unit Self-Defense</data>
  <data key="d1">method</data>
  <data key="d2">The inherent right and obligation of unit commanders to exercise defense in response to a hostile act or intent.</data>
  <data key="d3">chunk-770e75b09bf3306fb7e43a79786bc058</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
  <data key="d5">1778744570</data>
  <data key="d6"></data>
</node>
<node id="Tactical Mobility">
  <data key="d0">Tactical Mobility</data>
  <data key="d1">concept</data>
  <data key="d2">The ability of friendly forces to move and maneuver freely on the battlefield relative to the enemy.</data>
  <data key="d3">chunk-770e75b09bf3306fb7e43a79786bc058</data>
  <data key="d4">D:\Academic resources\ARN34828-ADP_3-90-000-WEB-1.pdf</data>
