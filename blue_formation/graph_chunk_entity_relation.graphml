</node>
<node id="Torrijos-Tocumen Airfield">
  <data key="d0">Torrijos-Tocumen Airfield</data>
  <data key="d1">location</data>
  <data key="d2">Torrijos-Tocumen Airfield was a location where Soldiers jumped to provide tactical loudspeaker support.</data>
  <data key="d3">chunk-7e2c950368aaaddb9954e21827ca6fc1</data>
