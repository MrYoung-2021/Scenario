  <data key="d6"></data>
</node>
<node id="Information Environment">
  <data key="d0">Information Environment</data>
  <data key="d1">concept</data>
  <data key="d2">The domain in which Psychological Operations groups plan and execute influence activities and operations.&lt;SEP&gt;The environment where Psychological Operations units execute operations and influence activities.&lt;SEP&gt;The Information Environment is the domain where Psychological Operations units lead operations.&lt;SEP&gt;The information environment is the domain where Psychological Operations units lead operations for Army and joint force commanders.</data>
  <data key="d3">chunk-51979d8934c76925b7391cb149c853a0&lt;SEP&gt;chunk-7124d28a5494b25065ecde8dbfca305b&lt;SEP&gt;chunk-b2ba37bc0e16b243f02ab5b7be2e100c&lt;SEP&gt;chunk-a83d27ea86b67140cb6a36139ae1786c</data>
