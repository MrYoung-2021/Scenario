  <data key="d5">1778755284</data>
  <data key="d6"></data>
</node>
<node id="Fort Cimmaron">
  <data key="d0">Fort Cimmaron</data>
  <data key="d1">location</data>
  <data key="d2">Fort Cimmaron housed a PDF garrison located near the Pacora River Bridge.</data>
  <data key="d3">chunk-7e2c950368aaaddb9954e21827ca6fc1</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778755284</data>
  <data key="d6"></data>
</node>
<node id="Pacora River Bridge">
  <data key="d0">Pacora River Bridge</data>
  <data key="d1">location</data>
  <data key="d2">The Pacora River Bridge lay between the PDF garrison at Fort Cimmaron and the Torrijos-Tocumen Airfield.</data>
  <data key="d3">chunk-7e2c950368aaaddb9954e21827ca6fc1</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778755284</data>
  <data key="d6"></data>
</node>
<node id="Howard Air Force Base">
  <data key="d0">Howard Air Force Base</data>
  <data key="d1">location</data>
  <data key="d2">Howard Air Force Base hosted a forward arming and refueling point supported by the 528th Special Operations Support Battalion.</data>
  <data key="d3">chunk-7e2c950368aaaddb9954e21827ca6fc1</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778755284</data>
  <data key="d6"></data>
</node>
<node id="Panama">
  <data key="d0">Panama</data>
  <data key="d1">location</data>
  <data key="d2">Panama is the country where Operation JUST CAUSE took place and where the Panama Canal is located.&lt;SEP&gt;Panama is the country where Operation Just Cause and Operation Promote Liberty took place.</data>
  <data key="d3">chunk-7e2c950368aaaddb9954e21827ca6fc1&lt;SEP&gt;chunk-1c96559ad2979a6465236d374730b783</data>
