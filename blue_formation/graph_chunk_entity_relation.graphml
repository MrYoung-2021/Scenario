  <data key="d0">United States Army Civil Affairs and Psychological Operations Command</data>
  <data key="d1">organization</data>
  <data key="d2">A command under United States Army Reserve Command assigning two Reserve Component Psychological Operations groups.</data>
  <data key="d3">chunk-51979d8934c76925b7391cb149c853a0</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778755277</data>
