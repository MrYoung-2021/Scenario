  <data key="d5">1778755277</data>
  <data key="d6"></data>
</node>
<node id="Special Forces Units">
  <data key="d0">Special Forces Units</data>
  <data key="d1">organization</data>
  <data key="d2">Organizations providing commanders with unique options for crises falling between diplomatic initiatives and conventional force use.</data>
  <data key="d3">chunk-51979d8934c76925b7391cb149c853a0</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778755277</data>
  <data key="d6"></data>
</node>
<node id="Psychological Operations Groups">
  <data key="d0">Psychological Operations Groups</data>
  <data key="d1">organization</data>
  <data key="d2">The highest echelon within the Psychological Operations organizational structure responsible for influence activities.</data>
  <data key="d3">chunk-51979d8934c76925b7391cb149c853a0</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778755277</data>
  <data key="d6"></data>
</node>
<node id="Psychological Operations Battalion">
  <data key="d0">Psychological Operations Battalion</data>
  <data key="d1">organization</data>
  <data key="d2">A subordinate unit within a Psychological Operations group focusing on operational level objectives.&lt;SEP&gt;Plans, prepares, executes, and assesses influence activities and operations in the information environment to achieve operational level objectives.</data>
  <data key="d3">chunk-51979d8934c76925b7391cb149c853a0&lt;SEP&gt;chunk-a83d27ea86b67140cb6a36139ae1786c</data>
  <data key="d4">D:\Academic resources\ARN44116-FM_3-05-000-WEB-1.pdf</data>
  <data key="d5">1778755277</data>
  <data key="d6"></data>
</node>
