  <data key="d5">1778755277</data>
  <data key="d6"></data>
</node>
<node id="Liaison Elements">
  <data key="d0">Liaison Elements</data>
  <data key="d1">organization</data>
  <data key="d2">Elements that coordinate with the Support Operations Section to provide a global logistical common operating picture.&lt;SEP&gt;Liaison Elements are key to the effectiveness of established command and support relationships.</data>
  <data key="d3">chunk-b27d7d56a1c67174500dfb742aa9fc91&lt;SEP&gt;chunk-89c2c3d76fec30a58c9326c2f2fbff67</data>
