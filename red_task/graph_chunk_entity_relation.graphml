</node>
<node id="Implied Mission">
  <data key="d0">Implied Mission</data>
  <data key="d1">concept</data>
  <data key="d2">Implied missions are tasks that must be accomplished to complete the explicit mission but are not specifically stated.</data>
  <data key="d3">chunk-38e9493e7a7348c2d48edb6be9c328ba</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766757</data>
