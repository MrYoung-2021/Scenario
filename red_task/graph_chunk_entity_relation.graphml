  <data key="d0">Commanders Intent</data>
  <data key="d1">concept</data>
  <data key="d2">Commanders intent is the commander's expression of purpose and desired end state for an operation.</data>
  <data key="d3">chunk-38e9493e7a7348c2d48edb6be9c328ba</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766757</data>
