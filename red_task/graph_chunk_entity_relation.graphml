  <data key="d0">Progressive Effect</data>
  <data key="d1">concept</data>
  <data key="d2">Progressive effect refers to the推进性attribute used to evaluate battle nodes, indicating their role in advancing campaign tasks.</data>
  <data key="d3">chunk-89c2553983e206a8e297fe9cdac66169</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766690</data>
  <data key="d6"></data>
</node>
