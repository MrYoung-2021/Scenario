  <data key="d0">Decisive Effect</data>
  <data key="d1">concept</data>
  <data key="d2">Decisive effect refers to the决定性attribute used to evaluate battle nodes, indicating their role in determining campaign outcomes.</data>
  <data key="d3">chunk-89c2553983e206a8e297fe9cdac66169</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766690</data>
  <data key="d6"></data>
</node>
<node id="Force Requirements">
  <data key="d0">Force Requirements</data>
  <data key="d1">concept</data>
  <data key="d2">Force requirements refer to the military force needs submitted based on combat objectives, expected posture, and combat effect requirements.</data>
