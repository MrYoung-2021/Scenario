  <data key="d1">concept</data>
  <data key="d2">High-Value Target refers to targets with high value or high return identified through analysis of enemy combat plan decomposition, whose value changes during operation implementation.</data>
  <data key="d3">chunk-444624ac7ec860ede259c10c50f0513a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766712</data>
