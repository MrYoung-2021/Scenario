  <data key="d0">Basic Mission</data>
  <data key="d1">concept</data>
  <data key="d2">Basic mission is the fundamental task assigned to military forces.</data>
  <data key="d3">chunk-38e9493e7a7348c2d48edb6be9c328ba</data>
