</node>
<node id="Line of Action">
  <data key="d0">Line of Action</data>
  <data key="d1">concept</data>
  <data key="d2">Line of Action (LOA) is a military concept describing the realistic axis of movement for a military unit from its starting point through mobilization to engagement and combat operations.</data>
  <data key="d3">chunk-c43df6ccd3d1cffa3dea06dde0dcef0a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766687</data>
