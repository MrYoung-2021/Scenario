  <data key="d6"></data>
</node>
<node id="Common Operating Picture">
  <data key="d0">Common Operating Picture</data>
  <data key="d1">concept</data>
  <data key="d2">The Common Operating Picture (COP) is a core situational information processing module developed by the U.S. military as part of the Global Command and Control System, widely used across military branches as a common tool for joint operation planning and command.</data>
  <data key="d3">chunk-67849e0b5328f68ea35509bd6b19645b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766759</data>
  <data key="d6"></data>
</node>
<node id="Global Command and Control System">
  <data key="d0">Global Command and Control System</data>
  <data key="d1">organization</data>
  <data key="d2">The Global Command and Control System (GCCS) is a system developed by the U.S. military that includes the Common Operating Picture as a core module for joint operations.&lt;SEP&gt;Global Command and Control System (GCCS) is an information system developed by the US military as a core module for processing and sharing situational information.</data>
  <data key="d3">chunk-67849e0b5328f68ea35509bd6b19645b&lt;SEP&gt;chunk-183c1795d5a56239a85ed103ac235df6</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766759</data>
  <data key="d6"></data>
</node>
<node id="Joint Operations Common Situational Picture">
  <data key="d0">Joint Operations Common Situational Picture</data>
  <data key="d1">content</data>
  <data key="d2">The Joint Operations Common Situational Picture is a unified display of relevant information shared by multiple commanders for joint operations.</data>
  <data key="d3">chunk-67849e0b5328f68ea35509bd6b19645b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766759</data>
  <data key="d6"></data>
</node>
<node id="Operational Link">
  <data key="d0">Operational Link</data>
  <data key="d1">concept</data>
  <data key="d2">The Operational Link is a descriptive framework that correlates combat missions, combat actions, and combat effects across time, space, and logical dimensions.</data>
  <data key="d3">chunk-67849e0b5328f68ea35509bd6b19645b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766759</data>
  <data key="d6"></data>
</node>
<node id="Combat Effect">
  <data key="d0">Combat Effect</data>
  <data key="d1">concept</data>
  <data key="d2">Combat Effect refers to the outcomes and results achieved through combat actions.</data>
  <data key="d3">chunk-67849e0b5328f68ea35509bd6b19645b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766759</data>
  <data key="d6"></data>
</node>
<node id="Line of Operations">
  <data key="d0">Line of Operations</data>
  <data key="d1">concept</data>
  <data key="d2">The Line of Operations (LOO) is defined as a logical line connecting a combat unit's actions at operation nodes and/or decision points, related to operational purposes and time. It reflects combat missions of various combat formations and serves as a graphical description of combat actions and tasks.</data>
  <data key="d3">chunk-67849e0b5328f68ea35509bd6b19645b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766759</data>
  <data key="d6"></data>
</node>
<node id="Operational Chain Description Tool">
  <data key="d0">Operational Chain Description Tool</data>
  <data key="d1">method</data>
  <data key="d2">Operational Chain Description Tool is a method used to describe operational links and clearly demonstrate relationships between combat actions and final purposes.</data>
  <data key="d3">chunk-67849e0b5328f68ea35509bd6b19645b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766759</data>
  <data key="d6"></data>
</node>
<node id="Operation Node">
  <data key="d0">Operation Node</data>
  <data key="d1">concept</data>
  <data key="d2">An Operation Node refers to a specific point where combat units implement combat actions within the operational timeline.</data>
  <data key="d3">chunk-67849e0b5328f68ea35509bd6b19645b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766759</data>
  <data key="d6"></data>
</node>
<node id="Mission Center of Gravity">
  <data key="d0">Mission Center of Gravity</data>
  <data key="d1">concept</data>
  <data key="d2">Mission Center of Gravity refers to the critical point in mission analysis that represents the core of combat capability or vulnerability.</data>
  <data key="d3">chunk-67849e0b5328f68ea35509bd6b19645b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766759</data>
  <data key="d6"></data>
</node>
<node id="Combat Condition">
  <data key="d0">Combat Condition</data>
  <data key="d1">concept</data>
  <data key="d2">Combat Condition refers to the operational environment and circumstances that affect combat operations.</data>
  <data key="d3">chunk-67849e0b5328f68ea35509bd6b19645b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766759</data>
  <data key="d6"></data>
