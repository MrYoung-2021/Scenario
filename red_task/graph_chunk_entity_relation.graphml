  <data key="d4">unknown_source</data>
  <data key="d5">1778766690</data>
  <data key="d6"></data>
</node>
<node id="Firepower Requirements">
  <data key="d0">Firepower Requirements</data>
  <data key="d1">concept</data>
  <data key="d2">Firepower requirements refer to the target strike firepower and capability needs required to achieve combat objectives.</data>
  <data key="d3">chunk-89c2553983e206a8e297fe9cdac66169</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766690</data>
  <data key="d6"></data>
</node>
<node id="Support And Sustainment Requirements">
  <data key="d0">Support And Sustainment Requirements</data>
  <data key="d1">concept</data>
  <data key="d2">Support and sustenance requirements refer to the logistical support needs for combat operations, integrated from combat tasks.</data>
  <data key="d3">chunk-89c2553983e206a8e297fe9cdac66169</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766690</data>
  <data key="d6"></data>
</node>
<node id="Force Disposition Suggestions">
  <data key="d0">Force Disposition Suggestions</data>
  <data key="d1">concept</data>
  <data key="d2">Force disposition suggestions refer to recommendations for force allocation submitted to address force gaps.</data>
  <data key="d3">chunk-89c2553983e206a8e297fe9cdac66169</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766690</data>
  <data key="d6"></data>
</node>
<node id="Phase Combat Capability">
  <data key="d0">Phase Combat Capability</data>
  <data key="d1">concept</data>
  <data key="d2">Phase combat capability refers to the operational capability assessment for each combat phase and main phase operations.</data>
  <data key="d3">chunk-89c2553983e206a8e297fe9cdac66169</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766690</data>
