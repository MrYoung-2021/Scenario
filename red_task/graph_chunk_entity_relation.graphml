  <data key="d4">unknown_source</data>
  <data key="d5">1778766703</data>
  <data key="d6"></data>
</node>
<node id="总体计划">
  <data key="d0">总体计划</data>
  <data key="d1">concept</data>
  <data key="d2">总体计划是作战的整体计划，包括主体计划和各项分支计划。</data>
  <data key="d3">chunk-2193ba1559d7512bedc5afd4625dd47e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766703</data>
  <data key="d6"></data>
</node>
<node id="分支计划">
  <data key="d0">分支计划</data>
  <data key="d1">concept</data>
  <data key="d2">分支计划是总体计划下的各类专项计划，包括军种行动计划、保障计划等。</data>
  <data key="d3">chunk-2193ba1559d7512bedc5afd4625dd47e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766703</data>
  <data key="d6"></data>
</node>
<node id="作战想定">
  <data key="d0">作战想定</data>
  <data key="d1">concept</data>
  <data key="d2">作战想定的依据是对战场情况和作战过程的假设和预想。</data>
  <data key="d3">chunk-2193ba1559d7512bedc5afd4625dd47e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766703</data>
  <data key="d6"></data>
</node>
<node id="计划执行">
  <data key="d0">计划执行</data>
  <data key="d1">concept</data>
  <data key="d2">计划执行是在作战过程中实施作战计划的行为。</data>
  <data key="d3">chunk-2193ba1559d7512bedc5afd4625dd47e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766703</data>
  <data key="d6"></data>
</node>
<node id="Electronic Countermeasure Systems">
  <data key="d0">Electronic Countermeasure Systems</data>
  <data key="d1">method</data>
  <data key="d2">Electronic countermeasure systems include jammers, chaff, infrared IRCM (active/passive, lights, flares), and other electronic warfare equipment used for defensive and offensive operations.</data>
  <data key="d3">chunk-c6cb7803020d38d18a5bdab2a380b7b4</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766703</data>
  <data key="d6"></data>
</node>
<node id="Best Network Attack Task Force">
  <data key="d0">Best Network Attack Task Force</data>
  <data key="d1">organization</data>
  <data key="d2">Best Network Attack Task Force is the optimal unit assigned for conducting network electronic attack missions based on target characteristics and operational constraints.</data>
  <data key="d3">chunk-c6cb7803020d38d18a5bdab2a380b7b4</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766703</data>
  <data key="d6"></data>
</node>
<node id="Network Electronic Combat Operations">
  <data key="d0">Network Electronic Combat Operations</data>
  <data key="d1">concept</data>
  <data key="d2">Network electronic combat operations encompass the planning and execution of network attacks and electronic warfare, involving force assessment, target engagement, and resource allocation.</data>
  <data key="d3">chunk-c6cb7803020d38d18a5bdab2a380b7b4</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766703</data>
  <data key="d6"></data>
</node>
<node id="Network Reconnaissance">
  <data key="d0">Network Reconnaissance</data>
  <data key="d1">method</data>
  <data key="d2">Network reconnaissance is a continuous periodic process for collecting enemy cyber space intelligence through network and electromagnetic channels, including routine and demand-based reconnaissance.</data>
  <data key="d3">chunk-c6cb7803020d38d18a5bdab2a380b7b4</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766704</data>
  <data key="d6"></data>
</node>
<node id="Electronic Reconnaissance">
  <data key="d0">Electronic Reconnaissance</data>
  <data key="d1">method</data>
  <data key="d2">Electronic reconnaissance involves intercepting enemy electronic device signals to analyze frequency, working mode, signal characteristics, location, and purpose for electronic warfare planning.&lt;SEP&gt;Electronic Reconnaissance is a threat that information protection measures aim to defend against.</data>
  <data key="d3">chunk-c6cb7803020d38d18a5bdab2a380b7b4&lt;SEP&gt;chunk-39f86d913e30094ae7d1d1fc8613aefc</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766704</data>
  <data key="d6"></data>
</node>
<node id="Network Attack">
  <data key="d0">Network Attack</data>
  <data key="d1">method</data>
  <data key="d2">Network attack refers to offensive operations targeting enemy cyber infrastructure, networks, and systems to disrupt, interfere, or destroy enemy electronic capabilities.&lt;SEP&gt;Network Attack is a threat that information protection measures aim to defend against.</data>
  <data key="d3">chunk-c6cb7803020d38d18a5bdab2a380b7b4&lt;SEP&gt;chunk-39f86d913e30094ae7d1d1fc8613aefc</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766704</data>
  <data key="d6"></data>
</node>
<node id="Target Analysis">
  <data key="d0">Target Analysis</data>
  <data key="d1">method</data>
  <data key="d2">Target Analysis is a phase in the Air Strike Task Cycle involving target intelligence analysis, rule verification, priority ranking, and creation of a priority target list.&lt;SEP&gt;Target analysis is the process of analyzing enemy cyber targets to identify high-value objectives, vulnerabilities, and feasible attack methods based on collected intelligence.</data>
  <data key="d3">chunk-c6cb7803020d38d18a5bdab2a380b7b4&lt;SEP&gt;chunk-4f1759230375668c37a3de633d934a17</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766704</data>
  <data key="d6"></data>
</node>
<node id="Radar Reconnaissance">
  <data key="d0">Radar Reconnaissance</data>
  <data key="d1">method</data>
  <data key="d2">Radar reconnaissance focuses on detecting and analyzing enemy radar characteristics to determine tactical and technical performance, type, purpose, configuration, and controlled weapons.</data>
  <data key="d3">chunk-c6cb7803020d38d18a5bdab2a380b7b4</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766704</data>
  <data key="d6"></data>
</node>
<node id="Communication Reconnaissance">
  <data key="d0">Communication Reconnaissance</data>
  <data key="d1">method</data>
  <data key="d2">Communication reconnaissance involves searching, intercepting, and analyzing enemy communication signals to determine frequency parameters, location, communication links, and working modes.</data>
  <data key="d3">chunk-c6cb7803020d38d18a5bdab2a380b7b4</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766704</data>
  <data key="d6"></data>
</node>
<node id="Optoelectronic Reconnaissance">
  <data key="d0">Optoelectronic Reconnaissance</data>
  <data key="d1">method</data>
  <data key="d2">Optoelectronic reconnaissance captures, analyzes, and stores enemy signals to determine the nature and location of enemy optoelectronic radiation sources, including active, passive, and laser reconnaissance.</data>
  <data key="d3">chunk-c6cb7803020d38d18a5bdab2a380b7b4</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766704</data>
  <data key="d6"></data>
</node>
<node id="Network Scanning Tools">
  <data key="d0">Network Scanning Tools</data>
  <data key="d1">method</data>
  <data key="d2">Network scanning tools include Nmap, Nessus, Retina, and Saintscanner, used for probing computer systems and network information.</data>
  <data key="d3">chunk-c6cb7803020d38d18a5bdab2a380b7b4</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766704</data>
  <data key="d6"></data>
</node>
<node id="Network Sniffing Tools">
  <data key="d0">Network Sniffing Tools</data>
  <data key="d1">method</data>
  <data key="d2">Network sniffing tools include Wireshark, Ettercap, Tcpdump, and other packet analyzers used for intercepting and analyzing network traffic.</data>
  <data key="d3">chunk-c6cb7803020d38d18a5bdab2a380b7b4</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766704</data>
  <data key="d6"></data>
</node>
<node id="NetCat and Hping Tools">
  <data key="d0">NetCat and Hping Tools</data>
  <data key="d1">method</data>
  <data key="d2">NetCat and Hping are network tools used for network reconnaissance and security assessment activities.</data>
  <data key="d3">chunk-c6cb7803020d38d18a5bdab2a380b7b4</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766704</data>
  <data key="d6"></data>
</node>
<node id="Computer Systems">
  <data key="d0">Computer Systems</data>
  <data key="d1">concept</data>
  <data key="d2">Computer systems are targets of network reconnaissance and attack, including operating systems, applications, and software such as media players, office software, browsers, and instant messaging tools.</data>
  <data key="d3">chunk-c6cb7803020d38d18a5bdab2a380b7b4</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766704</data>
  <data key="d6"></data>
</node>
<node id="Cyber Space">
  <data key="d0">Cyber Space</data>
  <data key="d1">concept</data>
  <data key="d2">Cyber space refers to the digital domain encompassing computer networks, communication systems, and electronic infrastructure targeted by cyber operations.</data>
  <data key="d3">chunk-c6cb7803020d38d18a5bdab2a380b7b4</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766704</data>
  <data key="d6"></data>
</node>
<node id="Electromagnetic Spectrum">
  <data key="d0">Electromagnetic Spectrum</data>
  <data key="d1">concept</data>
  <data key="d2">Electromagnetic spectrum represents the range of electromagnetic frequencies used by enemy electronic devices, analyzed to understand deployment and usage patterns.</data>
  <data key="d3">chunk-c6cb7803020d38d18a5bdab2a380b7b4</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766704</data>
  <data key="d6"></data>
</node>
<node id="Enemy Cyber Targets">
  <data key="d0">Enemy Cyber Targets</data>
  <data key="d1">concept</data>
  <data key="d2">Enemy cyber targets are high-value objectives in enemy cyber space that play critical roles in enemy operations, including network nodes, key hosts, and vulnerable systems.</data>
  <data key="d3">chunk-c6cb7803020d38d18a5bdab2a380b7b4</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766704</data>
  <data key="d6"></data>
</node>
<node id="Network Intrusion Methods">
  <data key="d0">Network Intrusion Methods</data>
  <data key="d1">method</data>
  <data key="d2">Network intrusion methods include using network commands, specialized software, or electromagnetic weapons to penetrate enemy networks through identified vulnerabilities.</data>
  <data key="d3">chunk-c6cb7803020d38d18a5bdab2a380b7b4</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766705</data>
  <data key="d6"></data>
</node>
<node id="Routine Reconnaissance">
  <data key="d0">Routine Reconnaissance</data>
  <data key="d1">method</data>
  <data key="d2">Routine reconnaissance is the normal work conducted by network electronic operations departments according to established plans.</data>
  <data key="d3">chunk-c6cb7803020d38d18a5bdab2a380b7b4</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766705</data>
  <data key="d6"></data>
</node>
<node id="Demand-Based Reconnaissance">
  <data key="d0">Demand-Based Reconnaissance</data>
  <data key="d1">method</data>
  <data key="d2">Demand-based reconnaissance is targeted intelligence gathering based on operational department requirements, including demand aggregation, planning, execution, and effectiveness evaluation.</data>
  <data key="d3">chunk-c6cb7803020d38d18a5bdab2a380b7b4</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766705</data>
  <data key="d6"></data>
</node>
<node id="Decoys">
  <data key="d0">Decoys</data>
  <data key="d1">method</data>
  <data key="d2">Decoys are electronic countermeasure devices used to mislead or distract enemy detection systems.</data>
  <data key="d3">chunk-c6cb7803020d38d18a5bdab2a380b7b4</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766705</data>
  <data key="d6"></data>
</node>
<node id="Chaff">
  <data key="d0">Chaff</data>
  <data key="d1">method</data>
  <data key="d2">Chaff is a passive electronic countermeasure consisting of thin strips of aluminum or metalized material deployed to confuse radar systems.</data>
  <data key="d3">chunk-c6cb7803020d38d18a5bdab2a380b7b4</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766705</data>
  <data key="d6"></data>
</node>
<node id="Flares">
  <data key="d0">Flares</data>
  <data key="d1">method</data>
  <data key="d2">Flares are infrared countermeasure devices that emit intense heat to distract heat-seeking missiles.</data>
  <data key="d3">chunk-c6cb7803020d38d18a5bdab2a380b7b4</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766705</data>
  <data key="d6"></data>
</node>
<node id="Searchlights">
  <data key="d0">Searchlights</data>
  <data key="d1">equipment</data>
  <data key="d2">Searchlights are active optoelectronic reconnaissance equipment used for illumination and target detection.</data>
  <data key="d3">chunk-c6cb7803020d38d18a5bdab2a380b7b4</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766705</data>
  <data key="d6"></data>
</node>
<node id="Semiconductor Photodiodes">
  <data key="d0">Semiconductor Photodiodes</data>
  <data key="d1">equipment</data>
  <data key="d2">Semiconductor photodiodes are passive optoelectronic reconnaissance sensors that detect light and convert it to electrical signals.</data>
  <data key="d3">chunk-c6cb7803020d38d18a5bdab2a380b7b4</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766705</data>
  <data key="d6"></data>
</node>
<node id="Infrared Detectors">
  <data key="d0">Infrared Detectors</data>
  <data key="d1">equipment</data>
  <data key="d2">Infrared detectors are sensors used to identify enemy targets through heat signatures.&lt;SEP&gt;Infrared detectors are passive sensors used in optoelectronic reconnaissance to detect infrared radiation from enemy sources.</data>
  <data key="d3">chunk-c6cb7803020d38d18a5bdab2a380b7b4&lt;SEP&gt;chunk-d1fafd99eac7a9f0a81e5f0af175de98</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766705</data>
  <data key="d6"></data>
</node>
<node id="Photomultiplier Tubes">
  <data key="d0">Photomultiplier Tubes</data>
  <data key="d1">equipment</data>
  <data key="d2">Photomultiplier tubes are highly sensitive light detection devices used in passive optoelectronic reconnaissance.</data>
  <data key="d3">chunk-c6cb7803020d38d18a5bdab2a380b7b4</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766705</data>
  <data key="d6"></data>
</node>
<node id="Space Reconnaissance">
  <data key="d0">Space Reconnaissance</data>
  <data key="d1">method</data>
  <data key="d2">Space reconnaissance involves using satellites and space-based platforms to conduct electronic surveillance of enemy electromagnetic emissions.</data>
  <data key="d3">chunk-c6cb7803020d38d18a5bdab2a380b7b4</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766705</data>
  <data key="d6"></data>
</node>
<node id="Air Reconnaissance">
  <data key="d0">Air Reconnaissance</data>
  <data key="d1">method</data>
  <data key="d2">Air reconnaissance utilizes aircraft and airborne platforms to intercept and analyze enemy electronic signals.</data>
  <data key="d3">chunk-c6cb7803020d38d18a5bdab2a380b7b4</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766705</data>
  <data key="d6"></data>
</node>
<node id="Ground Reconnaissance">
  <data key="d0">Ground Reconnaissance</data>
  <data key="d1">method</data>
  <data key="d2">Ground reconnaissance involves land-based electronic surveillance systems to intercept and analyze enemy electromagnetic emissions.</data>
  <data key="d3">chunk-c6cb7803020d38d18a5bdab2a380b7b4</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766705</data>
  <data key="d6"></data>
</node>
<node id="Marine Reconnaissance">
  <data key="d0">Marine Reconnaissance</data>
  <data key="d1">method</data>
  <data key="d2">Marine reconnaissance employs naval vessels and maritime platforms for electronic surveillance of enemy signals.</data>
  <data key="d3">chunk-c6cb7803020d38d18a5bdab2a380b7b4</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766705</data>
  <data key="d6"></data>
</node>
<node id="IP Addresses">
  <data key="d0">IP Addresses</data>
  <data key="d1">data</data>
  <data key="d2">IP addresses are numerical identifiers assigned to devices connected to computer networks, collected during network reconnaissance.</data>
  <data key="d3">chunk-c6cb7803020d38d18a5bdab2a380b7b4</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766705</data>
  <data key="d6"></data>
</node>
<node id="URLs">
  <data key="d0">URLs</data>
  <data key="d1">data</data>
  <data key="d2">URLs are web resource addresses collected during network reconnaissance to identify enemy network locations.</data>
  <data key="d3">chunk-c6cb7803020d38d18a5bdab2a380b7b4</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766706</data>
