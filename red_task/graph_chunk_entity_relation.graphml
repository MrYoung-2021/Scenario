  <data key="d0">Planning Team</data>
  <data key="d1">organization</data>
  <data key="d2">Planning Team is the team responsible for developing operational plans under the leadership of the joint campaign commander.</data>
  <data key="d3">chunk-b76b9404888b1ba7ea6890ea44e06497</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766713</data>
  <data key="d6"></data>
