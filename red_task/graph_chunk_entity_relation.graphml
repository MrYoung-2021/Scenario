</node>
<node id="Target Support">
  <data key="d0">Target Support</data>
  <data key="d1">concept</data>
  <data key="d2">Target Support encompasses planning content including compiling target intelligence information, updating targets, constructing target databases and model libraries, analyzing various targets, and assisting in target analysis, selection, and verification.</data>
  <data key="d3">chunk-39f86d913e30094ae7d1d1fc8613aefc</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766738</data>
  <data key="d6"></data>
</node>
<node id="Information Support">
  <data key="d0">Information Support</data>
  <data key="d1">concept</data>
  <data key="d2">Information Support involves statistical analysis of information service support force resource structure, status, and capabilities, command relationship determination, and information protection measures.</data>
  <data key="d3">chunk-39f86d913e30094ae7d1d1fc8613aefc</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766738</data>
  <data key="d6"></data>
</node>
<node id="Logistics Support">
  <data key="d0">Logistics Support</data>
  <data key="d1">concept</data>
  <data key="d2">Logistics support provides living arrangements and material assistance for plan formulation activities.&lt;SEP&gt;Logistics Support includes statistical analysis of logistics support force resources, task determination, force composition, deployment, and logistics support plan development.</data>
  <data key="d3">chunk-39f86d913e30094ae7d1d1fc8613aefc&lt;SEP&gt;chunk-30f82772b0d833e6eb3891686c80b3f7</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766738</data>
  <data key="d6"></data>
</node>
