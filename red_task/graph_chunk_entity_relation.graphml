<node id="Situational Awareness Information System">
  <data key="d0">Situational Awareness Information System</data>
  <data key="d1">concept</data>
  <data key="d2">The Situational Awareness Information System is an information system that provides a unified display of relevant information shared by multiple commanders, helping combat forces at all levels achieve situational awareness and coordinated planning.</data>
  <data key="d3">chunk-67849e0b5328f68ea35509bd6b19645b</data>
  <data key="d4">unknown_source</data>
