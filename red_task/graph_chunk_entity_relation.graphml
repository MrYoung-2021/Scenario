  <data key="d3">chunk-89c2553983e206a8e297fe9cdac66169</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766690</data>
  <data key="d6"></data>
</node>
<node id="Combat Operation Execution Capability">
  <data key="d0">Combat Operation Execution Capability</data>
  <data key="d1">concept</data>
  <data key="d2">Combat operation execution capability refers to the ability of forces to execute and complete assigned combat operations.</data>
  <data key="d3">chunk-89c2553983e206a8e297fe9cdac66169</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766690</data>
  <data key="d6"></data>
</node>
<node id="Fire Strike Ranking List">
  <data key="d0">Fire Strike Ranking List</data>
  <data key="d1">data</data>
  <data key="d2">Fire strike ranking list is a prioritized listing of targets based on target-firepower correlation matching for engagement sequencing.</data>
  <data key="d3">chunk-89c2553983e206a8e297fe9cdac66169</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766690</data>
  <data key="d6"></data>
</node>
<node id="Task Forces">
  <data key="d0">Task Forces</data>
  <data key="d1">organization</data>
  <data key="d2">Task forces are assigned units that participate in the planning process and execution of operational plans.&lt;SEP&gt;Task forces refer to combat units selected based on operational capabilities, resources, and coordination relationships to undertake missions.&lt;SEP&gt;Task Forces are specialized military units assigned specific missions and objectives.</data>
  <data key="d3">chunk-89c2553983e206a8e297fe9cdac66169&lt;SEP&gt;chunk-bafe3365a36fae45b1bf2e0446eac189&lt;SEP&gt;chunk-38d3c5592e48544d872c05c7c8f83f77</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766690</data>
  <data key="d6"></data>
</node>
<node id="Damage Effect Requirements">
  <data key="d0">Damage Effect Requirements</data>
  <data key="d1">concept</data>
  <data key="d2">Damage effect requirements refer to the destructive impact expectations for target strikes, used in evaluating task assignment lists.</data>
  <data key="d3">chunk-89c2553983e206a8e297fe9cdac66169</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766690</data>
  <data key="d6"></data>
</node>
<node id="Task Completion Capability">
  <data key="d0">Task Completion Capability</data>
  <data key="d1">concept</data>
  <data key="d2">Task completion capability refers to the ability of task-assigned forces to accomplish their assigned missions.</data>
  <data key="d3">chunk-89c2553983e206a8e297fe9cdac66169</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766690</data>
  <data key="d6"></data>
</node>
<node id="Sudden Situations">
  <data key="d0">Sudden Situations</data>
  <data key="d1">concept</data>
  <data key="d2">Sudden situations refer to unexpected events that may arise during mission execution, assessed for associated risks.</data>
  <data key="d3">chunk-89c2553983e206a8e297fe9cdac66169</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766690</data>
  <data key="d6"></data>
</node>
<node id="Enemy Key Targets">
  <data key="d0">Enemy Key Targets</data>
  <data key="d1">concept</data>
  <data key="d2">Enemy key targets refer to critical enemy objectives that are重点evaluated for strike task assignment.</data>
  <data key="d3">chunk-89c2553983e206a8e297fe9cdac66169</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766691</data>
  <data key="d6"></data>
</node>
<node id="Dynamic Targets">
  <data key="d0">Dynamic Targets</data>
  <data key="d1">concept</data>
  <data key="d2">Dynamic targets refer to moving or changing targets that require重点evaluation in strike task assignment.</data>
  <data key="d3">chunk-89c2553983e206a8e297fe9cdac66169</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766691</data>
  <data key="d6"></data>
</node>
<node id="Coordination Support Tasks">
  <data key="d0">Coordination Support Tasks</data>
  <data key="d1">concept</data>
  <data key="d2">Coordination support tasks refer to support missions that enable target fire strike operations.</data>
  <data key="d3">chunk-89c2553983e206a8e297fe9cdac66169</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766691</data>
  <data key="d6"></data>
</node>
<node id="Contradictions And Conflicts">
  <data key="d0">Contradictions And Conflicts</data>
  <data key="d1">concept</data>
  <data key="d2">Contradictions and conflicts refer to issues resolved through the evaluation of task assignment lists.</data>
  <data key="d3">chunk-89c2553983e206a8e297fe9cdac66169</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766691</data>
  <data key="d6"></data>
</node>
<node id="Expected Posture">
  <data key="d0">Expected Posture</data>
  <data key="d1">concept</data>
  <data key="d2">Expected posture refers to the anticipated future situation or state resulting from operations.</data>
  <data key="d3">chunk-89c2553983e206a8e297fe9cdac66169</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766691</data>
  <data key="d6"></data>
</node>
<node id="Campaign-Level Combat Preparation Capability">
  <data key="d0">Campaign-Level Combat Preparation Capability</data>
  <data key="d1">concept</data>
  <data key="d2">Campaign-level combat preparation capability refers to the readiness to prepare and respond to operations at the campaign level.</data>
  <data key="d3">chunk-89c2553983e206a8e297fe9cdac66169</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766691</data>
  <data key="d6"></data>
</node>
<node id="Service And Field Suggestions">
  <data key="d0">Service And Field Suggestions</data>
  <data key="d1">concept</data>
  <data key="d2">Service and field suggestions refer to input from various military services and domains integrated into planning.</data>
  <data key="d3">chunk-89c2553983e206a8e297fe9cdac66169</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766691</data>
  <data key="d6"></data>
</node>
<node id="评估标准">
  <data key="d0">评估标准</data>
  <data key="d1">concept</data>
  <data key="d2">评估标准是用于评估实施过程的关键步骤，包括性能指标和效能指标，体现评估效果及行动之间的关联性。</data>
  <data key="d3">chunk-b42e1ba523a8e60f5cb4077505876f64</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766691</data>
  <data key="d6"></data>
</node>
<node id="性能指标">
  <data key="d0">性能指标</data>
  <data key="d1">concept</data>
  <data key="d2">Measures of Performance (MOP) are quantitative metrics used to assess operational performance.&lt;SEP&gt;性能指标(Measure of Performance，MOP)是评估标准的重要组成部分，用于衡量绩效表现。</data>
  <data key="d3">chunk-b42e1ba523a8e60f5cb4077505876f64&lt;SEP&gt;chunk-0d196d40375e13f5ae15e9a8dac1136a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766691</data>
  <data key="d6"></data>
</node>
<node id="效能指标">
  <data key="d0">效能指标</data>
  <data key="d1">concept</data>
  <data key="d2">Measures of Effectiveness (MOE) are metrics that evaluate how well operations achieve desired outcomes.&lt;SEP&gt;效能指标(Measure of Effectiveness，MOE)是评估标准的重要组成部分，用于衡量效能表现。</data>
  <data key="d3">chunk-b42e1ba523a8e60f5cb4077505876f64&lt;SEP&gt;chunk-0d196d40375e13f5ae15e9a8dac1136a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766691</data>
  <data key="d6"></data>
</node>
<node id="评估基本步骤">
  <data key="d0">评估基本步骤</data>
  <data key="d1">concept</data>
  <data key="d2">评估的基本步骤包括确定并理解战略、制定标准、确定评估指标并搜集数据、分析、提出意见建议五个阶段。</data>
  <data key="d3">chunk-b42e1ba523a8e60f5cb4077505876f64</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766691</data>
  <data key="d6"></data>
</node>
<node id="战略">
  <data key="d0">战略</data>
  <data key="d1">concept</data>
  <data key="d2">战略是指需要确定并理解的宏观规划和指导方针。</data>
  <data key="d3">chunk-b42e1ba523a8e60f5cb4077505876f64</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766691</data>
  <data key="d6"></data>
</node>
<node id="空中编队">
  <data key="d0">空中编队</data>
  <data key="d1">concept</data>
  <data key="d2">空中编队包括打击编队、掩护编队和支援编队，各编队在上级指挥员和指挥机构的统一指挥下组织实施作战行动。</data>
  <data key="d3">chunk-b42e1ba523a8e60f5cb4077505876f64</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766691</data>
  <data key="d6"></data>
</node>
<node id="打击编队">
  <data key="d0">打击编队</data>
  <data key="d1">concept</data>
  <data key="d2">打击编队是空中编队的一种类型，负责执行打击及压制任务。</data>
  <data key="d3">chunk-b42e1ba523a8e60f5cb4077505876f64</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766691</data>
  <data key="d6"></data>
</node>
<node id="掩护编队">
  <data key="d0">掩护编队</data>
  <data key="d1">concept</data>
  <data key="d2">掩护编队是空中编队的一种类型，负责执行随队掩护及随队干扰任务。</data>
  <data key="d3">chunk-b42e1ba523a8e60f5cb4077505876f64</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766691</data>
  <data key="d6"></data>
</node>
<node id="支援编队">
  <data key="d0">支援编队</data>
  <data key="d1">concept</data>
  <data key="d2">支援编队是空中编队的一种类型，负责提供作战支援行动。</data>
  <data key="d3">chunk-b42e1ba523a8e60f5cb4077505876f64</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766692</data>
  <data key="d6"></data>
</node>
<node id="指挥员">
  <data key="d0">指挥员</data>
  <data key="d1">person</data>
  <data key="d2">The individual who clarifies strategic intent, participates in plan formulation, and makes decisive decisions during operations.&lt;SEP&gt;The commander is the core figure in operational planning, whose personality, military literacy, and intuition directly influence planning style and effectiveness.&lt;SEP&gt;Commanders are responsible for transforming campaign concepts into operational decisions and actions through command art.&lt;SEP&gt;指挥员是负责组织召开专门会议、定下作战决心、制定并下达作战命令的军事决策者。&lt;SEP&gt;A Commander is a military personnel who makes combat decisions, approves plan adjustments, and issues combat orders.&lt;SEP&gt;指挥员是空中编队的上级指挥者，负责统一指挥和指挥机构的协调。&lt;SEP&gt;指挥员是负责指挥军事行动的军队人员，负责确定关键信息需求、作战意图、打击目标和作战任务等。</data>
  <data key="d3">chunk-b42e1ba523a8e60f5cb4077505876f64&lt;SEP&gt;chunk-2193ba1559d7512bedc5afd4625dd47e&lt;SEP&gt;chunk-f89c6c0a89ad1a479cb3db03560939b9&lt;SEP&gt;chunk-9462b55eac26353ece0a6caed0d12c93&lt;SEP&gt;chunk-016b122f52ce767ff6277d5f69a238ab&lt;SEP&gt;chunk-7b0ab60a625810ad5c7b928b03f9f35b&lt;SEP&gt;chunk-bc498b8576e8ab1b2cbded8e3f1ca004</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766692</data>
  <data key="d6"></data>
</node>
<node id="作战方案">
  <data key="d0">作战方案</data>
  <data key="d1">concept</data>
  <data key="d2">作战方案是细化和落实战役构想、完善作战行动和任务实施的方案细节并最终生成的过程，能够回答任务目的、任务性质、执行力量、执行方式、执行时间和地点等问题。&lt;SEP&gt;作战方案是根据作战预案经过分析评估和优选后形成的具体作战指导方案。&lt;SEP&gt;作战方案是预定的作战行动计划，空中编队按照该计划组织实施作战行动。</data>
  <data key="d3">chunk-b42e1ba523a8e60f5cb4077505876f64&lt;SEP&gt;chunk-2193ba1559d7512bedc5afd4625dd47e&lt;SEP&gt;chunk-2c2aa6fbd1f527b7422a45710c2b7351</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766692</data>
  <data key="d6"></data>
</node>
<node id="战斗出动">
  <data key="d0">战斗出动</data>
  <data key="d1">event</data>
  <data key="d2">战斗出动是作战过程的第一阶段，各编队起飞、会合出航、航行至突防区域。</data>
  <data key="d3">chunk-b42e1ba523a8e60f5cb4077505876f64</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766692</data>
  <data key="d6"></data>
</node>
<node id="编队突防">
  <data key="d0">编队突防</data>
  <data key="d1">event</data>
  <data key="d2">编队突防是作战过程的第二阶段，重点突破敌预警探测、空中截击和对空防御体系。</data>
  <data key="d3">chunk-b42e1ba523a8e60f5cb4077505876f64</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766692</data>
  <data key="d6"></data>
</node>
<node id="编队突击">
  <data key="d0">编队突击</data>
  <data key="d1">event</data>
  <data key="d2">编队突击是作战过程的第三阶段，主要是进入目标区域实施的空中交战、空中压制和空中打击行动。</data>
  <data key="d3">chunk-b42e1ba523a8e60f5cb4077505876f64</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766692</data>
  <data key="d6"></data>
</node>
<node id="编队退出战斗">
  <data key="d0">编队退出战斗</data>
  <data key="d1">event</data>
  <data key="d2">编队退出战斗是作战过程的第四阶段，编队退出战斗并返航。</data>
  <data key="d3">chunk-b42e1ba523a8e60f5cb4077505876f64</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766692</data>
  <data key="d6"></data>
</node>
<node id="空中任务指令">
  <data key="d0">空中任务指令</data>
  <data key="d1">content</data>
  <data key="d2">空中任务指令是根据联合空中行动任务指令生成的作战任务文件。</data>
  <data key="d3">chunk-b42e1ba523a8e60f5cb4077505876f64</data>
