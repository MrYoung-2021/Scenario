</node>
<node id="注意事项">
  <data key="d0">注意事项</data>
  <data key="d1">concept</data>
  <data key="d2">注意事项是计划使用说明中包含的重要内容,提示执行计划时需要注意的问题。</data>
  <data key="d3">chunk-0f9c3fe605a6c3d5d39ebd3f8d9e5ccb</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766686</data>
  <data key="d6"></data>
</node>
<node id="上级意图">
  <data key="d0">上级意图</data>
  <data key="d1">concept</data>
  <data key="d2">上级意图是网电任务分析的基础,指挥员需要领会和分析上级的意图。</data>
  <data key="d3">chunk-0f9c3fe605a6c3d5d39ebd3f8d9e5ccb</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766686</data>
