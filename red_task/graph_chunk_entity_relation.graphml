  <data key="d0">Email Information</data>
  <data key="d1">data</data>
  <data key="d2">Email information includes email addresses and content collected during network reconnaissance operations.</data>
  <data key="d3">chunk-c6cb7803020d38d18a5bdab2a380b7b4</data>
