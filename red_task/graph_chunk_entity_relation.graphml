  <data key="d4">unknown_source</data>
  <data key="d5">1778766746</data>
  <data key="d6"></data>
</node>
<node id="Fact Reporting">
  <data key="d0">Fact Reporting</data>
  <data key="d1">method</data>
  <data key="d2">Fact reporting is a basic step in intelligence prediction that involves documenting actual observed facts.</data>
  <data key="d3">chunk-5cc378900bb6beaa0154051505b51ce1</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766746</data>
  <data key="d6"></data>
</node>
<node id="Assumptions And Predictions">
  <data key="d0">Assumptions And Predictions</data>
  <data key="d1">concept</data>
  <data key="d2">Assumptions and predictions are forward-looking estimations about intelligence situations based on existing objective facts and development patterns.</data>
  <data key="d3">chunk-5cc378900bb6beaa0154051505b51ce1</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766746</data>
  <data key="d6"></data>
</node>
<node id="Assumption Evaluation">
  <data key="d0">Assumption Evaluation</data>
  <data key="d1">method</data>
  <data key="d2">Assumption evaluation is a basic step in intelligence prediction that involves assessing the validity of assumptions and predictions.</data>
  <data key="d3">chunk-5cc378900bb6beaa0154051505b51ce1</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766746</data>
