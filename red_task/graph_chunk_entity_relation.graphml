  <data key="d4">unknown_source</data>
  <data key="d5">1778766726</data>
  <data key="d6"></data>
</node>
<node id="Joint Mission List">
  <data key="d0">Joint Mission List</data>
  <data key="d1">content</data>
  <data key="d2">A list used as a reference for identifying operational tasks and standards during functional domain analysis.</data>
  <data key="d3">chunk-f5c0970b8c1b0e778f4a08b68650be23</data>
