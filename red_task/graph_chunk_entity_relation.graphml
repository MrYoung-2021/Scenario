  <data key="d0">Satellite Command Information System</data>
  <data key="d1">system</data>
  <data key="d2">Satellite command information systems provide target detection, identification, tracking, and intelligence reporting from superior headquarters for naval operations.</data>
  <data key="d3">chunk-38e9493e7a7348c2d48edb6be9c328ba</data>
