</node>
<node id="Combat Line">
  <data key="d0">Combat Line</data>
  <data key="d1">concept</data>
  <data key="d2">Combat Line is a military operational concept that describes the logical path of combat operations, including movement from starting point to enemy engagement.</data>
  <data key="d3">chunk-c43df6ccd3d1cffa3dea06dde0dcef0a</data>
  <data key="d4">unknown_source</data>
