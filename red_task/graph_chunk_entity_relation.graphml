<node id="Understanding Intentions">
  <data key="d0">Understanding Intentions</data>
  <data key="d1">concept</data>
  <data key="d2">Understanding Intentions is one of three fundamental tasks in operational planning, involving comprehending higher-level orders and commander's intent.</data>
  <data key="d3">chunk-b76b9404888b1ba7ea6890ea44e06497</data>
