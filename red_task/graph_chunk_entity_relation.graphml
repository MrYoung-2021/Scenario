<node id="Product Marking">
  <data key="d0">Product Marking</data>
  <data key="d1">concept</data>
  <data key="d2">Product marking involves adding information to intelligence products including time, accuracy, processing unit, responsible person, method model, validity period, and requirement numbers.</data>
  <data key="d3">chunk-5cc378900bb6beaa0154051505b51ce1</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766746</data>
