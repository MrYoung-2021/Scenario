<node id="Military Exercise">
  <data key="d0">Military Exercise</data>
  <data key="d1">event</data>
  <data key="d2">Military exercise is an activity conducted to analyze and evaluate courses of action in mission planning.&lt;SEP&gt;Military exercise refers to training activities conducted by military forces.</data>
  <data key="d3">chunk-38e9493e7a7348c2d48edb6be9c328ba&lt;SEP&gt;chunk-7ac85adc8a2b85efe002961c570418c8</data>
