  <data key="d0">Target Situation Analysis</data>
  <data key="d1">concept</data>
  <data key="d2">Target Situation Analysis is the second step in Reverse Design Method planning, analyzing targets and operational environment.</data>
  <data key="d3">chunk-594e94fdab189bb399757a7389261e90</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766747</data>
  <data key="d6"></data>
</node>
<node id="Capability Resource Analysis">
  <data key="d0">Capability Resource Analysis</data>
  <data key="d1">concept</data>
  <data key="d2">Capability Resource Analysis is the third step in Reverse Design Method planning, analyzing available capabilities and resources.</data>
  <data key="d3">chunk-594e94fdab189bb399757a7389261e90</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766747</data>
