  <data key="d6"></data>
</node>
<node id="Plan And Order Preparation">
  <data key="d0">Plan And Order Preparation</data>
  <data key="d1">concept</data>
  <data key="d2">Plan and Order Preparation is a phase in the US Navy Mission Planning Process where specific executable action plans and orders are drafted based on the commander's decision and intent.&lt;SEP&gt;Plan and order preparation is the fifth step in US Navy mission planning process.</data>
  <data key="d3">chunk-38e9493e7a7348c2d48edb6be9c328ba&lt;SEP&gt;chunk-4f1759230375668c37a3de633d934a17</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766757</data>
  <data key="d6"></data>
</node>
<node id="Transition">
  <data key="d0">Transition</data>
  <data key="d1">concept</data>
  <data key="d2">Transition is a phase in the US Navy Mission Planning Process where combat staff distribute plans and orders to troops, provide situational awareness and key information, and monitor and feedback on plan execution.&lt;SEP&gt;Transition is the final step in US Navy mission planning process for moving from planning to execution.</data>
  <data key="d3">chunk-38e9493e7a7348c2d48edb6be9c328ba&lt;SEP&gt;chunk-4f1759230375668c37a3de633d934a17</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766757</data>
  <data key="d6"></data>
</node>
