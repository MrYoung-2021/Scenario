<node id="Joint Operations Planning and Command">
  <data key="d0">Joint Operations Planning and Command</data>
  <data key="d1">concept</data>
  <data key="d2">Joint Operations Planning and Command refers to the comprehensive process of planning and directing combined military operations across different service branches.</data>
  <data key="d3">chunk-67849e0b5328f68ea35509bd6b19645b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766759</data>
  <data key="d6"></data>
</node>
<node id="Center Of Gravity In Operations">
  <data key="d0">Center Of Gravity In Operations</data>
  <data key="d1">concept</data>
  <data key="d2">Center Of Gravity In Operations is a key concept in military operational design that represents the critical point around which operational activities revolve and upon which the outcome of operations depends.</data>
  <data key="d3">chunk-b3a38c5d2bd5aded4f705e8a27f80c90</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766759</data>
  <data key="d6"></data>
</node>
<node id="Operational Action Decision Point">
  <data key="d0">Operational Action Decision Point</data>
  <data key="d1">concept</data>
  <data key="d2">Operational Action Decision Point refers to operational decisions derived from analyzing the center of gravity and critical vulnerabilities, which are connected to form operational lines.</data>
  <data key="d3">chunk-b3a38c5d2bd5aded4f705e8a27f80c90</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766759</data>
  <data key="d6"></data>
</node>
<node id="Operational Line">
  <data key="d0">Operational Line</data>
  <data key="d1">concept</data>
  <data key="d2">Operational Line is the connection of operational action decision points that serves as the foundation for designing operational action frameworks.</data>
