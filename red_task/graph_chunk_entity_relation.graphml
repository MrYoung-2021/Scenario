<node id="NBC Defense Support">
  <data key="d0">NBC Defense Support</data>
  <data key="d1">concept</data>
  <data key="d2">NBC Defense Support covers nuclear, biological, and chemical protection force resources, prediction of enemy NBC weapon usage, reconnaissance systems, alert notification systems, and protection measures.</data>
  <data key="d3">chunk-39f86d913e30094ae7d1d1fc8613aefc</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766738</data>
  <data key="d6"></data>
</node>
<node id="Engineering Support">
  <data key="d0">Engineering Support</data>
  <data key="d1">concept</data>
  <data key="d2">Engineering Support includes statistical analysis of engineering support force resources, task determination, engineering equipment procurement and distribution, and engineering support plan development.</data>
