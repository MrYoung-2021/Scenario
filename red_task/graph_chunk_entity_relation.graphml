  <data key="d3">chunk-52002d5c447b3c7fdbb3908a46c355ae</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766710</data>
  <data key="d6"></data>
</node>
<node id="Enemy Air Defense System">
  <data key="d0">Enemy Air Defense System</data>
  <data key="d1">concept</data>
  <data key="d2">Enemy air defense system refers to the integrated network of radars, surface-to-air missiles, and anti-aircraft artillery that protects against aerial attacks.</data>
