</node>
<node id="User Search Keywords">
  <data key="d0">User Search Keywords</data>
  <data key="d1">data</data>
  <data key="d2">User search keywords are search terms collected during network reconnaissance to analyze user behavior and interests.</data>
  <data key="d3">chunk-c6cb7803020d38d18a5bdab2a380b7b4</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766706</data>
  <data key="d6"></data>
</node>
<node id="Phone Numbers">
  <data key="d0">Phone Numbers</data>
  <data key="d1">data</data>
  <data key="d2">Phone numbers are contact information collected during network reconnaissance for intelligence analysis.</data>
