  <data key="d0">Equipment Support</data>
  <data key="d1">concept</data>
  <data key="d2">Equipment Support involves statistical analysis of equipment support force resources, task determination, force composition, deployment, and equipment support plan development.</data>
  <data key="d3">chunk-39f86d913e30094ae7d1d1fc8613aefc</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766738</data>
  <data key="d6"></data>
