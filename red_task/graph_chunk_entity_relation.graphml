  <data key="d0">网电攻防能力分析</data>
  <data key="d1">method</data>
  <data key="d2">网电攻防能力分析是结合当前网电力量及其状态，对攻击目标和防御目标的属性和特性，以及目标的攻击能力、防御能力和伪装干扰能力等进行综合分析的方法。</data>
  <data key="d3">chunk-33df11fbe08f8b9549ec699a8e33f5d9</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766717</data>
  <data key="d6"></data>
</node>
