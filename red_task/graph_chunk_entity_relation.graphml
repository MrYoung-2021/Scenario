  <data key="d0">武器装备</data>
  <data key="d1">artifact</data>
  <data key="d2">Weapons and equipment refer to military armaments and tools used for conducting strike operations, selected based on strike requirements and expected effects.</data>
  <data key="d3">chunk-1ed84de6534558d8934cfe16642690e3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766727</data>
