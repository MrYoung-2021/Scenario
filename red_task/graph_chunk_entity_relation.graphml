  <data key="d0">Crisis Response Capability</data>
  <data key="d1">concept</data>
  <data key="d2">Crisis response capability refers to the ability to handle sudden crisis events during operations.</data>
  <data key="d3">chunk-89c2553983e206a8e297fe9cdac66169</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766690</data>
  <data key="d6"></data>
</node>
<node id="Service Branch Forces">
  <data key="d0">Service Branch Forces</data>
  <data key="d1">concept</data>
