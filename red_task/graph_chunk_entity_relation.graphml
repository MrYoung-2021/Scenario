  <data key="d1">event</data>
  <data key="d2">Third phase of wartime plan revision refers to the stage of revising operational plans based on battlefield changes and defined combat tasks.</data>
  <data key="d3">chunk-89c2553983e206a8e297fe9cdac66169</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778766690</data>
  <data key="d6"></data>
</node>
